									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "whiteboard-collab-sticky",
									"title": "Sticky Note",
									"details": "Note: {text}\nColor: {color}\nAuthor: {author}\nTilt (deg): {tilt}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
