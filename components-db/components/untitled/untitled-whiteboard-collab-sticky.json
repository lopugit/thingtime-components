{
	"slug": "untitled-whiteboard-collab-sticky",
	"name": "Sticky Note",
	"library": "untitled",
	"category": "collaboration",
	"description": "Whiteboard sticky note in the Untitled UI style — a tinted square wash with handwritten-feel text, an author chip, a folded corner, and a tilt you can dial in degrees. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"whiteboard",
		"sticky-note",
		"collaboration",
		"annotation"
	],
	"args": [
		{
			"name": "text",
			"type": "text",
			"default": "Ship the collab demo",
			"label": "Note",
			"maxLength": 80
		},
		{
			"name": "color",
			"type": "enum",
			"values": [
				"yellow",
				"pink",
				"blue",
				"green"
			],
			"default": "yellow",
			"label": "Color"
		},
		{
			"name": "author",
			"type": "string",
			"default": "Ava",
			"label": "Author",
			"maxLength": 16
		},
		{
			"name": "tilt",
			"type": "number",
			"default": -2,
			"label": "Tilt (deg)",
			"min": -8,
			"max": 8
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
