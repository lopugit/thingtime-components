											"pink": "transparent transparent #f9a8d4 transparent",
											"blue": "transparent transparent #93c5fd transparent",
											"green": "transparent transparent #86efac transparent"
										},
										"default": "transparent transparent #fde047 transparent"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "details",
