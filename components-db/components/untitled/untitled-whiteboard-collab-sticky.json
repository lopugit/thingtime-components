											{
												"tag": "option",
												"props": {
													"value": "pink"
												},
												"children": [
													"pink"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "blue"
												},
												"children": [
													"blue"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "green"
												},
												"children": [
													"green"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "color"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Author ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Author",
											"value": {
												"ttArg": "author"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "author"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Tilt (deg) ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Tilt (deg)",
											"value": {
												"ttArg": "tilt"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": -8,
											"max": 8
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tilt"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
