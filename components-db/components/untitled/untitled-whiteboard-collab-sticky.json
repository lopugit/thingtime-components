												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "text"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Color ",
