{
	"slug": "untitled-date-time-date-input",
	"name": "Date Input",
	"library": "untitled",
	"category": "forms",
	"description": "Labeled date field in the Untitled UI style — calendar glyph beside a formatted date, with the library's focus ring and accent border when focused. Interactive controls and editable values; saves private Things through an Action.",
