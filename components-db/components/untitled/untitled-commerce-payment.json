{
	"slug": "untitled-commerce-payment",
	"name": "Payment Method",
	"library": "untitled",
	"category": "commerce",
	"description": "Saved payment method row in the Untitled UI style — tinted card-brand chip, masked card number, expiry caption, selectable radio ring and an optional default badge. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"commerce",
		"payment",
		"card",
		"saved-method"
	],
	"args": [
		{
			"name": "brand",
			"type": "enum",
			"values": [
				"visa",
				"mastercard",
				"amex"
			],
			"default": "visa",
			"label": "Brand"
		},
		{
			"name": "last4",
			"type": "string",
			"default": "4242",
			"label": "Last 4",
			"maxLength": 4
		},
		{
			"name": "expiry",
			"type": "string",
			"default": "12/27",
			"label": "Expiry",
			"maxLength": 7
		},
		{
			"name": "selected",
			"type": "boolean",
			"default": true,
			"label": "Selected"
		},
		{
			"name": "isDefault",
			"type": "boolean",
			"default": true,
			"label": "Default badge"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save draft",
			"maxLength": 500,
			"label": "Action label"
		}
	],
