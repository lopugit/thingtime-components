								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			},
			{
				"tag": "small",
				"children": [
					"Draft only. Saving creates a private Thing. External effects require a configured Action."
				]
			}
		]
	},
	"version": 2,
	"familyKey": "commerce-payment",
	"source": {
		"kind": "archetype",
		"archetype": "commerce",
		"variant": "payment",
		"tranche": 2
	}
