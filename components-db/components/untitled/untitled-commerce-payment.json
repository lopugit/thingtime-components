												"children": [
													"visa"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "mastercard"
												},
												"children": [
													"mastercard"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "amex"
												},
												"children": [
													"amex"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "brand"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Default badge ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Default badge",
											"type": "checkbox",
											"checked": {
												"ttArg": "isDefault"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "isDefault"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "commerce-payment",
									"title": "Payment Method",
									"details": "Brand: {brand}\nSelected: {selected}\nDefault badge: {isDefault}"
