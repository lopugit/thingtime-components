						"tag": "span",
						"props": {
							"style": {
								"width": "16px",
								"height": "16px",
								"borderRadius": "999px",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttIf": {
										"arg": "selected",
