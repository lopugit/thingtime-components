			{
				"tag": "button",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "12px",
						"width": "340px",
						"padding": "12px 14px",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttIf": {
