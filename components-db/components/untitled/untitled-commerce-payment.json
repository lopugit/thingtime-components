									}
								},
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "12px",
								"fontWeight": 700,
								"letterSpacing": "0.04em",
								"flexShrink": 0
							}
						},
						"children": [
							{
								"ttMap": {
									"arg": "brand",
									"values": {
										"visa": "VISA",
										"mastercard": "MC",
										"amex": "AMEX"
									}
								}
							}
						]
					},
