{
	"slug": "untitled-loading-dots",
	"name": "Loading Dots",
	"library": "untitled",
	"category": "feedback",
	"description": "Row of pulsing loader dots in the Untitled UI style — tone-colored circles fading toward the edges, with an adjustable dot count. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"loading",
		"dots",
		"typing",
		"feedback"
	],
	"args": [
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Dots",
			"min": 2,
			"max": 5
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "6px",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "count",
							"max": 5,
							"node": {
								"tag": "span",
								"props": {
									"style": {
										"width": {
											"ttMap": {
												"arg": "size",
												"values": {
													"sm": "6px",
													"md": "8px",
													"lg": "12px"
												},
												"default": "8px"
											}
										},
										"height": {
											"ttMap": {
												"arg": "size",
												"values": {
													"sm": "6px",
													"md": "8px",
													"lg": "12px"
												},
												"default": "8px"
											}
										},
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#7f56d9",
													"success": "#12b76a",
													"warning": "#f79009",
													"danger": "#f04438",
													"info": "#2e90fa",
													"neutral": "#344054"
												},
												"default": "#7f56d9"
											}
										},
										"opacity": {
											"ttMap": {
												"arg": "n",
												"values": {
													"1": 0.3,
													"2": 0.6,
													"3": 1,
													"4": 0.6,
													"5": 0.3
												},
												"default": 0.6
											}
										},
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Dots ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Dots",
											"value": {
												"ttArg": "count"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 2,
											"max": 5
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "count"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "loading-dots",
									"title": "Loading Dots",
									"details": "Dots: {count}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "loading-dots",
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "dots",
		"tranche": 1
	}
}
