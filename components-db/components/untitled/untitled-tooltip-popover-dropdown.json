{
	"slug": "untitled-tooltip-popover-dropdown",
	"name": "Dropdown Menu",
	"library": "untitled",
	"category": "overlays",
	"description": "Dropdown menu in the Untitled UI style — chevron trigger over an elevated panel of rows with optional leading icons, a separator, and a danger row at the bottom. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"dropdown",
		"menu",
		"overlay",
		"actions"
	],
	"args": [
		{
			"name": "triggerLabel",
			"type": "string",
			"default": "Options",
			"label": "Trigger label",
			"maxLength": 24
		},
		{
			"name": "items",
			"type": "number",
			"default": 3,
			"label": "Menu items",
			"min": 1,
			"max": 6
		},
		{
			"name": "dangerLabel",
			"type": "string",
			"default": "Delete project",
			"label": "Danger label",
			"maxLength": 32
		},
		{
			"name": "showIcons",
			"type": "boolean",
			"default": true,
			"label": "Show icons"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "details",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #eaecf0",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#101828",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "summary",
						"children": [
							"{triggerLabel}"
						]
					},
					{
						"tag": "section",
						"children": [
							{
								"tag": "nav",
								"children": [
									{
										"tag": "a",
										"props": {
											"href": "/things"
										},
										"children": [
											"Open Things"
										]
									},
									" · ",
									{
										"tag": "a",
										"props": {
											"href": "/builder"
										},
										"children": [
											"Open builder"
										]
									}
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Trigger label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Trigger label",
											"value": {
												"ttArg": "triggerLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "triggerLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Menu items ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Menu items",
											"value": {
												"ttArg": "items"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 6
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "items"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Danger label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Danger label",
											"value": {
												"ttArg": "dangerLabel"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "dangerLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show icons ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show icons",
											"type": "checkbox",
											"checked": {
												"ttArg": "showIcons"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "showIcons"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "tooltip-popover-dropdown",
									"title": "Dropdown Menu",
									"details": "Trigger label: {triggerLabel}\nMenu items: {items}\nDanger label: {dangerLabel}\nShow icons: {showIcons}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f9fafb",
	"version": 2,
	"familyKey": "tooltip-popover-dropdown",
	"source": {
		"kind": "archetype",
		"archetype": "tooltip-popover",
		"variant": "dropdown",
		"tranche": 1
	}
}
