{
	"slug": "untitled-search-command-autocomplete",
	"name": "Autocomplete Search",
	"library": "untitled",
	"category": "forms",
	"description": "Autocomplete search in the Untitled UI style — a typed query field above an open suggestions panel where each of four rows bolds the matched query prefix in the active tone, with the first row hovered. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"search",
		"autocomplete",
		"suggestions",
		"dropdown"
	],
	"args": [
		{
			"name": "query",
			"type": "string",
			"default": "da",
			"label": "Query",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "open",
			"type": "boolean",
			"default": true,
			"label": "Panel open"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "searchQuery",
			"type": "string",
			"default": "",
			"maxLength": 200
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #eaecf0",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#101828",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Search Things",
							{
								"tag": "input",
								"props": {
									"type": "search",
									"aria-label": "searchQuery",
									"value": {
										"ttArg": "searchQuery"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #eaecf0",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "searchQuery"
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "8px",
								"border": "1px solid #eaecf0",
								"background": "#f9fafb",
								"cursor": "pointer"
							}
						},
						"children": [
							"Search Things"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "search",
							"value": "{searchQuery}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"searchQuery ",
									{
										"tag": "input",
										"props": {
											"aria-label": "searchQuery",
											"value": {
												"ttArg": "searchQuery"
											},
											"maxLength": 200,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "searchQuery"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Query ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Query",
											"value": {
												"ttArg": "query"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "query"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Panel open ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Panel open",
											"type": "checkbox",
											"checked": {
												"ttArg": "open"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "open"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "search-command-autocomplete",
									"title": "Autocomplete Search",
									"details": "Query: {query}\nPanel open: {open}\nsearchQuery: {searchQuery}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "search-command-autocomplete",
	"source": {
		"kind": "archetype",
		"archetype": "search-command",
		"variant": "autocomplete",
		"tranche": 2
	}
}
