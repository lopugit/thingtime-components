{
	"slug": "untitled-window-chrome-tabs",
	"name": "Editor Tabs",
	"library": "untitled",
	"category": "mockups",
	"description": "Editor tab strip in the Untitled UI style — an active file tab with a tone underline and close x, two resting tabs, an optional plus tab, and a breadcrumb path row. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"mockup",
		"tabs",
		"editor",
		"ide",
		"frame"
	],
	"args": [
		{
			"name": "file",
			"type": "string",
			"default": "App.tsx",
			"label": "Active file",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "plusTab",
			"type": "boolean",
			"default": true,
			"label": "Show + tab"
		},
		{
			"name": "path",
			"type": "string",
			"default": "src / components",
			"label": "Breadcrumb path",
			"maxLength": 40
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"width": "340px",
						"maxWidth": "100%",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#eaecf0",
						"borderRadius": "12px",
						"background": "#ffffff",
						"overflow": "hidden",
						"boxShadow": "0 12px 16px -4px rgba(16, 24, 40, 0.08), 0 4px 6px -2px rgba(16, 24, 40, 0.03)",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "flex-end",
								"gap": "2px",
								"padding": "6px 8px 0",
								"background": "#f9fafb",
								"borderBottomWidth": "1px",
								"borderBottomStyle": "solid",
								"borderBottomColor": "#eaecf0",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "8px",
										"padding": "6px 10px",
										"background": "#ffffff",
										"borderTopLeftRadius": "6px",
										"borderTopRightRadius": "6px",
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#101828",
										"flexShrink": 0,
										"borderBottomWidth": "2px",
										"borderBottomStyle": "solid",
										"borderBottomColor": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#7f56d9",
													"success": "#12b76a",
													"warning": "#f79009",
													"danger": "#f04438",
													"info": "#2e90fa",
													"neutral": "#344054"
												},
												"default": "#7f56d9"
											}
										},
										"flexWrap": "wrap"
									}
								},
								"children": [
									"{file}",
									{
										"tag": "svg",
										"props": {
											"width": 10,
											"height": 10,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#475467",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 18,
													"y1": 6,
													"x2": 6,
													"y2": 18
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 6,
													"y1": 6,
													"x2": 18,
													"y2": 18
												}
											}
										]
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "6px",
										"padding": "6px 10px",
										"fontSize": "12px",
										"color": "#475467",
										"flexShrink": 0,
										"flexWrap": "wrap"
									}
								},
								"children": [
									"index.ts"
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "6px",
										"padding": "6px 10px",
										"fontSize": "12px",
										"color": "#475467",
										"flexShrink": 0,
										"flexWrap": "wrap"
									}
								},
								"children": [
									"styles.css"
								]
							},
							{
								"ttIf": {
									"arg": "plusTab",
									"then": {
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"padding": "6px 8px",
												"flexShrink": 0,
												"flexWrap": "wrap"
											}
										},
										"children": [
											{
												"tag": "svg",
												"props": {
													"width": 12,
													"height": 12,
													"viewBox": "0 0 24 24",
													"fill": "none",
													"stroke": "#475467",
													"strokeWidth": 2,
													"strokeLinecap": "round",
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "line",
														"props": {
															"x1": 12,
															"y1": 5,
															"x2": 12,
															"y2": 19
														}
													},
													{
														"tag": "line",
														"props": {
															"x1": 5,
															"y1": 12,
															"x2": 19,
															"y2": 12
														}
													}
												]
											}
										]
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "7px 10px",
								"fontSize": "12px",
								"color": "#475467",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"flexWrap": "wrap"
							}
						},
						"children": [
							"{path}",
							{
								"tag": "svg",
								"props": {
									"width": 10,
									"height": 10,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "#98a2b3",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polyline",
										"props": {
											"points": "9 6 15 12 9 18"
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"color": "#101828",
										"fontWeight": 600
									}
								},
								"children": [
									"{file}"
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Active file ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Active file",
											"value": {
												"ttArg": "file"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "file"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show + tab ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show + tab",
											"type": "checkbox",
											"checked": {
												"ttArg": "plusTab"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "plusTab"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Breadcrumb path ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Breadcrumb path",
											"value": {
												"ttArg": "path"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "path"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "window-chrome-tabs",
									"title": "Editor Tabs",
									"details": "Active file: {file}\nShow + tab: {plusTab}\nBreadcrumb path: {path}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "window-chrome-tabs",
	"source": {
		"kind": "archetype",
		"archetype": "window-chrome",
		"variant": "tabs",
		"tranche": 2
	}
}
