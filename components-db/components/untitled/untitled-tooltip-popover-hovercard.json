{
	"slug": "untitled-tooltip-popover-hovercard",
	"name": "Hovercard",
	"library": "untitled",
	"category": "overlays",
	"description": "Profile hovercard in the Untitled UI style — dotted-underline handle trigger above a card with an initials avatar, name, bio, follower stats, and a tone follow button. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"hovercard",
		"profile",
		"overlay",
		"card"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Ada Lovelace",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "handle",
			"type": "string",
			"default": "ada",
			"label": "Handle",
			"maxLength": 24
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AL",
			"label": "Initials",
			"maxLength": 2
		},
		{
			"name": "bio",
			"type": "text",
			"default": "Writing about analytical engines, poetry, and the software in between.",
			"label": "Bio",
			"maxLength": 500
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "details",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #eaecf0",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#101828",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "summary",
						"children": [
							"{name}"
						]
					},
					{
						"tag": "section",
						"children": [
							{
								"tag": "p",
								"children": [
									"{bio}"
								]
							},
							{
								"tag": "nav",
								"children": [
									{
										"tag": "a",
										"props": {
											"href": "/things"
										},
										"children": [
											"Open Things"
										]
									},
									" · ",
									{
										"tag": "a",
										"props": {
											"href": "/builder"
										},
										"children": [
											"Open builder"
										]
									}
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Name",
											"value": {
												"ttArg": "name"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "name"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Handle ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Handle",
											"value": {
												"ttArg": "handle"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "handle"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 2,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Bio ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Bio",
											"value": {
												"ttArg": "bio"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "bio"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "tooltip-popover-hovercard",
									"title": "Hovercard",
									"details": "Name: {name}\nHandle: {handle}\nInitials: {initials}\nBio: {bio}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f9fafb",
	"version": 2,
	"familyKey": "tooltip-popover-hovercard",
	"source": {
		"kind": "archetype",
		"archetype": "tooltip-popover",
		"variant": "hovercard",
		"tranche": 1
	}
}
