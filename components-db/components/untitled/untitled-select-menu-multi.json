{
	"slug": "untitled-select-menu-multi",
	"name": "Multi Select",
	"library": "untitled",
	"category": "forms",
	"description": "Multi-select field in the Untitled UI style with independent choices and removable selected tags. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"select",
		"multi",
		"tags",
		"chips"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Teams",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tagA",
			"type": "string",
			"default": "Design",
			"label": "First tag",
			"maxLength": 24
		},
		{
			"name": "tagB",
			"type": "string",
			"default": "Platform",
			"label": "Second tag",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "selectedA",
			"type": "boolean",
			"default": true,
			"label": "First tag selected"
		},
		{
			"name": "selectedB",
			"type": "boolean",
			"default": true,
			"label": "Second tag selected"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #eaecf0",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#101828",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"minWidth": 0,
								"display": "grid",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "legend",
								"children": [
									"{label}"
								]
							},
							{
								"tag": "label",
								"children": [
									{
										"tag": "input",
										"props": {
											"type": "checkbox",
											"checked": {
												"ttArg": "selectedA"
											},
											"aria-label": "{tagA}"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedA"
										}
									},
									"{tagA}"
								]
							},
							{
								"tag": "label",
								"children": [
									{
										"tag": "input",
										"props": {
											"type": "checkbox",
											"checked": {
												"ttArg": "selectedB"
											},
											"aria-label": "{tagB}"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedB"
										}
									},
									"{tagB}"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexWrap": "wrap",
								"gap": "6px"
							},
							"aria-label": "Selected values"
						},
						"children": [
							{
								"ttIf": {
									"arg": "selectedA",
									"then": {
										"tag": "button",
										"props": {
											"type": "button",
											"style": {
												"padding": "8px 12px",
												"borderRadius": "8px",
												"border": "1px solid #eaecf0",
												"background": "#f9fafb",
												"cursor": "pointer"
											}
										},
										"children": [
											"Remove {tagA}"
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedA",
											"value": false
										}
									}
								}
							},
							{
								"ttIf": {
									"arg": "selectedB",
									"then": {
										"tag": "button",
										"props": {
											"type": "button",
											"style": {
												"padding": "8px 12px",
												"borderRadius": "8px",
												"border": "1px solid #eaecf0",
												"background": "#f9fafb",
												"cursor": "pointer"
											}
										},
										"children": [
											"Remove {tagB}"
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedB",
											"value": false
										}
									}
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"First tag selected ",
									{
										"tag": "input",
										"props": {
											"aria-label": "First tag selected",
											"type": "checkbox",
											"checked": {
												"ttArg": "selectedA"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedA"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Second tag selected ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Second tag selected",
											"type": "checkbox",
											"checked": {
												"ttArg": "selectedB"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedB"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"First tag ",
									{
										"tag": "input",
										"props": {
											"aria-label": "First tag",
											"value": {
												"ttArg": "tagA"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tagA"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Second tag ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Second tag",
											"value": {
												"ttArg": "tagB"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tagB"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "select-menu-multi",
									"title": "Multi Select",
									"details": "Label: {label}\nFirst tag: {tagA}\nSecond tag: {tagB}\nFirst tag selected: {selectedA}\nSecond tag selected: {selectedB}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "select-menu-multi",
	"source": {
		"kind": "archetype",
		"archetype": "select-menu",
		"variant": "multi",
		"tranche": 1
	}
}
