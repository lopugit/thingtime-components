{
	"slug": "untitled-avatar-squared",
	"name": "Squared Avatar",
	"library": "untitled",
	"category": "data-display",
	"description": "Rounded-square initials avatar in the Untitled UI style — the library's own corner radius on a tone-filled tile, with an optional soft tint. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"avatar",
		"squared",
		"initials",
		"tile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "TT",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 600,
								"borderRadius": "8px",
								"flexShrink": 0,
								"userSelect": "none",
								"flexWrap": "wrap"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"width": "28px",
											"height": "28px",
											"fontSize": "12px"
										},
										"md": {
											"width": "40px",
											"height": "40px",
											"fontSize": "14px"
										},
										"lg": {
											"width": "56px",
											"height": "56px",
											"fontSize": "16px"
										}
									},
									"default": {
										"width": "40px",
										"height": "40px",
										"fontSize": "14px"
									}
								}
							},
							{
								"ttIf": {
									"arg": "soft",
									"then": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f9f5ff",
													"success": "#ecfdf3",
													"warning": "#fffaeb",
													"danger": "#fef3f2",
													"info": "#eff8ff",
													"neutral": "#f2f4f7"
												},
												"default": "#f9f5ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#6941c6",
													"success": "#027a48",
													"warning": "#b54708",
													"danger": "#b42318",
													"info": "#175cd3",
													"neutral": "#344054"
												},
												"default": "#6941c6"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #e9d7fe",
													"success": "1px solid #a6f4c5",
													"warning": "1px solid #fedf89",
													"danger": "1px solid #fecdca",
													"info": "1px solid #b2ddff",
													"neutral": "1px solid #d0d5dd"
												},
												"default": "1px solid #e9d7fe"
											}
										}
									},
									"else": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#7f56d9",
													"success": "#12b76a",
													"warning": "#f79009",
													"danger": "#f04438",
													"info": "#2e90fa",
													"neutral": "#344054"
												},
												"default": "#7f56d9"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									}
								}
							}
						]
					}
				},
				"children": [
					"{initials}"
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Soft tint ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Soft tint",
											"type": "checkbox",
											"checked": {
												"ttArg": "soft"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "soft"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "avatar-squared",
									"title": "Squared Avatar",
									"details": "Initials: {initials}\nSoft tint: {soft}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "avatar-squared",
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "squared",
		"tranche": 1
	}
}
