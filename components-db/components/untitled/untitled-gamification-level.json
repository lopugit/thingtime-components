{
	"slug": "untitled-gamification-level",
	"name": "Level Emblem",
	"library": "untitled",
	"category": "engagement",
	"description": "Level emblem in the Untitled UI style — a hexagonal badge filled with the tone color and the level number overlaid, above a title caption and a next-level XP hint. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"gamification",
		"level",
		"badge",
		"emblem"
	],
	"args": [
		{
			"name": "level",
			"type": "number",
			"default": 12,
			"label": "Level",
			"min": 1
		},
		{
			"name": "title",
			"type": "string",
			"default": "Gold Tier",
			"label": "Title",
			"maxLength": 24
		},
		{
			"name": "next",
			"type": "string",
			"default": "2,500",
			"label": "Next-level XP",
			"maxLength": 10
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "inline-flex",
						"flexDirection": "column",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "relative",
								"width": "64px",
								"height": "72px",
								"maxWidth": "100%"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 64,
									"height": 72,
									"viewBox": "0 0 64 72",
									"fill": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#7f56d9",
												"success": "#12b76a",
												"warning": "#f79009",
												"danger": "#f04438",
												"info": "#2e90fa",
												"neutral": "#344054"
											},
											"default": "#7f56d9"
										}
									},
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "32 2 60 19 60 53 32 70 4 53 4 19"
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"position": "absolute",
										"top": "0px",
										"left": "0px",
										"width": "100%",
										"height": "100%",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										},
										"fontSize": "22px",
										"fontWeight": 600,
										"maxWidth": "100%",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									}
								},
								"children": [
									"{level}"
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#101828"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#475467"
							}
						},
						"children": [
							"Next level at {next} XP"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Level ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Level",
											"value": {
												"ttArg": "level"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "level"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Next-level XP ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Next-level XP",
											"value": {
												"ttArg": "next"
											},
											"maxLength": 10,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "next"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "gamification-level",
									"title": "Level Emblem",
									"details": "Level: {level}\nTitle: {title}\nNext-level XP: {next}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "gamification-level",
	"source": {
		"kind": "archetype",
		"archetype": "gamification",
		"variant": "level",
		"tranche": 2
	}
}
