{
	"slug": "untitled-input-icon",
	"name": "Icon Input",
	"library": "untitled",
	"category": "forms",
	"description": "Search field with a leading icon in the Untitled UI style — muted magnifier inside the field chrome, plus an optional mono shortcut chip. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"input",
		"icon",
		"search",
		"form"
	],
	"args": [
		{
			"name": "placeholder",
			"type": "string",
			"default": "Search…",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "shortcut",
			"type": "boolean",
			"default": true,
			"label": "Shortcut chip"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "entry1",
			"type": "string",
			"default": "",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"gap": "8px",
								"width": "260px",
								"padding": "0 10px",
								"border": "1px solid #eaecf0",
								"borderRadius": "8px",
								"background": "#ffffff",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"boxSizing": "border-box",
								"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
								"maxWidth": "100%",
								"flexWrap": "wrap"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"height": "36px",
											"fontSize": "14px"
										},
										"md": {
											"height": "40px",
											"fontSize": "14px"
										},
										"lg": {
											"height": "44px",
											"fontSize": "16px"
										}
									},
									"default": {
										"height": "40px",
										"fontSize": "14px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 16,
							"height": 16,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#475467",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "circle",
								"props": {
									"cx": 11,
									"cy": 11,
									"r": 7
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 21,
									"y1": 21,
									"x2": 16.65,
									"y2": 16.65
								}
							}
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"placeholder": "{placeholder}",
							"style": {
								"flex": 1,
								"minWidth": 0,
								"border": "none",
								"outline": "none",
								"background": "transparent",
								"padding": 0,
								"color": "#101828",
								"fontSize": "inherit"
							},
							"value": {
								"ttArg": "entry1"
							},
							"aria-label": "{placeholder}",
							"maxLength": 500
						},
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "entry1"
						}
					},
					{
						"ttIf": {
							"arg": "shortcut",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"fontSize": "12px",
										"color": "#98a2b3",
										"border": "1px solid #f2f4f7",
										"borderRadius": "6px",
										"padding": "2px 5px",
										"flexShrink": 0
									}
								},
								"children": [
									"⌘K"
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"entry1 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "entry1",
											"value": {
												"ttArg": "entry1"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "entry1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Shortcut chip ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Shortcut chip",
											"type": "checkbox",
											"checked": {
												"ttArg": "shortcut"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "shortcut"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "input-icon",
									"title": "Icon Input",
									"details": "Shortcut chip: {shortcut}\nentry1: {entry1}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "input-icon",
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "icon",
		"tranche": 1
	}
}
