{
	"slug": "untitled-sports-scores-standings",
	"name": "League Standings",
	"library": "untitled",
	"category": "sports",
	"description": "League table in the Untitled UI style — Pos/Team/P/W/D/L/Pts header over four club rows with W/L form dots, the top row tinted for promotion and the bottom row tinted for relegation. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"sports",
		"standings",
		"table",
		"league"
	],
	"args": [
		{
			"name": "team",
			"type": "string",
			"default": "Harriers",
			"label": "Your team",
			"maxLength": 20
		},
		{
			"name": "pts",
			"type": "string",
			"default": "27",
			"label": "Your points",
			"maxLength": 3
		},
		{
			"name": "formDots",
			"type": "boolean",
			"default": true,
			"label": "Show form dots"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #eaecf0",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#101828",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "h3",
						"children": [
							"Standings"
						]
					},
					{
						"tag": "table",
						"children": [
							{
								"tag": "thead",
								"children": [
									{
										"tag": "tr",
										"children": [
											{
												"tag": "th",
												"children": [
													"Team"
												]
											},
											{
												"tag": "th",
												"children": [
													"Points"
												]
											}
										]
									}
								]
							},
							{
								"tag": "tbody",
								"children": [
									{
										"tag": "tr",
										"children": [
											{
												"tag": "td",
												"children": [
													"{team}"
												]
											},
											{
												"tag": "td",
												"children": [
													"{pts}"
												]
											}
										]
									}
								]
							}
						]
					},
					{
						"tag": "small",
						"children": [
							"Edit team and points, then save the standing as a Thing."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Your team ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Your team",
											"value": {
												"ttArg": "team"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "team"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Your points ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Your points",
											"value": {
												"ttArg": "pts"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #eaecf0",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "pts"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show form dots ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show form dots",
											"type": "checkbox",
											"checked": {
												"ttArg": "formDots"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "formDots"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #eaecf0",
										"borderRadius": "8px",
										"background": "#f9fafb",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "sports-scores-standings",
									"title": "League Standings",
									"details": "Your team: {team}\nYour points: {pts}\nShow form dots: {formDots}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "sports-scores-standings",
	"source": {
		"kind": "archetype",
		"archetype": "sports-scores",
		"variant": "standings",
		"tranche": 2
	}
}
