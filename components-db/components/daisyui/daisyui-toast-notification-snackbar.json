{
	"slug": "daisyui-toast-notification-snackbar",
	"name": "Snackbar",
	"library": "daisyui",
	"category": "feedback",
	"description": "Dark snackbar bar in the daisyUI style — inverse ink surface with the message on the left and a tone-tinted action link on the right. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"snackbar",
		"toast",
		"feedback",
		"action"
	],
	"args": [
		{
			"name": "message",
			"type": "string",
			"default": "Conversation archived",
			"label": "Message",
			"maxLength": 60
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showClose",
			"type": "boolean",
			"default": false,
			"label": "Show close"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "16px",
						"justifyContent": "space-between",
						"minWidth": 0,
						"padding": "10px 16px",
						"background": "#1f2937",
						"color": "#ffffff",
						"borderRadius": "16px",
						"boxShadow": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
						"fontSize": "14px",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontWeight": 400
							}
						},
						"children": [
							"{message}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "12px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#d6c4fd",
													"success": "#86efac",
													"warning": "#fde047",
													"danger": "#fda4af",
													"info": "#7dd3fc",
													"neutral": "#d1d5db"
												},
												"default": "#d6c4fd"
											}
										},
										"fontWeight": 600
									}
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"ttIf": {
									"arg": "showClose",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"display": "inline-flex",
												"color": "#e5e6e6",
												"flexWrap": "wrap"
											}
										},
										"children": [
											{
												"tag": "svg",
												"props": {
													"width": 14,
													"height": 14,
													"viewBox": "0 0 24 24",
													"fill": "none",
													"stroke": "currentColor",
													"strokeWidth": 2,
													"strokeLinecap": "round",
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "line",
														"props": {
															"x1": 18,
															"y1": 6,
															"x2": 6,
															"y2": 18
														}
													},
													{
														"tag": "line",
														"props": {
															"x1": 6,
															"y1": 6,
															"x2": 18,
															"y2": 18
														}
													}
												]
											}
										]
									}
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Message ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Message",
											"value": {
												"ttArg": "message"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "message"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show close ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show close",
											"type": "checkbox",
											"checked": {
												"ttArg": "showClose"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "showClose"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "toast-notification-snackbar",
									"title": "Snackbar",
									"details": "Message: {message}\nShow close: {showClose}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "toast-notification-snackbar",
	"source": {
		"kind": "archetype",
		"archetype": "toast-notification",
		"variant": "snackbar",
		"tranche": 1
	}
}
