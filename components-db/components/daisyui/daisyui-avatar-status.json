{
	"slug": "daisyui-avatar-status",
	"name": "Status Avatar",
	"library": "daisyui",
	"category": "data-display",
	"description": "Initials avatar with a presence dot in the daisyUI style — online, away or busy indicator ringed by the surface color. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"avatar",
		"status",
		"presence",
		"indicator"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "JT",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "status",
			"type": "enum",
			"values": [
				"online",
				"away",
				"busy"
			],
			"default": "online",
			"label": "Status"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"display": "inline-flex",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontWeight": 700,
										"borderRadius": "999px",
										"flexShrink": 0,
										"userSelect": "none",
										"flexWrap": "wrap"
									},
									{
										"ttMap": {
											"arg": "size",
											"values": {
												"sm": {
													"width": "28px",
													"height": "28px",
													"fontSize": "12px"
												},
												"md": {
													"width": "40px",
													"height": "40px",
													"fontSize": "14px"
												},
												"lg": {
													"width": "56px",
													"height": "56px",
													"fontSize": "18px"
												}
											},
											"default": {
												"width": "40px",
												"height": "40px",
												"fontSize": "14px"
											}
										}
									},
									{
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#570df8",
													"success": "#00a96e",
													"warning": "#ffbe00",
													"danger": "#ff5861",
													"info": "#00b6ff",
													"neutral": "#2a323c"
												},
												"default": "#570df8"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#382800",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									}
								]
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"ttMerge": [
									{
										"position": "absolute",
										"right": "0",
										"bottom": "0",
										"borderRadius": "999px",
										"border": "2px solid #ffffff",
										"background": {
											"ttMap": {
												"arg": "status",
												"values": {
													"online": "#00a96e",
													"away": "#ffbe00",
													"busy": "#ff5861"
												},
												"default": "#00a96e"
											}
										}
									},
									{
										"ttMap": {
											"arg": "size",
											"values": {
												"sm": {
													"width": "9px",
													"height": "9px"
												},
												"md": {
													"width": "11px",
													"height": "11px"
												},
												"lg": {
													"width": "14px",
													"height": "14px"
												}
											},
											"default": {
												"width": "11px",
												"height": "11px"
											}
										}
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Status ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Status",
											"value": {
												"ttArg": "status"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "online"
												},
												"children": [
													"online"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "away"
												},
												"children": [
													"away"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "busy"
												},
												"children": [
													"busy"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "status"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "avatar-status",
									"title": "Status Avatar",
									"details": "Initials: {initials}\nStatus: {status}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "avatar-status",
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "status",
		"tranche": 1
	}
}
