{
	"slug": "daisyui-security-privacy-vault-row",
	"name": "Vault Password Row",
	"library": "daisyui",
	"category": "security",
	"description": "Password-manager vault row in the daisyUI style — favicon initial tile, site and username captions, a strength dot, last-changed note, copy/reveal ghosts, and a reused-password warning chip. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"security",
		"password",
		"vault",
		"row"
	],
	"args": [
		{
			"name": "site",
			"type": "string",
			"default": "github.com",
			"label": "Site",
			"maxLength": 40
		},
		{
			"name": "initial",
			"type": "string",
			"default": "G",
			"label": "Favicon initial",
			"maxLength": 2
		},
		{
			"name": "username",
			"type": "string",
			"default": "nikolaj@thingtime.com",
			"label": "Username",
			"maxLength": 60
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"strong"
			],
			"default": "strong",
			"label": "Strength"
		},
		{
			"name": "reused",
			"type": "boolean",
			"default": false,
			"label": "Reused password"
