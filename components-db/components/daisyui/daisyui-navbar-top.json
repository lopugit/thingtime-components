{
	"slug": "daisyui-navbar-top",
	"name": "Top Navbar",
	"library": "daisyui",
	"category": "navigation",
	"description": "Top app bar in the daisyUI style — brand mark and name on the left, inline navigation links, and a quiet bell on the right. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"navbar",
		"navigation",
		"header",
		"links"
	],
	"args": [
		{
			"name": "brand",
			"type": "string",
			"default": "Acme",
			"label": "Brand",
			"maxLength": 24
		},
		{
			"name": "link1",
			"type": "string",
			"default": "Home",
			"label": "Link 1",
			"maxLength": 24
		},
		{
			"name": "link2",
			"type": "string",
			"default": "Projects",
			"label": "Link 2",
			"maxLength": 24
		},
		{
			"name": "link3",
			"type": "string",
			"default": "Pricing",
			"label": "Link 3",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "nav",
				"props": {
					"style": {
						"display": "flex",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e5e6e6",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#1f2937",
						"minWidth": 0,
						"maxWidth": "100%",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "strong",
						"children": [
							"{brand}"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Home"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/things",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Things"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/components",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Components"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/builder/demos",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Demos"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Brand ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Brand",
											"value": {
												"ttArg": "brand"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "brand"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Link 1 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Link 1",
											"value": {
												"ttArg": "link1"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "link1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Link 2 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Link 2",
											"value": {
												"ttArg": "link2"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "link2"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Link 3 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Link 3",
											"value": {
												"ttArg": "link3"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "link3"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "navbar-top",
									"title": "Top Navbar",
									"details": "Brand: {brand}\nLink 1: {link1}\nLink 2: {link2}\nLink 3: {link3}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "navbar-top",
	"source": {
		"kind": "archetype",
		"archetype": "navbar",
		"variant": "top",
		"tranche": 1
	}
}
