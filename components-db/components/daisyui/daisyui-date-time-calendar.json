{
	"slug": "daisyui-date-time-calendar",
	"name": "Mini Calendar",
	"library": "daisyui",
	"category": "forms",
	"description": "Mini month calendar in the daisyUI style — chevron month header, S-M-T-W-T-F-S weekday row and a 7-column day grid, with the selected day echoed in an accent chip. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"calendar",
		"date",
		"picker",
		"month"
	],
	"args": [
		{
			"name": "month",
			"type": "string",
			"default": "March 2026",
			"label": "Month",
			"maxLength": 24
		},
		{
			"name": "days",
			"type": "number",
			"default": 30,
			"label": "Days shown",
			"min": 1,
			"max": 31
		},
		{
			"name": "selected",
			"type": "number",
			"default": 14,
			"label": "Selected day",
			"min": 1,
			"max": 31
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "selectedDate",
			"type": "string",
			"default": "",
			"label": "Date"
		},
		{
			"name": "selectedTime",
			"type": "string",
			"default": "",
			"label": "Time"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e5e6e6",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#1f2937",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Date",
							{
								"tag": "input",
								"props": {
									"type": "date",
									"aria-label": "selectedDate",
									"value": {
										"ttArg": "selectedDate"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #e5e6e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "selectedDate"
								}
							}
						]
					},
					{
						"tag": "label",
						"children": [
							"Time",
							{
								"tag": "input",
								"props": {
									"type": "time",
									"aria-label": "selectedTime",
									"value": {
										"ttArg": "selectedTime"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #e5e6e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "selectedTime"
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Date ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Date",
											"value": {
												"ttArg": "selectedDate"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedDate"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Time ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Time",
											"value": {
												"ttArg": "selectedTime"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedTime"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Month ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Month",
											"value": {
												"ttArg": "month"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "month"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Days shown ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Days shown",
											"value": {
												"ttArg": "days"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 31
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "days"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Selected day ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Selected day",
											"value": {
												"ttArg": "selected"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 31
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selected"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "date-time-calendar",
									"title": "Mini Calendar",
									"details": "Month: {month}\nDays shown: {days}\nSelected day: {selected}\nDate: {selectedDate}\nTime: {selectedTime}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "date-time-calendar",
	"source": {
		"kind": "archetype",
		"archetype": "date-time",
		"variant": "calendar",
		"tranche": 2
	}
}
