{
	"slug": "daisyui-chip-closable",
	"name": "Closable Chip",
	"library": "daisyui",
	"category": "data-display",
	"description": "Removable tag chip in the daisyUI style — a soft tone chip with a trailing x glyph, dimming when disabled. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"chip",
		"tag",
		"closable",
		"removable"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Filter: recent",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"height": "32px",
								"padding": "0 12px",
								"borderRadius": "999px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 500,
								"fontSize": "14px",
								"flexWrap": "wrap"
							},
							{
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#eee6ff",
											"success": "#dcfce7",
											"warning": "#fef9c3",
											"danger": "#ffe4e6",
											"info": "#e0f2fe",
											"neutral": "#f2f2f2"
										},
										"default": "#eee6ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#4506cb",
											"success": "#00753d",
											"warning": "#854d0e",
											"danger": "#be123c",
											"info": "#0369a1",
											"neutral": "#2a323c"
										},
										"default": "#4506cb"
									}
								}
							},
							{
								"cursor": "pointer"
							},
							{
								"ttIf": {
									"arg": "disabled",
									"then": {
										"opacity": 0.5,
										"cursor": "not-allowed"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					"{label}",
					{
						"tag": "svg",
						"props": {
							"width": 12,
							"height": 12,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "line",
								"props": {
									"x1": 18,
									"y1": 6,
									"x2": 6,
									"y2": 18
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 6,
									"y1": 6,
									"x2": 18,
									"y2": 18
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "chip-closable",
									"title": "Closable Chip",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "chip-closable",
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "closable",
		"tranche": 1
	}
}
