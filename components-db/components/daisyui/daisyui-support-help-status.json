{
	"slug": "daisyui-support-help-status",
	"name": "Incident Status Banner",
	"library": "daisyui",
	"category": "support",
	"description": "Incident status banner in the daisyUI style — state dot and tint flip between operational, degraded, and outage, with subscribe and details actions plus a shimmer bar during incidents. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"support",
		"status",
		"incident",
		"banner",
		"uptime"
	],
	"args": [
		{
			"name": "system",
			"type": "string",
			"default": "API",
			"label": "System",
			"maxLength": 24
		},
		{
			"name": "state",
			"type": "enum",
			"values": [
				"operational",
				"degraded",
				"outage"
			],
			"default": "degraded",
			"label": "State"
		},
		{
			"name": "ago",
			"type": "string",
			"default": "4 min ago",
			"label": "Updated",
			"maxLength": 16
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
