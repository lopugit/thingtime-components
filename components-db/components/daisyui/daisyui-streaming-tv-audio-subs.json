{
	"slug": "daisyui-streaming-tv-audio-subs",
	"name": "Audio & Subtitles Panel",
	"library": "daisyui",
	"category": "entertainment",
	"description": "Audio and subtitles picker in the daisyUI style — two column groups of language radio rows with one selection each, an optional CC chip in the header, and a quiet settings caption underneath. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"streaming",
		"subtitles",
		"audio",
		"language",
		"panel"
	],
	"args": [
		{
			"name": "audio",
			"type": "string",
			"default": "English (5.1)",
			"label": "Selected audio",
			"maxLength": 24
		},
		{
			"name": "lang",
			"type": "string",
			"default": "English (CC)",
			"label": "Selected subtitle",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "cc",
			"type": "boolean",
			"default": true,
			"label": "CC chip"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "mediaUrl",
			"type": "string",
			"default": "",
			"label": "Media URL",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e5e6e6",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#1f2937",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Media URL",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "mediaUrl",
									"value": {
										"ttArg": "mediaUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #e5e6e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "mediaUrl"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "mediaUrl",
							"equals": "",
							"then": null,
							"else": {
								"tag": "video",
								"props": {
									"src": "{mediaUrl}",
									"controls": true,
									"style": {
										"width": "100%",
										"maxHeight": "400px"
									}
								}
							}
						}
					},
					{
						"tag": "small",
						"children": [
							"Add a playable media URL to play, pause, seek, adjust volume, and use fullscreen."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Media URL ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Media URL",
											"value": {
												"ttArg": "mediaUrl"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "mediaUrl"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Selected audio ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Selected audio",
											"value": {
												"ttArg": "audio"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "audio"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Selected subtitle ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Selected subtitle",
											"value": {
												"ttArg": "lang"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "lang"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"CC chip ",
									{
										"tag": "input",
										"props": {
											"aria-label": "CC chip",
											"type": "checkbox",
											"checked": {
												"ttArg": "cc"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "cc"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "streaming-tv-audio-subs",
									"title": "Audio & Subtitles Panel",
									"details": "Selected audio: {audio}\nSelected subtitle: {lang}\nCC chip: {cc}\nMedia URL: {mediaUrl}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "streaming-tv-audio-subs",
	"source": {
		"kind": "archetype",
		"archetype": "streaming-tv",
		"variant": "audio-subs",
		"tranche": 2
	}
}
