{
	"slug": "daisyui-list-simple",
	"name": "Simple List",
	"library": "daisyui",
	"category": "data-display",
	"description": "Plain text list rows in the daisyUI style — hairline separators, library-native type, with toggleable dividers and outer border. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"list",
		"rows",
		"text",
		"data"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "List item",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Rows",
			"min": 1,
			"max": 8
		},
		{
			"name": "divided",
			"type": "boolean",
			"default": true,
			"label": "Dividers"
		},
		{
			"name": "bordered",
			"type": "boolean",
			"default": true,
			"label": "Border"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "ul",
				"props": {
					"style": {
						"ttMerge": [
							{
								"listStyle": "none",
								"margin": 0,
								"padding": 0,
								"width": "280px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"color": "#1f2937",
								"background": "#ffffff",
								"borderRadius": "12px",
								"overflow": "hidden",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							},
							{
								"ttIf": {
									"arg": "bordered",
									"then": {
										"border": "1px solid #e5e6e6",
										"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "count",
							"max": 8,
							"node": {
								"tag": "li",
								"props": {
									"style": {
										"ttMerge": [
											{
												"display": "flex",
												"alignItems": "center",
												"gap": "12px",
												"padding": "10px 14px",
												"fontSize": "14px",
												"flexWrap": "wrap"
											},
											{
												"ttIf": {
													"arg": "divided",
													"then": {
														"ttIf": {
															"arg": "n",
															"equals": 1,
															"then": {},
															"else": {
																"borderTop": "1px solid #f2f2f2"
															}
														}
													},
													"else": {}
												}
											}
										]
									}
								},
								"children": [
									"{item} {n}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Item label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Item label",
											"value": {
												"ttArg": "item"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "item"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Rows ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Rows",
											"value": {
												"ttArg": "count"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 8
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "count"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Dividers ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Dividers",
											"type": "checkbox",
											"checked": {
												"ttArg": "divided"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "divided"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "list-simple",
									"title": "Simple List",
									"details": "Item label: {item}\nRows: {count}\nDividers: {divided}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "list-simple",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "simple",
		"tranche": 1
	}
}
