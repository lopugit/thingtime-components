{
	"slug": "daisyui-photo-gallery-album",
	"name": "Album Card",
	"library": "daisyui",
	"category": "media",
	"description": "Album card in the daisyUI style — a stacked-photos illusion peeking behind the tone-tinted cover, title and item-count caption, a shared-with avatar pair and an open button. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"photo",
		"album",
		"card",
		"collection"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Summer trip",
			"label": "Title",
			"maxLength": 24
		},
		{
			"name": "count",
			"type": "string",
			"default": "86",
			"label": "Item count",
			"maxLength": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "shared",
			"type": "boolean",
			"default": true,
			"label": "Shared"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "imageUrl",
			"type": "string",
			"default": "",
			"maxLength": 500
		},
		{
			"name": "rotation",
			"type": "number",
			"default": 0,
			"min": 0,
			"max": 360
		},
		{
			"name": "exposure",
			"type": "number",
			"default": 100,
			"min": 10,
			"max": 200
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e5e6e6",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#1f2937",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Image URL",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "imageUrl",
									"value": {
										"ttArg": "imageUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #e5e6e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "imageUrl"
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"overflow": "hidden",
								"minWidth": 0
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "imageUrl",
									"equals": "",
									"then": {
										"tag": "p",
										"children": [
											"Enter an image URL to view and adjust it."
										]
									},
									"else": {
										"tag": "img",
										"props": {
											"src": "{imageUrl}",
											"alt": "Image preview",
											"style": {
												"width": "100%",
												"maxHeight": "400px",
												"objectFit": "contain",
												"filter": "brightness({exposure}%)",
												"transform": "rotate({rotation}deg)"
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "8px",
								"border": "1px solid #e5e6e6",
								"background": "#f2f2f2",
								"cursor": "pointer"
							}
						},
						"children": [
							"Rotate image"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "cycle",
							"key": "rotation",
							"values": [
								0,
								90,
								180,
								270
							]
						}
					},
					{
						"tag": "tt-dialog",
						"props": {
							"title": "Image viewer",
							"name": "Open image viewer"
						},
						"children": [
							{
								"ttIf": {
									"arg": "imageUrl",
									"equals": "",
									"then": {
										"tag": "p",
										"children": [
											"Enter an image URL to view and adjust it."
										]
									},
									"else": {
										"tag": "img",
										"props": {
											"src": "{imageUrl}",
											"alt": "Image preview",
											"style": {
												"width": "100%",
												"maxHeight": "400px",
												"objectFit": "contain",
												"filter": "brightness({exposure}%)",
												"transform": "rotate({rotation}deg)"
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "small",
						"children": [
							"Adjustments affect this preview. Save stores the image URL and settings in a private Thing."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"imageUrl ",
									{
										"tag": "input",
										"props": {
											"aria-label": "imageUrl",
											"value": {
												"ttArg": "imageUrl"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "imageUrl"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"rotation ",
									{
										"tag": "input",
										"props": {
											"aria-label": "rotation",
											"value": {
												"ttArg": "rotation"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 360
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "rotation"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Item count ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Item count",
											"value": {
												"ttArg": "count"
											},
											"maxLength": 6,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "count"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Shared ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Shared",
											"type": "checkbox",
											"checked": {
												"ttArg": "shared"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "shared"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"exposure ",
									{
										"tag": "input",
										"props": {
											"aria-label": "exposure",
											"value": {
												"ttArg": "exposure"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 10,
											"max": 200
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "exposure"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "photo-gallery-album",
									"title": "Album Card",
									"details": "Title: {title}\nItem count: {count}\nShared: {shared}\nimageUrl: {imageUrl}\nrotation: {rotation}\nexposure: {exposure}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "photo-gallery-album",
	"source": {
		"kind": "archetype",
		"archetype": "photo-gallery",
		"variant": "album",
		"tranche": 2
	}
}
