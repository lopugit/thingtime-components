{
	"slug": "daisyui-window-chrome-phone",
	"name": "Phone Frame",
	"library": "daisyui",
	"category": "mockups",
	"description": "Phone frame mockup in the daisyUI style — extra-chunky bezel, notch or punch-hole cutout, a status bar with time, signal and battery, tone hero block, placeholder lines and a home indicator. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"mockup",
		"phone",
		"mobile",
		"frame"
	],
	"args": [
		{
			"name": "time",
			"type": "string",
			"default": "9:41",
			"label": "Status time",
			"maxLength": 8
		},
		{
			"name": "cutout",
			"type": "enum",
			"values": [
				"notch",
				"punch"
			],
			"default": "notch",
			"label": "Cutout"
		},
		{
			"name": "blocks",
			"type": "number",
			"default": 3,
			"label": "Content lines"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
