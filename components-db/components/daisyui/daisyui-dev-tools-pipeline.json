										"tag": "input",
										"props": {
											"aria-label": "Duration",
											"value": {
												"ttArg": "duration"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
