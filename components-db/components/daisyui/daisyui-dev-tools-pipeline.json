{
	"slug": "daisyui-dev-tools-pipeline",
	"name": "CI Pipeline",
	"library": "daisyui",
	"category": "developer",
	"description": "CI pipeline stepper in the daisyUI style — Build, Test, Deploy and Verify stage nodes joined by connector rails: solid success checks behind the current stage's accent spinner arc, muted dots ahead, plus a duration caption. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"developer",
		"pipeline",
		"ci",
		"stages",
		"progress"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Deploy pipeline",
			"label": "Pipeline name",
			"maxLength": 40
		},
		{
			"name": "stage",
			"type": "enum",
			"values": [
				"Build",
				"Test",
				"Deploy",
				"Verify"
			],
			"default": "Deploy",
			"label": "Current stage"
		},
		{
			"name": "duration",
			"type": "string",
			"default": "3m 42s",
			"label": "Duration",
			"maxLength": 16
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e5e6e6",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#1f2937",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "h3",
						"children": [
							"{label}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexWrap": "wrap",
								"gap": "6px"
							}
						},
						"children": [
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"padding": "8px 12px",
										"borderRadius": "8px",
										"border": "1px solid #e5e6e6",
										"background": {
											"ttIf": {
												"arg": "stage",
												"equals": "Build",
												"then": "#570df8",
												"else": "#f2f2f2"
											}
										},
										"cursor": "pointer",
										"color": {
											"ttIf": {
												"arg": "stage",
												"equals": "Build",
												"then": "#ffffff",
												"else": "#1f2937"
											}
										}
									},
									"aria-pressed": {
										"ttIf": {
											"arg": "stage",
											"equals": "Build",
											"then": true,
											"else": false
										}
									}
								},
								"children": [
									"Build"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "stage",
									"value": "Build"
								}
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"padding": "8px 12px",
