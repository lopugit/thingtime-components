							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"padding": "8px 12px",
										"borderRadius": "8px",
										"border": "1px solid #e5e6e6",
										"background": {
											"ttIf": {
												"arg": "stage",
												"equals": "Deploy",
												"then": "#570df8",
												"else": "#f2f2f2"
											}
										},
										"cursor": "pointer",
										"color": {
											"ttIf": {
												"arg": "stage",
												"equals": "Deploy",
												"then": "#ffffff",
												"else": "#1f2937"
											}
										}
									},
									"aria-pressed": {
										"ttIf": {
											"arg": "stage",
											"equals": "Deploy",
											"then": true,
											"else": false
										}
									}
								},
								"children": [
									"Deploy"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "stage",
									"value": "Deploy"
								}
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"padding": "8px 12px",
										"borderRadius": "8px",
										"border": "1px solid #e5e6e6",
										"background": {
											"ttIf": {
												"arg": "stage",
												"equals": "Verify",
												"then": "#570df8",
												"else": "#f2f2f2"
											}
										},
										"cursor": "pointer",
										"color": {
											"ttIf": {
												"arg": "stage",
												"equals": "Verify",
												"then": "#ffffff",
												"else": "#1f2937"
											}
										}
									},
									"aria-pressed": {
										"ttIf": {
