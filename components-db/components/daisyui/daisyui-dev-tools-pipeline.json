												"arg": "stage",
												"equals": "Test",
												"then": "#570df8",
												"else": "#f2f2f2"
											}
										},
										"cursor": "pointer",
										"color": {
											"ttIf": {
												"arg": "stage",
												"equals": "Test",
												"then": "#ffffff",
												"else": "#1f2937"
											}
										}
									},
									"aria-pressed": {
										"ttIf": {
											"arg": "stage",
											"equals": "Test",
											"then": true,
											"else": false
