{
	"slug": "daisyui-flow-node",
	"name": "Flow Node",
	"library": "daisyui",
	"category": "flow",
	"description": "Graph node card in the daisyUI style — title, mono sublabel, tone status dot, and top/bottom connection handles with an accent ring when selected. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"flow",
		"node",
		"graph",
		"handle"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Transform",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "sublabel",
			"type": "string",
			"default": "normalize()",
			"label": "Sublabel",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "selected",
			"type": "boolean",
			"default": false,
			"label": "Selected"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "10px 4px",
						"display": "inline-block"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"style": {
								"ttMerge": [
									{
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"background": "#ffffff",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#e5e6e6",
										"borderRadius": "12px",
										"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
										"boxSizing": "border-box",
										"position": "relative",
										"width": "180px",
										"padding": "10px 12px",
										"maxWidth": "100%"
									},
									{
										"ttIf": {
											"arg": "selected",
											"then": {
												"borderColor": "#570df8",
												"boxShadow": "0 0 0 1px #570df8"
											},
											"else": {}
										}
									}
								]
							},
							"type": "button",
							"aria-label": "Transform normalize()",
							"aria-pressed": {
								"ttArg": "selected"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"position": "absolute",
										"width": "10px",
										"height": "10px",
										"borderRadius": "999px",
										"background": "#570df8",
										"borderWidth": "2px",
										"borderStyle": "solid",
										"borderColor": "#ffffff",
										"boxSizing": "border-box",
										"top": "-6px",
										"left": "50%",
										"marginLeft": "-5px",
										"maxWidth": "100%"
									}
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "8px",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"width": "8px",
												"height": "8px",
												"borderRadius": "999px",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#570df8",
															"success": "#00a96e",
															"warning": "#ffbe00",
															"danger": "#ff5861",
															"info": "#00b6ff",
															"neutral": "#2a323c"
														},
														"default": "#00a96e"
													}
												},
												"flexShrink": 0,
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										}
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"flexDirection": "column",
												"gap": "2px",
												"minWidth": "0"
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontSize": "14px",
														"fontWeight": 700,
														"color": "#1f2937"
													}
												},
												"children": [
													"{label}"
												]
											},
											{
												"tag": "span",
												"props": {
													"style": {
														"fontSize": "12px",
														"color": "#6b7280",
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
													}
												},
												"children": [
													"{sublabel}"
												]
											}
										]
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"position": "absolute",
										"width": "10px",
										"height": "10px",
										"borderRadius": "999px",
										"background": "#570df8",
										"borderWidth": "2px",
										"borderStyle": "solid",
										"borderColor": "#ffffff",
										"boxSizing": "border-box",
										"bottom": "-6px",
										"left": "50%",
										"marginLeft": "-5px",
										"maxWidth": "100%"
									}
								}
							}
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "toggle",
							"key": "selected"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Selected ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Selected",
											"type": "checkbox",
											"checked": {
												"ttArg": "selected"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selected"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Sublabel ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Sublabel",
											"value": {
												"ttArg": "sublabel"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "sublabel"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "flow-node",
									"title": "Flow Node",
									"details": "Label: {label}\nSublabel: {sublabel}\nSelected: {selected}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "flow-node",
	"source": {
		"kind": "archetype",
		"archetype": "flow",
		"variant": "node",
		"tranche": 1
	}
}
