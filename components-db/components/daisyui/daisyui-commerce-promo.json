{
	"slug": "daisyui-commerce-promo",
	"name": "Promo Code Row",
	"library": "daisyui",
	"category": "commerce",
	"description": "Promo code row in the daisyUI style — dashed voucher field showing the code as an applied chip, an apply button, and a success caption that appears once the code is accepted. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"commerce",
		"promo",
		"coupon",
		"discount"
	],
	"args": [
		{
			"name": "code",
			"type": "string",
			"default": "SAVE20",
			"label": "Code",
			"maxLength": 16
		},
		{
			"name": "applied",
			"type": "boolean",
			"default": true,
			"label": "Applied"
		},
		{
			"name": "discount",
			"type": "string",
			"default": "20% off",
			"label": "Discount",
			"maxLength": 16
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save draft",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "6px",
						"width": "320px",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"flex": "1 1 auto",
										"height": "48px",
										"padding": "0 10px",
										"border": "1px dashed #e5e6e6",
										"borderRadius": "12px",
										"background": "#f2f2f2",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"ttIf": {
											"arg": "applied",
											"then": {
												"tag": "span",
												"props": {
													"style": {
														"display": "inline-flex",
														"alignItems": "center",
														"gap": "6px",
														"padding": "2px 10px",
														"borderRadius": "999px",
														"background": "#dcfce7",
														"color": "#00753d",
														"fontSize": "12px",
														"fontWeight": 700,
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
														"flexWrap": "wrap"
													}
												},
												"children": [
													{
														"tag": "svg",
														"props": {
															"width": 11,
															"height": 11,
															"viewBox": "0 0 24 24",
															"fill": "none",
															"stroke": "currentColor",
															"strokeWidth": 2,
															"strokeLinecap": "round",
															"strokeLinejoin": "round",
															"xmlns": "http://www.w3.org/2000/svg"
														},
														"children": [
															{
																"tag": "polyline",
																"props": {
																	"points": "20 6 9 17 4 12"
																}
															}
														]
													},
													"{code}"
												]
											},
											"else": {
												"tag": "span",
												"props": {
													"style": {
														"fontSize": "14px",
														"color": "#9ca3af",
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
													}
												},
												"children": [
													"{code}"
												]
											}
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"gap": "6px",
										"border": "none",
										"borderRadius": "12px",
										"fontWeight": 600,
										"cursor": "pointer",
										"height": "auto",
										"padding": "8px 12px",
										"fontSize": "14px",
										"background": "#570df8",
										"color": "#ffffff",
										"flexShrink": 0,
										"width": "auto",
										"minWidth": 0,
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									},
									"aria-label": "{actionLabel}"
								},
								"children": [
									"{actionLabel}"
								],
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "commerce-promo",
									"title": "Promo Code Row",
									"details": "Code: {code}\nApplied: {applied}\nDiscount: {discount}"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "applied",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "5px",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 12,
											"height": 12,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#00a96e",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polyline",
												"props": {
													"points": "20 6 9 17 4 12"
												}
											}
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "12px",
												"color": "#00753d"
											}
										},
										"children": [
											"{discount} applied to your order"
										]
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Code ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Code",
											"value": {
												"ttArg": "code"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "code"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Applied ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Applied",
											"type": "checkbox",
											"checked": {
												"ttArg": "applied"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "applied"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Discount ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Discount",
											"value": {
												"ttArg": "discount"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "discount"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "commerce-promo",
									"title": "Promo Code Row",
									"details": "Code: {code}\nApplied: {applied}\nDiscount: {discount}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			},
			{
				"tag": "small",
				"children": [
					"Draft only. Saving creates a private Thing. External effects require a configured Action."
				]
			}
		]
	},
	"version": 2,
	"familyKey": "commerce-promo",
	"source": {
		"kind": "archetype",
		"archetype": "commerce",
		"variant": "promo",
		"tranche": 2
	}
}
