{
	"slug": "daisyui-code-block-diff",
	"name": "Diff Viewer",
	"library": "daisyui",
	"category": "data-display",
	"description": "Diff viewer in the daisyUI style — hunk header plus removed and added lines washed in the library's danger and success tints, with +/− counters in the file bar. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"code",
		"diff",
		"review",
		"changes"
	],
	"args": [
		{
			"name": "filename",
			"type": "string",
			"default": "src/utils/total.ts",
			"label": "Filename",
			"maxLength": 60
		},
		{
			"name": "removed",
			"type": "string",
			"default": "var total = items.length",
			"label": "Removed line",
			"maxLength": 60
		},
		{
			"name": "added",
			"type": "string",
			"default": "const total = items.reduce(sum, 0)",
			"label": "Added line",
			"maxLength": 60
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "code",
			"type": "text",
			"default": "const greeting = \"Hello, Thingtime\";",
			"maxLength": 1000
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e5e6e6",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#1f2937",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "pre",
						"props": {
							"style": {
								"whiteSpace": "pre-wrap",
								"overflowWrap": "anywhere"
							}
						},
						"children": [
							{
								"tag": "code",
								"children": [
									"{code}"
								]
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "8px",
								"border": "1px solid #e5e6e6",
								"background": "#f2f2f2",
								"cursor": "pointer"
							}
						},
						"children": [
							"Copy code"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "copy",
							"value": "{code}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Filename ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Filename",
											"value": {
												"ttArg": "filename"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "filename"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Removed line ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Removed line",
											"value": {
												"ttArg": "removed"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "removed"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Added line ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Added line",
											"value": {
												"ttArg": "added"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "added"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"code ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "code",
											"value": {
												"ttArg": "code"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "code"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "code-block-diff",
									"title": "Diff Viewer",
									"details": "Filename: {filename}\nRemoved line: {removed}\nAdded line: {added}\ncode: {code}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "code-block-diff",
	"source": {
		"kind": "archetype",
		"archetype": "code-block",
		"variant": "diff",
		"tranche": 2
	}
}
