{
	"slug": "daisyui-loading-loading-button",
	"name": "Loading Button",
	"library": "daisyui",
	"category": "feedback",
	"description": "Busy-state button in the daisyUI style — an inline arc spinner beside the label, in solid or quiet tinted form. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"loading",
		"button",
		"spinner",
		"busy"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Saving…",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "quiet",
			"type": "boolean",
			"default": false,
			"label": "Quiet (tinted)"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"borderRadius": "12px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 600,
								"cursor": "wait",
								"opacity": 0.9,
								"flexWrap": "wrap"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"height": "32px",
											"padding": "0 12px",
											"fontSize": "14px"
										},
										"md": {
											"height": "48px",
											"padding": "0 16px",
											"fontSize": "14px"
										},
										"lg": {
											"height": "56px",
											"padding": "0 20px",
											"fontSize": "18px"
										}
									},
									"default": {
										"height": "48px",
										"padding": "0 16px",
										"fontSize": "14px"
									}
								}
							},
							{
								"background": {
									"ttIf": {
										"arg": "quiet",
										"then": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#eee6ff",
													"success": "#dcfce7",
													"warning": "#fef9c3",
													"danger": "#ffe4e6",
													"info": "#e0f2fe",
													"neutral": "#f2f2f2"
												},
												"default": "#eee6ff"
											}
										},
										"else": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#570df8",
													"success": "#00a96e",
													"warning": "#ffbe00",
													"danger": "#ff5861",
													"info": "#00b6ff",
													"neutral": "#2a323c"
												},
												"default": "#570df8"
											}
										}
									}
								},
								"color": {
									"ttIf": {
										"arg": "quiet",
										"then": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#4506cb",
													"success": "#00753d",
													"warning": "#854d0e",
													"danger": "#be123c",
													"info": "#0369a1",
													"neutral": "#2a323c"
												},
												"default": "#4506cb"
											}
										},
										"else": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#382800",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									}
								},
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 16,
							"height": 16,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "circle",
								"props": {
									"cx": 12,
									"cy": 12,
									"r": 10,
									"stroke": "currentColor",
									"strokeWidth": 3,
									"style": {
										"opacity": 0.3
									}
								}
							},
							{
								"tag": "path",
								"props": {
									"d": "M12 2a10 10 0 1 1-10 10",
									"stroke": "currentColor",
									"strokeWidth": 3,
									"strokeLinecap": "round"
								}
							}
						]
					},
					"{label}"
				],
				"ttAction": "$ui",
				"ttActionInputs": {
					"op": "toggle",
					"key": "quiet"
				}
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Quiet (tinted) ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Quiet (tinted)",
											"type": "checkbox",
											"checked": {
												"ttArg": "quiet"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "quiet"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "loading-loading-button",
									"title": "Loading Button",
									"details": "Label: {label}\nQuiet (tinted): {quiet}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "loading-loading-button",
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "loading-button",
		"tranche": 1
	}
}
