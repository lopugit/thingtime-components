{
	"slug": "daisyui-forms-advanced-tag-input",
	"name": "Tag Input",
	"library": "daisyui",
	"category": "forms",
	"description": "Token field in the daisyUI style — three removable tag chips in the tone wash, an inline text-cursor mock, and a press-Enter helper caption. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"tags",
		"tokens",
		"chips"
	],
	"args": [
		{
			"name": "tag1",
			"type": "string",
			"default": "react",
			"label": "First tag",
			"maxLength": 20
		},
		{
			"name": "tag2",
			"type": "string",
			"default": "design",
			"label": "Second tag",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "caret",
			"type": "boolean",
			"default": true,
			"label": "Cursor"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e5e6e6",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#1f2937",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"tag1",
							{
								"tag": "input",
								"props": {
									"type": "text",
									"aria-label": "tag1",
									"value": {
										"ttArg": "tag1"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #e5e6e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "tag1"
								}
							}
						]
					},
					{
						"tag": "label",
						"children": [
							"tag2",
							{
								"tag": "input",
								"props": {
									"type": "text",
									"aria-label": "tag2",
									"value": {
										"ttArg": "tag2"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #e5e6e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "tag2"
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"First tag ",
									{
										"tag": "input",
										"props": {
											"aria-label": "First tag",
											"value": {
												"ttArg": "tag1"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tag1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Second tag ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Second tag",
											"value": {
												"ttArg": "tag2"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tag2"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Cursor ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Cursor",
											"type": "checkbox",
											"checked": {
												"ttArg": "caret"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "caret"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "forms-advanced-tag-input",
									"title": "Tag Input",
									"details": "First tag: {tag1}\nSecond tag: {tag2}\nCursor: {caret}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "forms-advanced-tag-input",
	"source": {
		"kind": "archetype",
		"archetype": "forms-advanced",
		"variant": "tag-input",
		"tranche": 2
	}
}
