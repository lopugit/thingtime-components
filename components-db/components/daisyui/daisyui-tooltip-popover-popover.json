{
	"slug": "daisyui-tooltip-popover-popover",
	"name": "Popover",
	"library": "daisyui",
	"category": "overlays",
	"description": "Titled popover in the daisyUI style — elevated surface card anchored below its trigger with an arrow caret, heading, body copy, and an optional tone action button. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"popover",
		"overlay",
		"card",
		"anchored"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Share this view",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "body",
			"type": "text",
			"default": "Anyone with the link can see live updates. Manage access anytime from settings.",
			"label": "Body",
			"maxLength": 500
		},
		{
			"name": "triggerLabel",
			"type": "string",
			"default": "Share",
			"label": "Trigger label",
			"maxLength": 24
		},
		{
			"name": "showAction",
			"type": "boolean",
			"default": true,
			"label": "Show action"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "details",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e5e6e6",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#1f2937",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "summary",
						"children": [
							"{triggerLabel}"
						]
					},
					{
						"tag": "section",
						"children": [
							{
								"tag": "h3",
								"children": [
									"{title}"
								]
							},
							{
								"tag": "p",
								"children": [
									"{body}"
								]
							},
							{
								"tag": "nav",
								"children": [
									{
										"tag": "a",
										"props": {
											"href": "/things"
										},
										"children": [
											"Open Things"
										]
									},
									" · ",
									{
										"tag": "a",
										"props": {
											"href": "/builder"
										},
										"children": [
											"Open builder"
										]
									}
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 50,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Body ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Body",
											"value": {
												"ttArg": "body"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "body"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Trigger label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Trigger label",
											"value": {
												"ttArg": "triggerLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "triggerLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show action ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show action",
											"type": "checkbox",
											"checked": {
												"ttArg": "showAction"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "showAction"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "tooltip-popover-popover",
									"title": "Popover",
									"details": "Title: {title}\nBody: {body}\nTrigger label: {triggerLabel}\nShow action: {showAction}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f2f2f2",
	"version": 2,
	"familyKey": "tooltip-popover-popover",
	"source": {
		"kind": "archetype",
		"archetype": "tooltip-popover",
		"variant": "popover",
		"tranche": 1
	}
}
