{
	"slug": "daisyui-avatar-initials",
	"name": "Initials Avatar",
	"library": "daisyui",
	"category": "data-display",
	"description": "Circular initials avatar in the daisyUI style — tone-filled disc with library type, optional soft tint and a surface-offset ring. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"avatar",
		"initials",
		"profile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "NF",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		},
		{
			"name": "ring",
			"type": "boolean",
			"default": false,
			"label": "Ring"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 700,
								"borderRadius": "999px",
								"flexShrink": 0,
								"userSelect": "none",
								"flexWrap": "wrap"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"width": "28px",
											"height": "28px",
											"fontSize": "12px"
										},
										"md": {
											"width": "40px",
											"height": "40px",
											"fontSize": "14px"
										},
										"lg": {
											"width": "56px",
											"height": "56px",
											"fontSize": "18px"
										}
									},
									"default": {
										"width": "40px",
										"height": "40px",
										"fontSize": "14px"
									}
								}
							},
							{
								"ttIf": {
									"arg": "soft",
									"then": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#eee6ff",
													"success": "#dcfce7",
													"warning": "#fef9c3",
													"danger": "#ffe4e6",
													"info": "#e0f2fe",
													"neutral": "#f2f2f2"
												},
												"default": "#eee6ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#4506cb",
													"success": "#00753d",
													"warning": "#854d0e",
													"danger": "#be123c",
													"info": "#0369a1",
													"neutral": "#2a323c"
												},
												"default": "#4506cb"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #d6c4fd",
													"success": "1px solid #86efac",
													"warning": "1px solid #fde047",
													"danger": "1px solid #fda4af",
													"info": "1px solid #7dd3fc",
													"neutral": "1px solid #d1d5db"
												},
												"default": "1px solid #d6c4fd"
											}
										}
									},
									"else": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#570df8",
													"success": "#00a96e",
													"warning": "#ffbe00",
													"danger": "#ff5861",
													"info": "#00b6ff",
													"neutral": "#2a323c"
												},
												"default": "#570df8"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#382800",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									}
								}
							},
							{
								"ttIf": {
									"arg": "ring",
									"then": {
										"boxShadow": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "0 0 0 2px #ffffff, 0 0 0 4px #d6c4fd",
													"success": "0 0 0 2px #ffffff, 0 0 0 4px #86efac",
													"warning": "0 0 0 2px #ffffff, 0 0 0 4px #fde047",
													"danger": "0 0 0 2px #ffffff, 0 0 0 4px #fda4af",
													"info": "0 0 0 2px #ffffff, 0 0 0 4px #7dd3fc",
													"neutral": "0 0 0 2px #ffffff, 0 0 0 4px #d1d5db"
												},
												"default": "0 0 0 2px #ffffff, 0 0 0 4px #d6c4fd"
											}
										}
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					"{initials}"
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Soft tint ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Soft tint",
											"type": "checkbox",
											"checked": {
												"ttArg": "soft"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "soft"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "avatar-initials",
									"title": "Initials Avatar",
									"details": "Initials: {initials}\nSoft tint: {soft}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "avatar-initials",
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "initials",
		"tranche": 1
	}
}
