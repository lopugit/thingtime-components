												"props": {
													"width": 11,
													"height": 11,
													"viewBox": "0 0 24 24",
													"fill": "none",
													"stroke": "currentColor",
													"strokeWidth": 2,
													"strokeLinecap": "round",
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "polygon",
														"props": {
															"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
														}
													}
												]
											},
											"Charging"
										]
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#6b7280"
							}
						},
						"children": [
							"{range} of range"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "4px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"flex": "1",
										"height": "18px",
										"borderRadius": "999px",
										"background": "#f2f2f2",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#f2f2f2",
										"overflow": "hidden",
										"boxSizing": "border-box"
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "{percent}%",
												"height": "100%",
												"borderRadius": "999px",
												"background": {
													"ttMap": {
														"arg": "percent",
														"values": {
															"0": "#ff5861",
															"1": "#ff5861",
															"2": "#ff5861",
															"3": "#ff5861",
															"4": "#ff5861",
															"5": "#ff5861",
															"6": "#ff5861",
															"7": "#ff5861",
															"8": "#ff5861",
															"9": "#ff5861",
															"10": "#ff5861",
															"11": "#ff5861",
															"12": "#ff5861",
															"13": "#ff5861",
															"14": "#ff5861",
															"15": "#ff5861"
														},
														"default": "#00a96e"
													}
												},
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										}
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "4px",
										"height": "8px",
										"borderRadius": "2px",
										"background": "#e5e6e6",
										"flexShrink": 0,
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "charging",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#6b7280"
									}
								},
								"children": [
									"Time to full {time}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
