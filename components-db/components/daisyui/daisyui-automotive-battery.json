{
	"slug": "daisyui-automotive-battery",
	"name": "EV Battery Card",
	"library": "daisyui",
	"category": "automotive",
	"description": "EV charge card in the daisyUI style — large percentage with range caption, a rounded battery bar with terminal nub that flips to danger when low, and a charging chip with time-to-full. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"automotive",
		"ev",
		"battery",
		"charge"
	],
	"args": [
		{
			"name": "percent",
			"type": "number",
			"default": 72,
			"label": "Charge %",
			"min": 0,
			"max": 100
		},
		{
			"name": "range",
			"type": "string",
			"default": "318 km",
			"label": "Range",
			"maxLength": 12
		},
		{
			"name": "charging",
			"type": "boolean",
			"default": true,
			"label": "Charging"
		},
		{
			"name": "time",
			"type": "string",
			"default": "1h 20m",
			"label": "Time to full",
			"maxLength": 12
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save draft",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
