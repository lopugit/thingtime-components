								"gap": "8px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "30px",
										"fontWeight": 700,
										"lineHeight": 1
									}
								},
								"children": [
									"{percent}%"
								]
							},
							{
								"ttIf": {
									"arg": "charging",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"display": "inline-flex",
												"alignItems": "center",
												"gap": "4px",
												"padding": "2px 8px",
												"borderRadius": "999px",
												"background": "#dcfce7",
												"color": "#00753d",
												"fontSize": "12px",
												"fontWeight": 600,
												"flexWrap": "wrap"
											}
