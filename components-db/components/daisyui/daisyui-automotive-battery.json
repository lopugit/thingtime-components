		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"width": "270px",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#e5e6e6",
						"borderRadius": "16px",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
						"color": "#1f2937",
						"overflow": "hidden",
						"boxSizing": "border-box",
						"padding": "16px",
						"gap": "10px",
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
