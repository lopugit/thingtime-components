										"tag": "input",
										"props": {
											"aria-label": "Charge %",
											"value": {
												"ttArg": "percent"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 100
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "percent"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Range ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Range",
											"value": {
												"ttArg": "range"
											},
											"maxLength": 12,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "range"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Charging ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Charging",
											"type": "checkbox",
											"checked": {
												"ttArg": "charging"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "charging"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Time to full ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Time to full",
											"value": {
												"ttArg": "time"
											},
											"maxLength": 12,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "time"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "automotive-battery",
									"title": "EV Battery Card",
									"details": "Charge %: {percent}\nRange: {range}\nCharging: {charging}\nTime to full: {time}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			},
			{
				"tag": "small",
				"children": [
					"Draft only. Saving creates a private Thing. External effects require a configured Action."
				]
			}
		]
	},
	"version": 2,
	"familyKey": "automotive-battery",
	"source": {
		"kind": "archetype",
		"archetype": "automotive",
		"variant": "battery",
		"tranche": 2
	}
}
