{
	"slug": "daisyui-code-block-terminal",
	"name": "Terminal Window",
	"library": "daisyui",
	"category": "data-display",
	"description": "Dark terminal window in the daisyUI style — traffic-light window dots, prompt lines, and a muted output line on the library's radius and shadow. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"code",
		"terminal",
		"console",
		"shell"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "zsh",
			"label": "Window title",
			"maxLength": 30
		},
		{
			"name": "command",
			"type": "string",
			"default": "npm run dev",
			"label": "Command",
			"maxLength": 60
		},
		{
			"name": "output",
			"type": "string",
			"default": "ready in 320 ms",
			"label": "Output line",
			"maxLength": 60
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "code",
			"type": "text",
			"default": "npm run dev",
			"maxLength": 1000
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e5e6e6",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#1f2937",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "pre",
						"props": {
							"style": {
								"whiteSpace": "pre-wrap",
								"overflowWrap": "anywhere"
							}
						},
						"children": [
							{
								"tag": "code",
								"children": [
									"{code}"
								]
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "8px",
								"border": "1px solid #e5e6e6",
								"background": "#f2f2f2",
								"cursor": "pointer"
							}
						},
						"children": [
							"Copy code"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "copy",
							"value": "{code}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Window title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Window title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Command ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Command",
											"value": {
												"ttArg": "command"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "command"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Output line ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Output line",
											"value": {
												"ttArg": "output"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "output"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"code ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "code",
											"value": {
												"ttArg": "code"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e5e6e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "code"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"background": "#f2f2f2",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "code-block-terminal",
									"title": "Terminal Window",
									"details": "Window title: {title}\nCommand: {command}\nOutput line: {output}\ncode: {code}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "code-block-terminal",
	"source": {
		"kind": "archetype",
		"archetype": "code-block",
		"variant": "terminal",
		"tranche": 2
	}
}
