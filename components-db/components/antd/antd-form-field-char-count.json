{
	"slug": "antd-form-field-char-count",
	"name": "Character Count Field",
	"library": "antd",
	"category": "forms",
	"description": "Labeled field with a used/limit character counter aligned bottom-right in the Ant Design style — the over-limit toggle flips border and counter to the danger tone. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"field",
		"counter",
		"limit"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Bio",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "Designer, gardener, amateur botanist",
			"label": "Value",
			"maxLength": 80
		},
		{
			"name": "chars",
			"type": "number",
			"default": 36,
			"label": "Characters used",
			"min": 0,
			"max": 999
		},
		{
			"name": "maxChars",
			"type": "number",
			"default": 120,
			"label": "Character limit",
			"min": 1,
			"max": 999
		},
		{
			"name": "overLimit",
			"type": "boolean",
			"default": false,
			"label": "Over limit"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "6px",
						"width": "280px",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.88)"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "button",
						"props": {
							"style": {
								"ttMerge": [
									{
										"height": "32px",
										"padding": "0 12px",
										"borderRadius": "6px",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#d9d9d9",
										"background": "#ffffff",
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontSize": "14px",
										"color": "rgba(0, 0, 0, 0.88)",
										"outline": "none",
										"width": "100%",
										"boxSizing": "border-box",
										"boxShadow": "none",
										"maxWidth": "100%"
									},
									{
										"display": "flex",
										"alignItems": "center",
										"overflow": "hidden",
										"whiteSpace": "nowrap",
										"borderColor": {
											"ttIf": {
												"arg": "overLimit",
												"then": "#ff4d4f",
												"else": "#d9d9d9"
											}
										},
										"flexWrap": "wrap"
									}
								]
							},
							"type": "button",
							"aria-label": "Designer, gardener, amateur botanist",
							"aria-pressed": {
								"ttArg": "overLimit"
							}
						},
						"children": [
							"{value}"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "toggle",
							"key": "overLimit"
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "flex-end",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "button",
								"props": {
									"style": {
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"fontSize": "12px",
										"color": {
											"ttIf": {
												"arg": "overLimit",
												"then": "#ff4d4f",
												"else": "rgba(0, 0, 0, 0.45)"
											}
										}
									},
									"type": "button",
									"aria-label": "36/120",
									"aria-pressed": {
										"ttArg": "overLimit"
									}
								},
								"children": [
									"{chars}/{maxChars}"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "toggle",
									"key": "overLimit"
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Over limit ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Over limit",
											"type": "checkbox",
											"checked": {
												"ttArg": "overLimit"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "overLimit"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Value ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Value",
											"value": {
												"ttArg": "value"
											},
											"maxLength": 80,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "value"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Characters used ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Characters used",
											"value": {
												"ttArg": "chars"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 999
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "chars"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Character limit ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Character limit",
											"value": {
												"ttArg": "maxChars"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 999
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "maxChars"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "form-field-char-count",
									"title": "Character Count Field",
									"details": "Label: {label}\nValue: {value}\nCharacters used: {chars}\nCharacter limit: {maxChars}\nOver limit: {overLimit}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "form-field-char-count",
	"source": {
		"kind": "archetype",
		"archetype": "form-field",
		"variant": "char-count",
		"tranche": 1
	}
}
