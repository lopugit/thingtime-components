{
	"slug": "antd-chip-basic",
	"name": "Basic Chip",
	"library": "antd",
	"category": "data-display",
	"description": "Plain tag chip in the Ant Design style — a soft tone wash by default with a filled toggle, on the library's native chip corners. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"chip",
		"tag",
		"label"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Design",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "filled",
			"type": "boolean",
			"default": false,
			"label": "Filled"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"height": "24px",
								"padding": "0 12px",
								"borderRadius": "4px",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 500,
								"fontSize": "13px",
								"flexWrap": "wrap"
							},
							{
								"ttIf": {
									"arg": "filled",
									"then": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1677ff",
													"success": "#52c41a",
													"warning": "#faad14",
													"danger": "#ff4d4f",
													"info": "#1677ff",
													"neutral": "rgba(0, 0, 0, 0.88)"
												},
												"default": "#1677ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									},
									"else": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e6f4ff",
													"success": "#f6ffed",
													"warning": "#fffbe6",
													"danger": "#fff2f0",
													"info": "#e6f4ff",
													"neutral": "#fafafa"
												},
												"default": "#e6f4ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#0958d9",
													"success": "#389e0d",
													"warning": "#d48806",
													"danger": "#cf1322",
													"info": "#0958d9",
													"neutral": "rgba(0, 0, 0, 0.65)"
												},
												"default": "#0958d9"
											}
										},
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#91caff",
													"success": "#b7eb8f",
													"warning": "#ffe58f",
													"danger": "#ffccc7",
													"info": "#91caff",
													"neutral": "#d9d9d9"
												},
												"default": "#91caff"
											}
										}
									}
								}
							}
						]
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "chip-basic",
									"title": "Basic Chip",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "chip-basic",
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "basic",
		"tranche": 1
	}
}
