{
	"slug": "antd-loading-spinner",
	"name": "Spinner",
	"library": "antd",
	"category": "feedback",
	"description": "Circular spinner in the Ant Design style — a faint svg track ring with a tone-colored three-quarter arc, plus an optional caption. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"loading",
		"spinner",
		"progress",
		"feedback"
	],
	"args": [
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "label",
			"type": "string",
			"default": "Loading…",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "showLabel",
			"type": "boolean",
			"default": true,
			"label": "Show label"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": {
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": 16,
										"md": 24,
										"lg": 32
									},
									"default": 24
								}
							},
							"height": {
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": 16,
										"md": 24,
										"lg": 32
									},
									"default": 24
								}
							},
							"viewBox": "0 0 24 24",
							"fill": "none",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "circle",
								"props": {
									"cx": 12,
									"cy": 12,
									"r": 10,
									"stroke": "#f0f0f0",
									"strokeWidth": 3
								}
							},
							{
								"tag": "path",
								"props": {
									"d": "M12 2a10 10 0 1 1-10 10",
									"stroke": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#1677ff",
												"success": "#52c41a",
												"warning": "#faad14",
												"danger": "#ff4d4f",
												"info": "#1677ff",
												"neutral": "rgba(0, 0, 0, 0.88)"
											},
											"default": "#1677ff"
										}
									},
									"strokeWidth": 3,
									"strokeLinecap": "round"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "showLabel",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "13px",
										"color": "rgba(0, 0, 0, 0.45)"
									}
								},
								"children": [
									"{label}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "loading-spinner",
									"title": "Spinner",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "loading-spinner",
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "spinner",
		"tranche": 1
	}
}
