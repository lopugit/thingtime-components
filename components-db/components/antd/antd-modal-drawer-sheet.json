{
	"slug": "antd-modal-drawer-sheet",
	"name": "Bottom Sheet",
	"library": "antd",
	"category": "overlays",
	"description": "Bottom sheet rising over a dimmed backdrop in the Ant Design style — a slim grab handle above the title, body copy, and a full-width tone action. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"sheet",
		"mobile",
		"overlay",
		"bottom"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Share this page",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "body",
			"type": "text",
			"default": "Send a link to your teammates or copy it to your clipboard.",
			"label": "Body",
			"maxLength": 200
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "tt-dialog",
				"props": {
					"title": "{title}",
					"name": "Open sheet",
					"type": "drawer"
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "grid",
								"gap": "12px",
								"padding": "16px",
								"border": "1px solid #d9d9d9",
								"borderRadius": "6px",
								"background": "#ffffff",
								"color": "rgba(0, 0, 0, 0.88)",
								"minWidth": 0,
								"maxWidth": "100%"
							}
						},
						"children": [
							{
								"tag": "p",
								"children": [
									"{body}"
								]
							},
							{
								"tag": "p",
								"children": [
									"Edit the values below and save a private draft. No external changes are made."
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Body ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Body",
											"value": {
												"ttArg": "body"
											},
											"maxLength": 200,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "body"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "modal-drawer-sheet",
									"title": "Bottom Sheet",
									"details": "Title: {title}\nBody: {body}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "modal-drawer-sheet",
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "sheet",
		"tranche": 1
	}
}
