{
	"slug": "antd-select-menu-multi",
	"name": "Multi Select",
	"library": "antd",
	"category": "forms",
	"description": "Multi-select field in the Ant Design style — chosen values sit inside the field as removable tone-tinted tag chips, with an overflow \"+n\" chip and trailing chevron. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"select",
		"multi",
		"tags",
		"chips"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Teams",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tagA",
			"type": "string",
			"default": "Design",
			"label": "First tag",
			"maxLength": 24
		},
		{
			"name": "tagB",
			"type": "string",
			"default": "Platform",
			"label": "Second tag",
			"maxLength": 24
		},
		{
			"name": "moreCount",
			"type": "number",
			"default": 2,
			"label": "Overflow count",
			"min": 0,
			"max": 99
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "selection",
			"type": "string",
			"default": ""
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #d9d9d9",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.88)",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"{label}",
							{
								"tag": "select",
								"props": {
									"value": {
										"ttArg": "selection"
									},
									"aria-label": "Select an option",
									"disabled": false
								},
								"children": [
									{
										"tag": "option",
										"props": {
											"value": ""
										},
										"children": [
											"Choose…"
										]
									},
									{
										"tag": "option",
										"props": {
											"value": "{tagA}"
										},
										"children": [
											"{tagA}"
										]
									},
									{
										"tag": "option",
										"props": {
											"value": "{tagB}"
										},
										"children": [
											"{tagB}"
										]
									}
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "selection"
								}
							}
						]
					},
					{
						"tag": "p",
						"children": [
							"Selected: {selection}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"selection ",
									{
										"tag": "input",
										"props": {
											"aria-label": "selection",
											"value": {
												"ttArg": "selection"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selection"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"First tag ",
									{
										"tag": "input",
										"props": {
											"aria-label": "First tag",
											"value": {
												"ttArg": "tagA"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tagA"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Second tag ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Second tag",
											"value": {
												"ttArg": "tagB"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tagB"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Overflow count ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Overflow count",
											"value": {
												"ttArg": "moreCount"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 99
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "moreCount"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "select-menu-multi",
									"title": "Multi Select",
									"details": "Label: {label}\nFirst tag: {tagA}\nSecond tag: {tagB}\nOverflow count: {moreCount}\nselection: {selection}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "select-menu-multi",
	"source": {
		"kind": "archetype",
		"archetype": "select-menu",
		"variant": "multi",
		"tranche": 1
	}
}
