												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "reviews"
