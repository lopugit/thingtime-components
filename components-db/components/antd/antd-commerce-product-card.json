										"children": [
											"{actionLabel}"
										],
										"ttAction": "{actionKey}",
										"ttActionInputs": {
											"family": "commerce-product-card",
											"title": "Product Card",
											"details": "Product name: {name}\nPrice: {price}\nOn sale: {onSale}\nStars (0-5): {rating}\nReview count: {reviews}"
										}
									}
								]
							}
						]
					}
				]
			},
			{
