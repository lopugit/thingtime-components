{
	"slug": "antd-commerce-product-card",
	"name": "Product Card",
	"library": "antd",
	"category": "commerce",
	"description": "Product tile in the Ant Design style — image placeholder with an optional sale pill, star rating with review count, price line and an add-to-cart action on library-native corners. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"commerce",
		"product",
		"card",
		"shop"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Aurora Headphones",
			"label": "Product name",
			"maxLength": 40
		},
		{
			"name": "price",
			"type": "string",
			"default": "$129",
			"label": "Price",
			"maxLength": 12
		},
		{
			"name": "onSale",
			"type": "boolean",
			"default": true,
			"label": "On sale"
		},
		{
			"name": "rating",
			"type": "number",
			"default": 4,
			"label": "Stars (0-5)"
		},
		{
			"name": "reviews",
			"type": "string",
			"default": "128",
			"label": "Review count",
			"maxLength": 8
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save draft",
			"maxLength": 500,
			"label": "Action label"
		}
	],
