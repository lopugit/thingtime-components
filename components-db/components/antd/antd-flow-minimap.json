{
	"slug": "antd-flow-minimap",
	"name": "Flow Minimap",
	"library": "antd",
	"category": "flow",
	"description": "Graph minimap panel in the Ant Design style — a muted surface scattered with node blocks and a tone-colored viewport rectangle overlay. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"flow",
		"minimap",
		"viewport",
		"panel"
	],
	"args": [
		{
			"name": "nodes",
			"type": "number",
			"default": 6,
			"label": "Nodes",
			"min": 0,
			"max": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "label",
			"type": "string",
			"default": "Graph overview",
			"label": "Caption",
			"maxLength": 40
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "6px",
						"width": "180px",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "relative",
								"width": "180px",
								"height": "112px",
								"background": "#fafafa",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#f0f0f0",
								"borderRadius": "6px",
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
								"padding": "10px",
								"boxSizing": "border-box",
								"display": "flex",
								"flexWrap": "wrap",
								"gap": "9px",
								"alignContent": "flex-start",
								"overflow": "hidden",
								"maxWidth": "100%"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"arg": "nodes",
									"max": 12,
									"node": {
										"tag": "span",
										"props": {
											"style": {
												"width": "24px",
												"height": "13px",
												"borderRadius": "4px",
												"background": "#ffffff",
												"borderWidth": "1px",
												"borderStyle": "solid",
												"borderColor": "rgba(0, 0, 0, 0.25)",
												"boxSizing": "border-box",
												"maxWidth": "100%"
											}
										}
									}
								}
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"position": "absolute",
										"left": "28%",
										"top": "20%",
										"width": "46%",
										"height": "52%",
										"borderWidth": "2px",
										"borderStyle": "solid",
										"borderColor": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1677ff",
													"success": "#52c41a",
													"warning": "#faad14",
													"danger": "#ff4d4f",
													"info": "#1677ff",
													"neutral": "rgba(0, 0, 0, 0.88)"
												},
												"default": "#1677ff"
											}
										},
										"borderRadius": "4px",
										"boxSizing": "border-box",
										"maxWidth": "100%"
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.45)"
							}
						},
						"children": [
							"{label}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Nodes ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Nodes",
											"value": {
												"ttArg": "nodes"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 12
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "nodes"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Caption ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Caption",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "flow-minimap",
									"title": "Flow Minimap",
									"details": "Nodes: {nodes}\nCaption: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "flow-minimap",
	"source": {
		"kind": "archetype",
		"archetype": "flow",
		"variant": "minimap",
		"tranche": 1
	}
}
