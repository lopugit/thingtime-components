{
	"slug": "antd-button-solid",
	"name": "Solid Button",
	"library": "antd",
	"category": "buttons",
	"description": "Filled primary action button in the Ant Design style — solid tone background, library-native radius and type. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"button",
		"action",
		"solid"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Get started",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"borderRadius": "6px",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 400,
								"cursor": "pointer",
								"flexWrap": "wrap"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"height": "24px",
											"padding": "0 12px",
											"fontSize": "13px"
										},
										"md": {
											"height": "32px",
											"padding": "0 16px",
											"fontSize": "14px"
										},
										"lg": {
											"height": "40px",
											"padding": "0 20px",
											"fontSize": "16px"
										}
									},
									"default": {
										"height": "32px",
										"padding": "0 16px",
										"fontSize": "14px"
									}
								}
							},
							{
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1677ff",
											"success": "#52c41a",
											"warning": "#faad14",
											"danger": "#ff4d4f",
											"info": "#1677ff",
											"neutral": "rgba(0, 0, 0, 0.88)"
										},
										"default": "#1677ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)"
							},
							{
								"ttIf": {
									"arg": "disabled",
									"then": {
										"opacity": 0.5,
										"cursor": "not-allowed"
									},
									"else": {}
								}
							},
							{
								"width": "auto",
								"height": "auto",
								"minWidth": 0,
								"padding": "8px 12px",
								"whiteSpace": "normal",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							}
						]
					},
					"disabled": {
						"ttArg": "disabled"
					},
					"aria-label": "{actionLabel}"
				},
				"children": [
					"{actionLabel}"
				],
				"ttAction": "{actionKey}",
				"ttActionInputs": {
					"family": "button-solid",
					"title": "Solid Button",
					"details": "Label: {label}"
				}
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "button-solid",
									"title": "Solid Button",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "button-solid",
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "solid",
		"tranche": 1
	}
}
