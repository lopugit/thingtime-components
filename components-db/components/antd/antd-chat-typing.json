{
	"slug": "antd-chat-typing",
	"name": "Typing Indicator",
	"library": "antd",
	"category": "messaging",
	"description": "Incoming typing indicator in the Ant Design style — an initials avatar beside a quiet bubble holding three muted dots, with a name-is-typing caption underneath. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"chat",
		"typing",
		"indicator",
		"presence"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex",
			"label": "Name",
			"maxLength": 24
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AX",
			"label": "Avatar initials",
			"maxLength": 3
		},
		{
			"name": "showAvatar",
			"type": "boolean",
			"default": true,
			"label": "Show avatar"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save draft",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "flex-end",
						"gap": "8px",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "showAvatar",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"width": "28px",
										"height": "28px",
										"borderRadius": "999px",
										"background": "#fafafa",
										"color": "rgba(0, 0, 0, 0.65)",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontWeight": 600,
										"fontSize": "12px",
										"flexShrink": 0,
										"maxWidth": "100%",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									}
								},
								"children": [
									"{initials}"
								]
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "4px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"padding": "11px 12px",
										"maxWidth": "100%",
										"fontSize": "14px",
										"lineHeight": 1.45,
										"background": "#fafafa",
										"color": "rgba(0, 0, 0, 0.88)",
										"borderRadius": "6px 6px 6px 4px",
										"display": "inline-flex",
										"alignItems": "center",
										"gap": "4px",
										"width": "fit-content",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"ttRepeat": {
											"count": 3,
											"max": 3,
											"node": {
												"tag": "span",
												"props": {
													"style": {
														"width": "7px",
														"height": "7px",
														"borderRadius": "999px",
														"background": "rgba(0, 0, 0, 0.25)",
														"maxWidth": "100%",
														"boxSizing": "border-box"
													}
												}
											}
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "rgba(0, 0, 0, 0.45)"
									}
								},
								"children": [
									"{name} is typing…"
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Name",
											"value": {
												"ttArg": "name"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "name"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Avatar initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Avatar initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show avatar ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show avatar",
											"type": "checkbox",
											"checked": {
												"ttArg": "showAvatar"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "showAvatar"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "chat-typing",
									"title": "Typing Indicator",
									"details": "Name: {name}\nAvatar initials: {initials}\nShow avatar: {showAvatar}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			},
			{
				"tag": "small",
				"children": [
					"Draft only. Saving creates a private Thing. External effects require a configured Action."
				]
			}
		]
	},
	"version": 2,
	"familyKey": "chat-typing",
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "typing",
		"tranche": 2
	}
}
