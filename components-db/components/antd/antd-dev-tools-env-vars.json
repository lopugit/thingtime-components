{
	"slug": "antd-dev-tools-env-vars",
	"name": "Environment Variables",
	"library": "antd",
	"category": "developer",
	"description": "Environment-variable rows in the Ant Design style — monospace KEY names with masked dot values (the first revealable), Production and Preview scope chips, quiet copy ghosts, and a dashed add-variable row. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"developer",
		"env",
		"secrets",
		"settings",
		"config"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "DATABASE_URL",
			"label": "Variable name",
			"maxLength": 32
		},
		{
			"name": "value",
			"type": "string",
			"default": "postgres://cluster-syd.internal:5432/app",
			"label": "Value",
			"maxLength": 60
		},
		{
			"name": "revealed",
			"type": "boolean",
			"default": true,
			"label": "Reveal first value"
		},
		{
			"name": "scope",
			"type": "enum",
			"values": [
				"Production",
				"Preview"
			],
			"default": "Production",
			"label": "First row scope"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #d9d9d9",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.88)",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "h3",
						"children": [
							"{name}"
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"aria-label": "value",
							"value": {
								"ttArg": "value"
							},
							"style": {
								"width": "100%",
								"minWidth": 0,
								"padding": "8px",
								"border": "1px solid #d9d9d9",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							}
						},
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "value"
						}
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "6px",
								"border": "1px solid #d9d9d9",
								"background": "#fafafa",
								"cursor": "pointer"
							}
						},
						"children": [
							"Copy value"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "copy",
							"value": "{value}"
						}
					},
					{
						"tag": "small",
						"children": [
							"Value is local only and excluded from saved records. Configure real credentials through connection settings."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Variable name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Variable name",
											"value": {
												"ttArg": "name"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "name"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Reveal first value ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Reveal first value",
											"type": "checkbox",
											"checked": {
												"ttArg": "revealed"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "revealed"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"First row scope ",
									{
										"tag": "select",
										"props": {
											"aria-label": "First row scope",
											"value": {
												"ttArg": "scope"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "Production"
												},
												"children": [
													"Production"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "Preview"
												},
												"children": [
													"Preview"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "scope"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "dev-tools-env-vars",
									"title": "Environment Variables",
									"details": "Variable name: {name}\nReveal first value: {revealed}\nFirst row scope: {scope}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "dev-tools-env-vars",
	"source": {
		"kind": "archetype",
		"archetype": "dev-tools",
		"variant": "env-vars",
		"tranche": 2
	}
}
