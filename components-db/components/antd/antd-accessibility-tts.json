{
	"slug": "antd-accessibility-tts",
	"name": "Text-to-Speech Bar",
	"library": "antd",
	"category": "accessibility",
	"description": "Text-to-speech bar in the Ant Design style — accent play/pause circle beside the current sentence with a highlighted spoken word, a mono speed chip, a voice select mock, and a progress hairline. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"accessibility",
		"tts",
		"speech",
		"audio",
		"player"
	],
	"args": [
		{
			"name": "playing",
			"type": "boolean",
			"default": true,
			"label": "Playing"
		},
		{
			"name": "word",
			"type": "string",
			"default": "gently",
			"label": "Highlighted word",
			"maxLength": 16
		},
		{
			"name": "speed",
			"type": "number",
			"default": 1.5,
			"label": "Speed"
		},
		{
			"name": "voice",
			"type": "string",
			"default": "Samantha",
			"label": "Voice",
			"maxLength": 16
		},
		{
			"name": "progress",
			"type": "number",
			"default": 40,
			"label": "Progress %"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#f0f0f0",
						"borderRadius": "8px",
						"boxShadow": "0 6px 16px 0 rgba(0, 0, 0, 0.08), 0 3px 6px -4px rgba(0, 0, 0, 0.12)",
						"color": "rgba(0, 0, 0, 0.88)",
						"boxSizing": "border-box",
						"width": "290px",
						"padding": "12px",
						"gap": "10px",
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "flex-start",
								"gap": "10px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"width": "auto",
										"height": "auto",
										"borderRadius": "999px",
										"border": "none",
										"background": "#1677ff",
										"color": "#ffffff",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"flexShrink": 0,
										"cursor": "pointer",
										"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
										"maxWidth": "100%",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									},
									"aria-label": "{actionLabel}"
								},
								"children": [
									"{actionLabel}"
								],
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "accessibility-tts",
									"title": "Text-to-Speech Bar",
									"details": "Playing: {playing}\nHighlighted word: {word}\nSpeed: {speed}\nVoice: {voice}\nProgress %: {progress}"
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "8px",
										"flexGrow": 1,
										"minWidth": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"fontSize": "13px",
												"color": "rgba(0, 0, 0, 0.45)",
												"lineHeight": 1.5
											}
										},
										"children": [
											"Each word is spoken ",
											{
												"tag": "span",
												"props": {
													"style": {
														"background": "#e6f4ff",
														"color": "#0958d9",
														"borderRadius": "4px",
														"padding": "0 4px",
														"fontWeight": 600
													}
												},
												"children": [
													"{word}"
												]
											},
											" as the narration moves."
										]
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"gap": "6px",
												"flexWrap": "wrap"
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
														"fontSize": "12px",
														"fontWeight": 600,
														"color": "rgba(0, 0, 0, 0.88)",
														"background": "#fafafa",
														"borderRadius": "999px",
														"padding": "2px 8px"
													}
												},
												"children": [
													"{speed}×"
												]
											},
											{
												"tag": "div",
												"props": {
													"style": {
														"display": "inline-flex",
														"alignItems": "center",
														"gap": "6px",
														"padding": "2px 8px",
														"background": "#ffffff",
														"borderWidth": "1px",
														"borderStyle": "solid",
														"borderColor": "#d9d9d9",
														"borderRadius": "4px",
														"fontSize": "12px",
														"color": "rgba(0, 0, 0, 0.88)",
														"flexWrap": "wrap"
													}
												},
												"children": [
													"{voice}",
													{
														"tag": "svg",
														"props": {
															"width": 12,
															"height": 12,
															"viewBox": "0 0 24 24",
															"fill": "none",
															"stroke": "rgba(0, 0, 0, 0.45)",
															"strokeWidth": 2,
															"strokeLinecap": "round",
															"strokeLinejoin": "round",
															"xmlns": "http://www.w3.org/2000/svg"
														},
														"children": [
															{
																"tag": "polyline",
																"props": {
																	"points": "6 9 12 15 18 9"
																}
															}
														]
													}
												]
											}
										]
									}
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"height": "3px",
								"borderRadius": "999px",
								"background": "#f0f0f0",
								"overflow": "hidden"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"height": "3px",
										"width": "{progress}%",
										"borderRadius": "999px",
										"background": "#1677ff",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Playing ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Playing",
											"type": "checkbox",
											"checked": {
												"ttArg": "playing"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "playing"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Highlighted word ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Highlighted word",
											"value": {
												"ttArg": "word"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "word"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Speed ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Speed",
											"value": {
												"ttArg": "speed"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "speed"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Voice ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Voice",
											"value": {
												"ttArg": "voice"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "voice"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Progress % ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Progress %",
											"value": {
												"ttArg": "progress"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #d9d9d9",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "progress"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #d9d9d9",
										"borderRadius": "6px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "accessibility-tts",
									"title": "Text-to-Speech Bar",
									"details": "Playing: {playing}\nHighlighted word: {word}\nSpeed: {speed}\nVoice: {voice}\nProgress %: {progress}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "accessibility-tts",
	"source": {
		"kind": "archetype",
		"archetype": "accessibility",
		"variant": "tts",
		"tranche": 2
	}
}
