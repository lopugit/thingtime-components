{
	"slug": "antd-select-menu-combobox",
	"name": "Combobox",
	"library": "antd",
	"category": "forms",
	"description": "Type-ahead combobox in the Ant Design style — search icon, typed query with a live caret bar, and a filtered result list whose active row wears the primary wash. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"combobox",
		"search",
		"autocomplete"
	],
	"args": [
		{
			"name": "query",
			"type": "string",
			"default": "Gre",
			"label": "Query",
			"maxLength": 30
		},
		{
			"name": "resultA",
			"type": "string",
			"default": "Green",
			"label": "Result A",
			"maxLength": 30
		},
		{
			"name": "resultB",
			"type": "string",
			"default": "Greenhouse",
			"label": "Result B",
			"maxLength": 30
		},
		{
			"name": "resultC",
			"type": "string",
			"default": "Grenadine",
			"label": "Result C",
			"maxLength": 30
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3"
			],
			"default": "1",
			"label": "Active result"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "selection",
			"type": "string",
			"default": ""
		}
	],
