				"children": [
					{
						"tag": "label",
						"children": [
							"Select an option",
							{
								"tag": "select",
								"props": {
									"value": {
										"ttArg": "selection"
									},
									"aria-label": "Select an option",
									"disabled": false
								},
								"children": [
									{
										"tag": "option",
										"props": {
											"value": ""
										},
										"children": [
											"Choose…"
										]
									},
									{
										"tag": "option",
										"props": {
											"value": "{resultA}"
										},
										"children": [
