{
	"slug": "bootstrap-slider-progress-range",
	"name": "Range Slider",
	"library": "bootstrap",
	"category": "forms",
	"description": "Dual-thumb range slider in the Bootstrap style — the tone-colored fill spans from the low to the high value, with optional end labels. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"slider",
		"range",
		"input",
		"dual"
	],
	"args": [
		{
			"name": "low",
			"type": "number",
			"default": 25,
			"label": "Low",
			"min": 0,
			"max": 100
		},
		{
			"name": "high",
			"type": "number",
			"default": 75,
			"label": "High",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showValues",
			"type": "boolean",
			"default": true,
			"label": "Show values"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #dee2e6",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "#212529",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"low: {low}%",
							{
								"tag": "input",
								"props": {
									"type": "range",
									"aria-label": "low",
									"value": {
										"ttArg": "low"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #dee2e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"min": 0,
									"max": 100,
									"step": 1
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "low"
								}
							}
						]
					},
					{
						"tag": "label",
						"children": [
							"high: {high}%",
							{
								"tag": "input",
								"props": {
									"type": "range",
									"aria-label": "high",
									"value": {
										"ttArg": "high"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #dee2e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"min": 0,
									"max": 100,
									"step": 1
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "high"
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Low ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Low",
											"value": {
												"ttArg": "low"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 100
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "low"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"High ",
									{
										"tag": "input",
										"props": {
											"aria-label": "High",
											"value": {
												"ttArg": "high"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 100
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "high"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show values ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show values",
											"type": "checkbox",
											"checked": {
												"ttArg": "showValues"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "showValues"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "slider-progress-range",
									"title": "Range Slider",
									"details": "Low: {low}\nHigh: {high}\nShow values: {showValues}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "slider-progress-range",
	"source": {
		"kind": "archetype",
		"archetype": "slider-progress",
		"variant": "range",
		"tranche": 1
	}
}
