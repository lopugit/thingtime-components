{
	"slug": "bootstrap-tooltip-popover-tooltip",
	"name": "Tooltip",
	"library": "bootstrap",
	"category": "overlays",
	"description": "Dark tooltip bubble in the Bootstrap style — inverse ink pill anchored above or below its trigger, with a CSS-triangle arrow pointing at the control. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"tooltip",
		"overlay",
		"hint",
		"arrow"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Copied to clipboard",
			"label": "Tooltip text",
			"maxLength": 60
		},
		{
			"name": "triggerLabel",
			"type": "string",
			"default": "Hover me",
			"label": "Trigger label",
			"maxLength": 24
		},
		{
			"name": "placement",
			"type": "enum",
			"values": [
				"top",
				"bottom"
			],
			"default": "top",
			"label": "Placement"
		},
		{
			"name": "showArrow",
			"type": "boolean",
			"default": true,
			"label": "Show arrow"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "details",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #dee2e6",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "#212529",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "summary",
						"children": [
							"{triggerLabel}"
						]
					},
					{
						"tag": "section",
						"children": [
							{
								"tag": "p",
								"children": [
									"{label}"
								]
							},
							{
								"tag": "nav",
								"children": [
									{
										"tag": "a",
										"props": {
											"href": "/things"
										},
										"children": [
											"Open Things"
										]
									},
									" · ",
									{
										"tag": "a",
										"props": {
											"href": "/builder"
										},
										"children": [
											"Open builder"
										]
									}
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Tooltip text ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Tooltip text",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Trigger label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Trigger label",
											"value": {
												"ttArg": "triggerLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "triggerLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Placement ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Placement",
											"value": {
												"ttArg": "placement"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "top"
												},
												"children": [
													"top"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "bottom"
												},
												"children": [
													"bottom"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "placement"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show arrow ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show arrow",
											"type": "checkbox",
											"checked": {
												"ttArg": "showArrow"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "showArrow"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "tooltip-popover-tooltip",
									"title": "Tooltip",
									"details": "Tooltip text: {label}\nTrigger label: {triggerLabel}\nPlacement: {placement}\nShow arrow: {showArrow}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "tooltip-popover-tooltip",
	"source": {
		"kind": "archetype",
		"archetype": "tooltip-popover",
		"variant": "tooltip",
		"tranche": 1
	}
}
