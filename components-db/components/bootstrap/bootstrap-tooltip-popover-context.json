{
	"slug": "bootstrap-tooltip-popover-context",
	"name": "Context Menu",
	"library": "bootstrap",
	"category": "overlays",
	"description": "Right-click context menu in the Bootstrap style — edit commands with kbd-style shortcut chips, a separator, and a danger row, all on one elevated panel. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"context-menu",
		"menu",
		"overlay",
		"shortcuts"
	],
	"args": [
		{
			"name": "showShortcuts",
			"type": "boolean",
			"default": true,
			"label": "Show shortcuts"
		},
		{
			"name": "dangerLabel",
			"type": "string",
			"default": "Move to Trash",
			"label": "Danger label",
			"maxLength": 32
		},
		{
			"name": "showDanger",
			"type": "boolean",
			"default": true,
			"label": "Show danger row"
		},
		{
			"name": "dense",
			"type": "boolean",
			"default": false,
			"label": "Dense rows"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "details",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #dee2e6",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "#212529",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "summary",
						"children": [
							"Options"
						]
					},
					{
						"tag": "section",
						"children": [
							{
								"tag": "nav",
								"children": [
									{
										"tag": "a",
										"props": {
											"href": "/things"
										},
										"children": [
											"Open Things"
										]
									},
									" · ",
									{
										"tag": "a",
										"props": {
											"href": "/builder"
										},
										"children": [
											"Open builder"
										]
									}
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Show shortcuts ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show shortcuts",
											"type": "checkbox",
											"checked": {
												"ttArg": "showShortcuts"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "showShortcuts"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Danger label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Danger label",
											"value": {
												"ttArg": "dangerLabel"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "dangerLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show danger row ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show danger row",
											"type": "checkbox",
											"checked": {
												"ttArg": "showDanger"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "showDanger"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "tooltip-popover-context",
									"title": "Context Menu",
									"details": "Show shortcuts: {showShortcuts}\nDanger label: {dangerLabel}\nShow danger row: {showDanger}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f8f9fa",
	"version": 2,
	"familyKey": "tooltip-popover-context",
	"source": {
		"kind": "archetype",
		"archetype": "tooltip-popover",
		"variant": "context",
		"tranche": 1
	}
}
