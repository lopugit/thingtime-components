{
	"slug": "bootstrap-navbar-sidebar",
	"name": "Sidebar Nav",
	"library": "bootstrap",
	"category": "navigation",
	"description": "Vertical sidebar rail in the Bootstrap style — brand header, icon-and-label rows with a tone-tinted active item, and a settings footer. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"sidebar",
		"navigation",
		"rail",
		"menu"
	],
	"args": [
		{
			"name": "brand",
			"type": "string",
			"default": "Acme",
			"label": "Brand",
			"maxLength": 24
		},
		{
			"name": "item1",
			"type": "string",
			"default": "Home",
			"label": "Item 1",
			"maxLength": 24
		},
		{
			"name": "item2",
			"type": "string",
			"default": "Projects",
			"label": "Item 2",
			"maxLength": 24
		},
		{
			"name": "item3",
			"type": "string",
			"default": "Messages",
			"label": "Item 3",
			"maxLength": 24
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3"
			],
			"default": "1",
			"label": "Active item"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "nav",
				"props": {
					"style": {
						"display": "flex",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #dee2e6",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "#212529",
						"minWidth": 0,
						"maxWidth": "100%",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "strong",
						"children": [
							"{brand}"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Home"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/things",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Things"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/components",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Components"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/builder/demos",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Demos"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Brand ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Brand",
											"value": {
												"ttArg": "brand"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "brand"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Item 1 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Item 1",
											"value": {
												"ttArg": "item1"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "item1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Item 2 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Item 2",
											"value": {
												"ttArg": "item2"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "item2"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Item 3 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Item 3",
											"value": {
												"ttArg": "item3"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "item3"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Active item ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Active item",
											"value": {
												"ttArg": "active"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "1"
												},
												"children": [
													"1"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "2"
												},
												"children": [
													"2"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "3"
												},
												"children": [
													"3"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "active"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "navbar-sidebar",
									"title": "Sidebar Nav",
									"details": "Brand: {brand}\nItem 1: {item1}\nItem 2: {item2}\nItem 3: {item3}\nActive item: {active}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "navbar-sidebar",
	"source": {
		"kind": "archetype",
		"archetype": "navbar",
		"variant": "sidebar",
		"tranche": 1
	}
}
