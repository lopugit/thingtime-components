{
	"slug": "bootstrap-chip-basic",
	"name": "Basic Chip",
	"library": "bootstrap",
	"category": "data-display",
	"description": "Plain tag chip in the Bootstrap style — a soft tone wash by default with a filled toggle, on the library's native chip corners. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"chip",
		"tag",
		"label"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Design",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "filled",
			"type": "boolean",
			"default": false,
			"label": "Filled"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"height": "31px",
								"padding": "0 12px",
								"borderRadius": "50rem",
								"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 500,
								"fontSize": "14px",
								"flexWrap": "wrap"
							},
							{
								"ttIf": {
									"arg": "filled",
									"then": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#0d6efd",
													"success": "#198754",
													"warning": "#ffc107",
													"danger": "#dc3545",
													"info": "#0dcaf0",
													"neutral": "#6c757d"
												},
												"default": "#0d6efd"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#000000",
													"danger": "#ffffff",
													"info": "#000000",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									},
									"else": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#cfe2ff",
													"success": "#d1e7dd",
													"warning": "#fff3cd",
													"danger": "#f8d7da",
													"info": "#cff4fc",
													"neutral": "#e9ecef"
												},
												"default": "#cfe2ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#052c65",
													"success": "#0a3622",
													"warning": "#664d03",
													"danger": "#58151c",
													"info": "#055160",
													"neutral": "#495057"
												},
												"default": "#052c65"
											}
										}
									}
								}
							}
						]
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "chip-basic",
									"title": "Basic Chip",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "chip-basic",
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "basic",
		"tranche": 1
	}
}
