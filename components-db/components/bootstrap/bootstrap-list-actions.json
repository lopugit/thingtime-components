{
	"slug": "bootstrap-list-actions",
	"name": "Actions List",
	"library": "bootstrap",
	"category": "data-display",
	"description": "List rows with a trailing action button in the Bootstrap style — pick the row glyph (edit, trash, or overflow dots) and the tint it sits on. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"list",
		"actions",
		"buttons",
		"data"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "Quarterly report",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Rows",
			"min": 1,
			"max": 6
		},
		{
			"name": "action",
			"type": "enum",
			"values": [
				"edit",
				"trash",
				"dots"
			],
			"default": "edit",
			"label": "Action"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "ul",
				"props": {
					"style": {
						"ttMerge": [
							{
								"listStyle": "none",
								"margin": 0,
								"padding": 0,
								"width": "280px",
								"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"color": "#212529",
								"background": "#ffffff",
								"borderRadius": "6px",
								"overflow": "hidden",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							},
							{
								"border": "1px solid #dee2e6",
								"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)"
							}
						]
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "count",
							"max": 6,
							"node": {
								"tag": "li",
								"props": {
									"style": {
										"ttMerge": [
											{
												"display": "flex",
												"alignItems": "center",
												"gap": "12px",
												"padding": "10px 14px",
												"fontSize": "16px",
												"flexWrap": "wrap"
											},
											{
												"ttIf": {
													"arg": "n",
													"equals": 1,
													"then": {},
													"else": {
														"borderTop": "1px solid #e9ecef"
													}
												}
											}
										]
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"flexGrow": 1,
												"minWidth": 0
											}
										},
										"children": [
											"{item} {n}"
										]
									},
									{
										"tag": "button",
										"props": {
											"type": "button",
											"style": {
												"width": "auto",
												"height": "auto",
												"padding": "8px 12px",
												"display": "inline-flex",
												"alignItems": "center",
												"justifyContent": "center",
												"border": "none",
												"borderRadius": "6px",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#cfe2ff",
															"success": "#d1e7dd",
															"warning": "#fff3cd",
															"danger": "#f8d7da",
															"info": "#cff4fc",
															"neutral": "#e9ecef"
														},
														"default": "#cfe2ff"
													}
												},
												"color": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#052c65",
															"success": "#0a3622",
															"warning": "#664d03",
															"danger": "#58151c",
															"info": "#055160",
															"neutral": "#495057"
														},
														"default": "#052c65"
													}
												},
												"cursor": "pointer",
												"flexShrink": 0,
												"maxWidth": "100%",
												"minWidth": 0,
												"whiteSpace": "normal",
												"boxSizing": "border-box",
												"flexWrap": "wrap"
											},
											"aria-label": "{actionLabel}"
										},
										"children": [
											"{actionLabel}"
										],
										"ttAction": "{actionKey}",
										"ttActionInputs": {
											"family": "list-actions",
											"title": "Actions List",
											"details": "Item label: {item}\nRows: {count}\nAction: {action}"
										}
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Item label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Item label",
											"value": {
												"ttArg": "item"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "item"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Rows ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Rows",
											"value": {
												"ttArg": "count"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 6
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "count"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Action ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Action",
											"value": {
												"ttArg": "action"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "edit"
												},
												"children": [
													"edit"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "trash"
												},
												"children": [
													"trash"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "dots"
												},
												"children": [
													"dots"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "action"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "list-actions",
									"title": "Actions List",
									"details": "Item label: {item}\nRows: {count}\nAction: {action}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "list-actions",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "actions",
		"tranche": 1
	}
}
