{
	"slug": "bootstrap-button-ghost",
	"name": "Ghost Button",
	"library": "bootstrap",
	"category": "buttons",
	"description": "Borderless quiet button in the Bootstrap style — label only, tone-colored text on a transparent body. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"button",
		"action",
		"ghost"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Dismiss",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "uiDismissed",
			"type": "boolean",
			"default": false
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "uiDismissed",
					"then": {
						"tag": "button",
						"props": {
							"type": "button"
						},
						"children": [
							"Show again"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "uiDismissed",
							"value": false
						}
					},
					"else": {
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"ttMerge": [
									{
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"gap": "8px",
										"border": "none",
										"borderRadius": "6px",
										"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontWeight": 400,
										"cursor": "pointer",
										"flexWrap": "wrap"
									},
									{
										"ttMap": {
											"arg": "size",
											"values": {
												"sm": {
													"height": "31px",
													"padding": "0 12px",
													"fontSize": "14px"
												},
												"md": {
													"height": "38px",
													"padding": "0 16px",
													"fontSize": "16px"
												},
												"lg": {
													"height": "48px",
													"padding": "0 20px",
													"fontSize": "18px"
												}
											},
											"default": {
												"height": "38px",
												"padding": "0 16px",
												"fontSize": "16px"
											}
										}
									},
									{
										"background": "transparent",
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#0d6efd",
													"success": "#198754",
													"warning": "#ffc107",
													"danger": "#dc3545",
													"info": "#0dcaf0",
													"neutral": "#6c757d"
												},
												"default": "#0d6efd"
											}
										}
									},
									{
										"ttIf": {
											"arg": "disabled",
											"then": {
												"opacity": 0.5,
												"cursor": "not-allowed"
											},
											"else": {}
										}
									}
								]
							},
							"disabled": {
								"ttArg": "disabled"
							}
						},
						"children": [
							"{label}"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "uiDismissed",
							"value": true
						}
					}
				}
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "button-ghost",
									"title": "Ghost Button",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "button-ghost",
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "ghost",
		"tranche": 1
	}
}
