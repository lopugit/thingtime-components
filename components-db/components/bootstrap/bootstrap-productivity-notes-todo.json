{
	"slug": "bootstrap-productivity-notes-todo",
	"name": "Todo Checklist",
	"library": "bootstrap",
	"category": "productivity",
	"description": "Todo checklist card in the Bootstrap style — list header with done count and thin progress bar, drag-handle task rows with struck completed items, a priority flag and a dashed add-task row. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"todo",
		"checklist",
		"tasks",
		"productivity",
		"progress"
	],
	"args": [
		{
			"name": "list",
			"type": "string",
			"default": "Today",
			"label": "List name",
			"maxLength": 32
		},
		{
			"name": "task",
			"type": "string",
			"default": "Draft launch email",
			"label": "Open task",
			"maxLength": 40
		},
		{
			"name": "done",
			"type": "number",
			"default": 2,
			"label": "Done count"
		},
		{
			"name": "total",
			"type": "number",
			"default": 4,
			"label": "Total count"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "completed",
			"type": "boolean",
			"default": false
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #dee2e6",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "#212529",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "h3",
						"children": [
							"{list}"
						]
					},
					{
						"tag": "label",
						"children": [
							{
								"tag": "input",
								"props": {
									"type": "checkbox",
									"checked": {
										"ttArg": "completed"
									},
									"aria-label": "{task}"
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "completed"
								}
							},
							"{task}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"completed ",
									{
										"tag": "input",
										"props": {
											"aria-label": "completed",
											"type": "checkbox",
											"checked": {
												"ttArg": "completed"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "completed"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"List name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "List name",
											"value": {
												"ttArg": "list"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "list"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Open task ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Open task",
											"value": {
												"ttArg": "task"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "task"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Done count ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Done count",
											"value": {
												"ttArg": "done"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "done"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Total count ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Total count",
											"value": {
												"ttArg": "total"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "total"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "productivity-notes-todo",
									"title": "Todo Checklist",
									"details": "List name: {list}\nOpen task: {task}\nDone count: {done}\nTotal count: {total}\ncompleted: {completed}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "productivity-notes-todo",
	"source": {
		"kind": "archetype",
		"archetype": "productivity-notes",
		"variant": "todo",
		"tranche": 2
	}
}
