{
	"slug": "bootstrap-productivity-notes-snippet",
	"name": "Snippet Card",
	"library": "bootstrap",
	"category": "productivity",
	"description": "Saved code snippet card in the Bootstrap style — language chip beside a mono name, tone-highlighted code lines, a ghost copy button with usage count, and tag chips. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"snippet",
		"code",
		"productivity",
		"clipboard",
		"tags"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "useDebounce",
			"label": "Snippet name",
			"maxLength": 32
		},
		{
			"name": "lang",
			"type": "enum",
			"values": [
				"js",
				"ts",
				"py",
				"sh"
			],
			"default": "ts",
			"label": "Language"
		},
		{
			"name": "count",
			"type": "number",
			"default": 12,
			"label": "Times used"
		},
		{
			"name": "tag",
			"type": "string",
			"default": "hooks",
			"label": "First tag",
			"maxLength": 16
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "content",
			"type": "text",
			"default": "",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #dee2e6",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "#212529",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "h3",
						"children": [
							"{name}"
						]
					},
					{
						"tag": "textarea",
						"props": {
							"value": "{content}",
							"rows": 5,
							"maxLength": 500,
							"aria-label": "Content"
						},
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "content"
						}
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "6px",
								"border": "1px solid #dee2e6",
								"background": "#f8f9fa",
								"cursor": "pointer"
							}
						},
						"children": [
							"Copy snippet"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "copy",
							"value": "{content}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"content ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "content",
											"value": {
												"ttArg": "content"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "content"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Snippet name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Snippet name",
											"value": {
												"ttArg": "name"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "name"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Language ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Language",
											"value": {
												"ttArg": "lang"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "js"
												},
												"children": [
													"js"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "ts"
												},
												"children": [
													"ts"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "py"
												},
												"children": [
													"py"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "sh"
												},
												"children": [
													"sh"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "lang"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Times used ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Times used",
											"value": {
												"ttArg": "count"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "count"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"First tag ",
									{
										"tag": "input",
										"props": {
											"aria-label": "First tag",
											"value": {
												"ttArg": "tag"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tag"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "productivity-notes-snippet",
									"title": "Snippet Card",
									"details": "Snippet name: {name}\nLanguage: {lang}\nTimes used: {count}\nFirst tag: {tag}\ncontent: {content}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "productivity-notes-snippet",
	"source": {
		"kind": "archetype",
		"archetype": "productivity-notes",
		"variant": "snippet",
		"tranche": 2
	}
}
