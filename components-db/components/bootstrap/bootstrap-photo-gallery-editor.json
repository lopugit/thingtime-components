{
	"slug": "bootstrap-photo-gallery-editor",
	"name": "Photo Editor Bar",
	"library": "bootstrap",
	"category": "media",
	"description": "Photo-editor toolbar in the Bootstrap style — crop, rotate, adjust and filter tools with one active, an exposure slider with fill track, thumb and value chip, a before/after toggle and a save/cancel pair. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"photo",
		"editor",
		"toolbar",
		"slider",
		"media"
	],
	"args": [
		{
			"name": "tool",
			"type": "enum",
			"values": [
				"crop",
				"rotate",
				"adjust",
				"filters"
			],
			"default": "crop",
			"label": "Active tool"
		},
		{
			"name": "exposure",
			"type": "number",
			"default": 64,
			"label": "Exposure",
			"min": 0,
			"max": 100
		},
		{
			"name": "original",
			"type": "boolean",
			"default": false,
			"label": "Show original"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "imageUrl",
			"type": "string",
			"default": "",
			"maxLength": 500
		},
		{
			"name": "rotation",
			"type": "number",
			"default": 0,
			"min": 0,
			"max": 360
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #dee2e6",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "#212529",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Image URL",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "imageUrl",
									"value": {
										"ttArg": "imageUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #dee2e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "imageUrl"
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"overflow": "hidden",
								"minWidth": 0
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "imageUrl",
									"equals": "",
									"then": {
										"tag": "p",
										"children": [
											"Enter an image URL to view and adjust it."
										]
									},
									"else": {
										"tag": "img",
										"props": {
											"src": "{imageUrl}",
											"alt": "Image preview",
											"style": {
												"width": "100%",
												"maxHeight": "400px",
												"objectFit": "contain",
												"filter": "brightness({exposure}%)",
												"transform": "rotate({rotation}deg)"
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "label",
						"children": [
							"Exposure",
							{
								"tag": "input",
								"props": {
									"type": "range",
									"aria-label": "exposure",
									"value": {
										"ttArg": "exposure"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #dee2e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"min": 10,
									"max": 200
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "exposure"
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "6px",
								"border": "1px solid #dee2e6",
								"background": "#f8f9fa",
								"cursor": "pointer"
							}
						},
						"children": [
							"Rotate image"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "cycle",
							"key": "rotation",
							"values": [
								0,
								90,
								180,
								270
							]
						}
					},
					{
						"tag": "tt-dialog",
						"props": {
							"title": "Image viewer",
							"name": "Open image viewer"
						},
						"children": [
							{
								"ttIf": {
									"arg": "imageUrl",
									"equals": "",
									"then": {
										"tag": "p",
										"children": [
											"Enter an image URL to view and adjust it."
										]
									},
									"else": {
										"tag": "img",
										"props": {
											"src": "{imageUrl}",
											"alt": "Image preview",
											"style": {
												"width": "100%",
												"maxHeight": "400px",
												"objectFit": "contain",
												"filter": "brightness({exposure}%)",
												"transform": "rotate({rotation}deg)"
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "small",
						"children": [
							"Adjustments affect this preview. Save stores the image URL and settings in a private Thing."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Exposure ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Exposure",
											"value": {
												"ttArg": "exposure"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 100
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "exposure"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"imageUrl ",
									{
										"tag": "input",
										"props": {
											"aria-label": "imageUrl",
											"value": {
												"ttArg": "imageUrl"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "imageUrl"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"rotation ",
									{
										"tag": "input",
										"props": {
											"aria-label": "rotation",
											"value": {
												"ttArg": "rotation"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 360
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "rotation"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Active tool ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Active tool",
											"value": {
												"ttArg": "tool"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "crop"
												},
												"children": [
													"crop"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "rotate"
												},
												"children": [
													"rotate"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "adjust"
												},
												"children": [
													"adjust"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "filters"
												},
												"children": [
													"filters"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tool"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show original ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show original",
											"type": "checkbox",
											"checked": {
												"ttArg": "original"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "original"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "photo-gallery-editor",
									"title": "Photo Editor Bar",
									"details": "Active tool: {tool}\nExposure: {exposure}\nShow original: {original}\nimageUrl: {imageUrl}\nrotation: {rotation}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "photo-gallery-editor",
	"source": {
		"kind": "archetype",
		"archetype": "photo-gallery",
		"variant": "editor",
		"tranche": 2
	}
}
