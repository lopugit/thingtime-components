{
	"slug": "bootstrap-forms-advanced-otp",
	"name": "OTP Code Input",
	"library": "bootstrap",
	"category": "forms",
	"description": "One-time-code entry in the Bootstrap style — six square code boxes with four digits typed in, an active box carrying the text caret, and a resend helper caption. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"otp",
		"code",
		"verification"
	],
	"args": [
		{
			"name": "digit1",
			"type": "string",
			"default": "7",
			"label": "First digit",
			"maxLength": 1
		},
		{
			"name": "digit2",
			"type": "string",
			"default": "3",
			"label": "Second digit",
			"maxLength": 1
		},
		{
			"name": "active",
			"type": "boolean",
			"default": true,
			"label": "Active box"
		},
		{
			"name": "helper",
			"type": "string",
			"default": "Didn't get a code?",
			"label": "Helper text",
			"maxLength": 40
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "code",
			"type": "string",
			"default": "",
			"maxLength": 8
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #dee2e6",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "#212529",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Code draft",
							{
								"tag": "input",
								"props": {
									"type": "text",
									"aria-label": "code",
									"value": {
										"ttArg": "code"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #dee2e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"maxLength": 8
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "code"
								}
							}
						]
					},
					{
						"tag": "small",
						"children": [
							"Verification requires your configured authentication Action."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"code ",
									{
										"tag": "input",
										"props": {
											"aria-label": "code",
											"value": {
												"ttArg": "code"
											},
											"maxLength": 8,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "code"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"First digit ",
									{
										"tag": "input",
										"props": {
											"aria-label": "First digit",
											"value": {
												"ttArg": "digit1"
											},
											"maxLength": 1,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "digit1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Second digit ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Second digit",
											"value": {
												"ttArg": "digit2"
											},
											"maxLength": 1,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "digit2"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Active box ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Active box",
											"type": "checkbox",
											"checked": {
												"ttArg": "active"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "active"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Helper text ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Helper text",
											"value": {
												"ttArg": "helper"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "helper"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "forms-advanced-otp",
									"title": "OTP Code Input",
									"details": "First digit: {digit1}\nSecond digit: {digit2}\nActive box: {active}\nHelper text: {helper}\ncode: {code}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "forms-advanced-otp",
	"source": {
		"kind": "archetype",
		"archetype": "forms-advanced",
		"variant": "otp",
		"tranche": 2
	}
}
