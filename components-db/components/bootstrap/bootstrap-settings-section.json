{
	"slug": "bootstrap-settings-section",
	"name": "Settings Section",
	"library": "bootstrap",
	"category": "settings",
	"description": "Grouped settings card in the Bootstrap style — mono uppercase section header over a switch row, a select mock with chevron, and a navigation row, split by hairline dividers. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"settings",
		"section",
		"card",
		"group"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Workspace",
			"label": "Heading",
			"maxLength": 30
		},
		{
			"name": "enabled",
			"type": "boolean",
			"default": true,
			"label": "Auto-save on"
		},
		{
			"name": "value",
			"type": "string",
			"default": "English",
			"label": "Selected value",
			"maxLength": 24
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
