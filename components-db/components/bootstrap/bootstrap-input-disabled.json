{
	"slug": "bootstrap-input-disabled",
	"name": "Disabled Input",
	"library": "bootstrap",
	"category": "forms",
	"description": "Disabled text field in the Bootstrap style — muted label over a filled, non-interactive control with a not-allowed cursor and a faint hint. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"input",
		"disabled",
		"readonly",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "API key",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "Managed by your admin",
			"label": "Value",
			"maxLength": 60
		},
		{
			"name": "hint",
			"type": "string",
			"default": "Contact an admin to change this.",
			"label": "Hint",
			"maxLength": 80
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "6px",
						"width": "260px",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "label",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 500,
								"color": "#6c757d"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"value": "{value}",
							"disabled": true,
							"style": {
								"ttMerge": [
									{
										"width": "100%",
										"padding": "0 12px",
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#ffffff",
										"color": "#212529",
										"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"outline": "none",
										"boxSizing": "border-box",
										"maxWidth": "100%"
									},
									{
										"height": "38px",
										"fontSize": "16px",
										"background": "#f8f9fa",
										"color": "#6c757d",
										"border": "1px solid #e9ecef",
										"cursor": "not-allowed",
										"boxShadow": "none"
									}
								]
							}
						}
					},
					{
						"ttIf": {
							"arg": "hint",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#adb5bd"
									}
								},
								"children": [
									"{hint}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Value ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Value",
											"value": {
												"ttArg": "value"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "value"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Hint ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Hint",
											"value": {
												"ttArg": "hint"
											},
											"maxLength": 80,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "hint"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "input-disabled",
									"title": "Disabled Input",
									"details": "Label: {label}\nValue: {value}\nHint: {hint}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "input-disabled",
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "disabled",
		"tranche": 1
	}
}
