{
	"slug": "bootstrap-onboarding-progress",
	"name": "Onboarding Progress Banner",
	"library": "bootstrap",
	"category": "onboarding",
	"description": "Slim finish-setup banner in the Bootstrap style — label, inline tone progress bar with a mono percent readout, a resume button and a quiet dismiss cross. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"onboarding",
		"progress",
		"banner",
		"resume"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Finish setting up",
			"label": "Label",
			"maxLength": 32
		},
		{
			"name": "percent",
			"type": "number",
			"default": 60,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "resumeLabel",
			"type": "string",
			"default": "Resume",
			"label": "Button label",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#dee2e6",
						"borderRadius": "6px",
						"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
						"boxSizing": "border-box",
						"width": "360px",
						"gap": "10px",
						"padding": "10px 12px",
						"maxWidth": "100%",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#212529",
								"whiteSpace": "nowrap",
								"flexShrink": 0
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"minWidth": "40px",
								"height": "6px",
								"borderRadius": "999px",
								"background": "#e9ecef",
								"overflow": "hidden"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "{percent}%",
										"height": "100%",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#0d6efd",
													"success": "#198754",
													"warning": "#ffc107",
													"danger": "#dc3545",
													"info": "#0dcaf0",
													"neutral": "#6c757d"
												},
												"default": "#0d6efd"
											}
										},
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "12px",
								"color": "#6c757d",
								"flexShrink": 0
							}
						},
						"children": [
							"{percent}%"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "6px",
								"border": "none",
								"borderRadius": "6px",
								"fontWeight": 400,
								"cursor": "pointer",
								"height": "auto",
								"padding": "8px 12px",
								"fontSize": "12px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"flexShrink": 0,
								"width": "auto",
								"minWidth": 0,
								"whiteSpace": "normal",
								"maxWidth": "100%",
								"boxSizing": "border-box",
								"flexWrap": "wrap"
							},
							"aria-label": "{actionLabel}"
						},
						"children": [
							"{actionLabel}"
						],
						"ttAction": "{actionKey}",
						"ttActionInputs": {
							"family": "onboarding-progress",
							"title": "Onboarding Progress Banner",
							"details": "Label: {label}\nPercent: {percent}\nButton label: {resumeLabel}"
						}
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"width": "auto",
								"height": "auto",
								"padding": "8px 12px",
								"border": "none",
								"borderRadius": "4px",
								"background": "transparent",
								"color": "#6c757d",
								"cursor": "pointer",
								"flexShrink": 0,
								"maxWidth": "100%",
								"minWidth": 0,
								"whiteSpace": "normal",
								"boxSizing": "border-box",
								"flexWrap": "wrap"
							},
							"aria-label": "{actionLabel}"
						},
						"children": [
							"{actionLabel}"
						],
						"ttAction": "{actionKey}",
						"ttActionInputs": {
							"family": "onboarding-progress",
							"title": "Onboarding Progress Banner",
							"details": "Label: {label}\nPercent: {percent}\nButton label: {resumeLabel}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
