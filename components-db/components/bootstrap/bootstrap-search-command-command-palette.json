{
	"slug": "bootstrap-search-command-command-palette",
	"name": "Command Palette",
	"library": "bootstrap",
	"category": "forms",
	"description": "Command palette in the Bootstrap style — a centered elevated panel with a prompt row, a Suggestions group header, and four icon + shortcut command rows; the active row carries a tone accent bar. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"search",
		"command-palette",
		"keyboard",
		"launcher"
	],
	"args": [
		{
			"name": "placeholder",
			"type": "string",
			"default": "Type a command…",
			"label": "Placeholder",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3",
				"4"
			],
			"default": "1",
			"label": "Active row"
		},
		{
			"name": "prompt",
			"type": "enum",
			"values": [
				"search",
				"chevron"
			],
			"default": "search",
			"label": "Prompt glyph"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "searchQuery",
			"type": "string",
			"default": "",
			"maxLength": 200
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #dee2e6",
						"borderRadius": "6px",
						"background": "#ffffff",
						"color": "#212529",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Search Things",
							{
								"tag": "input",
								"props": {
									"type": "search",
									"aria-label": "searchQuery",
									"value": {
										"ttArg": "searchQuery"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #dee2e6",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "searchQuery"
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "6px",
								"border": "1px solid #dee2e6",
								"background": "#f8f9fa",
								"cursor": "pointer"
							}
						},
						"children": [
							"Search Things"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "search",
							"value": "{searchQuery}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"searchQuery ",
									{
										"tag": "input",
										"props": {
											"aria-label": "searchQuery",
											"value": {
												"ttArg": "searchQuery"
											},
											"maxLength": 200,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "searchQuery"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Active row ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Active row",
											"value": {
												"ttArg": "active"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "1"
												},
												"children": [
													"1"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "2"
												},
												"children": [
													"2"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "3"
												},
												"children": [
													"3"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "4"
												},
												"children": [
													"4"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "active"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Prompt glyph ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Prompt glyph",
											"value": {
												"ttArg": "prompt"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "search"
												},
												"children": [
													"search"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "chevron"
												},
												"children": [
													"chevron"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "prompt"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "search-command-command-palette",
									"title": "Command Palette",
									"details": "Active row: {active}\nPrompt glyph: {prompt}\nsearchQuery: {searchQuery}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f8f9fa",
	"version": 2,
	"familyKey": "search-command-command-palette",
	"source": {
		"kind": "archetype",
		"archetype": "search-command",
		"variant": "command-palette",
		"tranche": 2
	}
}
