{
	"slug": "bootstrap-marketing-cta",
	"name": "CTA Band",
	"library": "bootstrap",
	"category": "marketing",
	"description": "Call-to-action band in the Bootstrap style — gradient or solid tone background with heading, subtext, and an inverted surface button. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"marketing",
		"cta",
		"banner",
		"conversion"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Ready to dive in?",
			"label": "Heading",
			"maxLength": 60
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Free 14-day trial — no credit card required.",
			"label": "Subtext",
			"maxLength": 120
		},
		{
			"name": "buttonLabel",
			"type": "string",
			"default": "Create your account",
			"label": "Button label",
			"maxLength": 30
		},
		{
			"name": "gradient",
			"type": "boolean",
			"default": true,
			"label": "Gradient"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"padding": "24px 28px",
						"borderRadius": "8px",
						"background": {
							"ttIf": {
								"arg": "gradient",
								"then": "linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%)",
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								}
							}
						},
						"color": {
							"ttIf": {
								"arg": "gradient",
								"then": "#ffffff",
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						},
						"gap": "18px",
						"justifyContent": "space-between",
						"flexWrap": "wrap",
						"maxWidth": "560px",
						"boxShadow": "0 .5rem 1rem rgba(0, 0, 0, .15)",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "4px",
								"flex": "1 1 220px",
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "20px",
										"fontWeight": 500
									}
								},
								"children": [
									"{heading}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"opacity": 0.85
									}
								},
								"children": [
									"{subtext}"
								]
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "auto",
								"padding": "8px 12px",
								"borderRadius": "6px",
								"fontWeight": 400,
								"fontSize": "16px",
								"cursor": "pointer",
								"background": "#ffffff",
								"color": "#212529",
								"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
								"flexShrink": 0,
								"width": "auto",
								"minWidth": 0,
								"whiteSpace": "normal",
								"maxWidth": "100%",
								"boxSizing": "border-box",
								"flexWrap": "wrap"
							},
							"aria-label": "{actionLabel}"
						},
						"children": [
							"{actionLabel}"
						],
						"ttAction": "{actionKey}",
						"ttActionInputs": {
							"family": "marketing-cta",
							"title": "CTA Band",
							"details": "Heading: {heading}\nSubtext: {subtext}\nButton label: {buttonLabel}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Heading ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Heading",
											"value": {
												"ttArg": "heading"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "heading"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Subtext ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Subtext",
											"value": {
												"ttArg": "subtext"
											},
											"maxLength": 120,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "subtext"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Button label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Button label",
											"value": {
												"ttArg": "buttonLabel"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "buttonLabel"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "marketing-cta",
									"title": "CTA Band",
									"details": "Heading: {heading}\nSubtext: {subtext}\nButton label: {buttonLabel}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "marketing-cta",
	"source": {
		"kind": "archetype",
		"archetype": "marketing",
		"variant": "cta",
		"tranche": 1
	}
}
