{
	"slug": "bootstrap-chat-bubble",
	"name": "Message Bubble Pair",
	"library": "bootstrap",
	"category": "messaging",
	"description": "Incoming and outgoing chat bubbles in the Bootstrap style — quiet surface on the left, tone-solid reply on the right, library-native corners with a sharp tail edge and a timestamp. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"chat",
		"message",
		"bubble",
		"conversation"
	],
	"args": [
		{
			"name": "incoming",
			"type": "string",
			"default": "Hey! Did you see the launch?",
			"label": "Incoming message",
			"maxLength": 120
		},
		{
			"name": "outgoing",
			"type": "string",
			"default": "Just saw it — looks great!",
			"label": "Outgoing message",
			"maxLength": 120
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "time",
			"type": "string",
			"default": "9:41 AM",
			"label": "Timestamp",
			"maxLength": 12
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save draft",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "6px",
						"width": "280px",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "8px 12px",
								"maxWidth": "220px",
								"fontSize": "16px",
								"lineHeight": 1.45,
								"background": "#f8f9fa",
								"color": "#212529",
								"borderRadius": "6px 6px 6px 4px",
								"alignSelf": "flex-start"
							}
						},
						"children": [
							"{incoming}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "8px 12px",
								"maxWidth": "220px",
								"fontSize": "16px",
								"lineHeight": 1.45,
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"borderRadius": "6px 6px 4px 6px",
								"alignSelf": "flex-end"
							}
						},
						"children": [
							"{outgoing}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"alignSelf": "flex-end",
								"fontSize": "12px",
								"color": "#6c757d"
							}
						},
						"children": [
							"{time}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Incoming message ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Incoming message",
											"value": {
												"ttArg": "incoming"
											},
											"maxLength": 120,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "incoming"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Outgoing message ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Outgoing message",
											"value": {
												"ttArg": "outgoing"
											},
											"maxLength": 120,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "outgoing"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Timestamp ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Timestamp",
											"value": {
												"ttArg": "time"
											},
											"maxLength": 12,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "time"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "chat-bubble",
									"title": "Message Bubble Pair",
									"details": "Incoming message: {incoming}\nOutgoing message: {outgoing}\nTimestamp: {time}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			},
			{
				"tag": "small",
				"children": [
					"Draft only. Saving creates a private Thing. External effects require a configured Action."
				]
			}
		]
	},
	"version": 2,
	"familyKey": "chat-bubble",
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "bubble",
		"tranche": 2
	}
}
