{
	"slug": "bootstrap-toast-notification-top-banner",
	"name": "Top Banner",
	"library": "bootstrap",
	"category": "feedback",
	"description": "Full-width announcement banner in the Bootstrap style — solid tone strip with a bold message, inline link, and dismiss control. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"banner",
		"announcement",
		"feedback",
		"dismiss"
	],
	"args": [
		{
			"name": "message",
			"type": "string",
			"default": "A new version is available.",
			"label": "Message",
			"maxLength": 80
		},
		{
			"name": "linkLabel",
			"type": "string",
			"default": "See what changed",
			"label": "Link label",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "dismissible",
			"type": "boolean",
			"default": true,
			"label": "Dismissible"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"width": "100%",
						"minWidth": 0,
						"justifyContent": "space-between",
						"gap": "16px",
						"padding": "10px 16px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#0d6efd",
									"success": "#198754",
									"warning": "#ffc107",
									"danger": "#dc3545",
									"info": "#0dcaf0",
									"neutral": "#6c757d"
								},
								"default": "#0d6efd"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#000000",
									"danger": "#ffffff",
									"info": "#000000",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"fontSize": "14px",
						"maxWidth": "100%",
						"boxSizing": "border-box",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "10px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontWeight": 600
									}
								},
								"children": [
									"{message}"
								]
							},
							{
								"ttIf": {
									"arg": "linkLabel",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"textDecoration": "underline",
												"fontWeight": 600,
												"opacity": 0.9
											}
										},
										"children": [
											"{linkLabel}"
										]
									}
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "dismissible",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"opacity": 0.8,
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 18,
													"y1": 6,
													"x2": 6,
													"y2": 18
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 6,
													"y1": 6,
													"x2": 18,
													"y2": 18
												}
											}
										]
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Message ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Message",
											"value": {
												"ttArg": "message"
											},
											"maxLength": 80,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "message"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Link label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Link label",
											"value": {
												"ttArg": "linkLabel"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #dee2e6",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "linkLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Dismissible ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Dismissible",
											"type": "checkbox",
											"checked": {
												"ttArg": "dismissible"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "dismissible"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #dee2e6",
										"borderRadius": "6px",
										"background": "#f8f9fa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "toast-notification-top-banner",
									"title": "Top Banner",
									"details": "Message: {message}\nLink label: {linkLabel}\nDismissible: {dismissible}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "toast-notification-top-banner",
	"source": {
		"kind": "archetype",
		"archetype": "toast-notification",
		"variant": "top-banner",
		"tranche": 1
	}
}
