{
	"slug": "mui-card-elevated",
	"name": "Elevated Card",
	"library": "mui",
	"category": "layout",
	"description": "Floating borderless card in the Material UI style — the library's deeper shadow tiers lift it off the page, led by a tone-tinted icon chip. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"card",
		"elevated",
		"shadow",
		"floating"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Quick insight",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Elevation carries the hierarchy here — the card floats free of any border.",
			"label": "Body",
			"maxLength": 500
		},
		{
			"name": "elevation",
			"type": "enum",
			"values": [
				"raised",
				"floating"
			],
			"default": "floating",
			"label": "Elevation"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"width": "300px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"border": "none",
						"borderRadius": "4px",
						"boxShadow": {
							"ttMap": {
								"arg": "elevation",
								"values": {
									"raised": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)",
									"floating": "0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12)"
								},
								"default": "0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12)"
							}
						},
						"overflow": "hidden",
						"boxSizing": "border-box",
						"padding": "16px",
						"gap": "10px",
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "10px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "32px",
										"height": "32px",
										"borderRadius": "4px",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e3f2fd",
													"success": "#edf7ed",
													"warning": "#fff4e5",
													"danger": "#fdeded",
													"info": "#e5f6fd",
													"neutral": "#eeeeee"
												},
												"default": "#e3f2fd"
											}
										},
										"flexShrink": 0,
										"maxWidth": "100%",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 16,
											"height": 16,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": {
												"ttMap": {
													"arg": "tone",
													"values": {
														"primary": "#1565c0",
														"success": "#1e4620",
														"warning": "#663c00",
														"danger": "#5f2120",
														"info": "#014361",
														"neutral": "#424242"
													},
													"default": "#1565c0"
												}
											},
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polygon",
												"props": {
													"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
												}
											}
										]
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "16px",
										"fontWeight": 500,
										"color": "rgba(0, 0, 0, 0.87)"
									}
								},
								"children": [
									"{title}"
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"color": "rgba(0, 0, 0, 0.6)",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Body ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Body",
											"value": {
												"ttArg": "body"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "body"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "card-elevated",
									"title": "Elevated Card",
									"details": "Title: {title}\nBody: {body}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "card-elevated",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "elevated",
		"tranche": 1
	}
}
