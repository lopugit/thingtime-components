{
	"slug": "mui-photo-gallery-filmstrip",
	"name": "Filmstrip",
	"library": "mui",
	"category": "media",
	"description": "Filmstrip scrubber in the Material UI style — a large tone-tinted current frame above a six-thumbnail strip with the active frame ringed, plus a frame counter and zoom chips. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"photo",
		"filmstrip",
		"thumbnails",
		"viewer"
	],
	"args": [
		{
			"name": "frame",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3",
				"4",
				"5",
				"6"
			],
			"default": "2",
			"label": "Current frame"
		},
		{
			"name": "zoom",
			"type": "number",
			"default": 100,
			"label": "Zoom %"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "imageUrl",
			"type": "string",
			"default": "",
			"maxLength": 500
		},
		{
			"name": "rotation",
			"type": "number",
			"default": 0,
			"min": 0,
			"max": 360
		},
		{
			"name": "exposure",
			"type": "number",
			"default": 100,
			"min": 10,
			"max": 200
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"borderRadius": "4px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Image URL",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "imageUrl",
									"value": {
										"ttArg": "imageUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "imageUrl"
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"overflow": "hidden",
								"minWidth": 0
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "imageUrl",
									"equals": "",
									"then": {
										"tag": "p",
										"children": [
											"Enter an image URL to view and adjust it."
										]
									},
									"else": {
										"tag": "img",
										"props": {
											"src": "{imageUrl}",
											"alt": "Image preview",
											"style": {
												"width": "100%",
												"maxHeight": "400px",
												"objectFit": "contain",
												"filter": "brightness({exposure}%)",
												"transform": "rotate({rotation}deg)"
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "4px",
								"border": "1px solid rgba(0, 0, 0, 0.12)",
								"background": "#fafafa",
								"cursor": "pointer"
							}
						},
						"children": [
							"Rotate image"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "cycle",
							"key": "rotation",
							"values": [
								0,
								90,
								180,
								270
							]
						}
					},
					{
						"tag": "tt-dialog",
						"props": {
							"title": "Image viewer",
							"name": "Open image viewer"
