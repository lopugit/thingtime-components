										"tag": "p",
										"children": [
											"Enter an image URL to view and adjust it."
										]
									},
									"else": {
										"tag": "img",
										"props": {
											"src": "{imageUrl}",
											"alt": "Image preview",
											"style": {
												"width": "100%",
												"maxHeight": "400px",
												"objectFit": "contain",
												"filter": "brightness({exposure}%)",
												"transform": "rotate({rotation}deg)"
											}
										}
									}
								}
							}
