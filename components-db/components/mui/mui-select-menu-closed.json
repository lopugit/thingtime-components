{
	"slug": "mui-select-menu-closed",
	"name": "Select Input",
	"library": "mui",
	"category": "forms",
	"description": "Closed select trigger in the Material UI style — labeled field with the chosen value on the left and a muted chevron on the right, in three control sizes. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"select",
		"dropdown",
		"trigger"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Country",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "Australia",
			"label": "Value",
			"maxLength": 40
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "selection",
			"type": "string",
			"default": "Australia"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"borderRadius": "4px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"{label}",
							{
								"tag": "select",
								"props": {
									"value": {
										"ttArg": "selection"
									},
									"aria-label": "Select an option",
									"disabled": {
										"ttArg": "disabled"
									}
								},
								"children": [
									{
										"tag": "option",
										"props": {
											"value": ""
										},
										"children": [
											"Choose…"
										]
									},
									{
										"tag": "option",
										"props": {
											"value": "Australia"
										},
										"children": [
											"Australia"
										]
									},
									{
										"tag": "option",
										"props": {
											"value": "Canada"
										},
										"children": [
											"Canada"
										]
									},
									{
										"tag": "option",
										"props": {
											"value": "Japan"
										},
										"children": [
											"Japan"
										]
									},
									{
										"tag": "option",
										"props": {
											"value": "New Zealand"
										},
										"children": [
											"New Zealand"
										]
									},
									{
										"tag": "option",
										"props": {
											"value": "United Kingdom"
										},
										"children": [
											"United Kingdom"
										]
									}
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "selection"
								}
							}
						]
					},
					{
						"tag": "p",
						"children": [
							"Selected: {selection}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"selection ",
									{
										"tag": "input",
										"props": {
											"aria-label": "selection",
											"value": {
												"ttArg": "selection"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selection"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Value ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Value",
											"value": {
												"ttArg": "value"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "value"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "select-menu-closed",
									"title": "Select Input",
									"details": "Label: {label}\nValue: {value}\nselection: {selection}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "select-menu-closed",
	"source": {
		"kind": "archetype",
		"archetype": "select-menu",
		"variant": "closed",
		"tranche": 1
	}
}
