{
	"slug": "mui-modal-drawer-form",
	"name": "Form Dialog",
	"library": "mui",
	"category": "overlays",
	"description": "Dialog with a small form on a dimmed backdrop in the Material UI style — two labeled text inputs under the title, cancel and a tone submit in the footer. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"modal",
		"form",
		"overlay",
		"inputs"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Create project",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "label1",
			"type": "string",
			"default": "Name",
			"label": "Field 1 label",
			"maxLength": 24
		},
		{
			"name": "label2",
			"type": "string",
			"default": "Description",
			"label": "Field 2 label",
			"maxLength": 24
		},
		{
			"name": "submitLabel",
			"type": "string",
			"default": "Create",
			"label": "Submit label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "projectName",
			"type": "string",
			"default": "",
			"maxLength": 500
		},
		{
			"name": "description",
			"type": "string",
			"default": "",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "tt-dialog",
				"props": {
					"title": "{title}",
					"name": "Open form",
					"type": "modal"
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "grid",
								"gap": "12px",
								"padding": "16px",
								"border": "1px solid rgba(0, 0, 0, 0.12)",
								"borderRadius": "4px",
								"background": "#ffffff",
								"color": "rgba(0, 0, 0, 0.87)",
								"minWidth": 0,
								"maxWidth": "100%"
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"{label1}",
									{
										"tag": "input",
										"props": {
											"type": "text",
											"aria-label": "projectName",
											"value": {
												"ttArg": "projectName"
											},
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "projectName"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"{label2}",
									{
										"tag": "input",
										"props": {
											"type": "text",
											"aria-label": "description",
											"value": {
												"ttArg": "description"
											},
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "description"
										}
									}
								]
							},
							{
								"tag": "p",
								"children": [
									"Edit the values below and save a private draft. No external changes are made."
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"projectName ",
									{
										"tag": "input",
										"props": {
											"aria-label": "projectName",
											"value": {
												"ttArg": "projectName"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "projectName"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"description ",
									{
										"tag": "input",
										"props": {
											"aria-label": "description",
											"value": {
												"ttArg": "description"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "description"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Field 1 label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Field 1 label",
											"value": {
												"ttArg": "label1"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Field 2 label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Field 2 label",
											"value": {
												"ttArg": "label2"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label2"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Submit label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Submit label",
											"value": {
												"ttArg": "submitLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "submitLabel"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "modal-drawer-form",
									"title": "Form Dialog",
									"details": "Title: {title}\nField 1 label: {label1}\nField 2 label: {label2}\nSubmit label: {submitLabel}\nprojectName: {projectName}\ndescription: {description}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
