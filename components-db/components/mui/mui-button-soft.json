{
	"slug": "mui-button-soft",
	"name": "Soft Button",
	"library": "mui",
	"category": "buttons",
	"description": "Tinted button in the Material UI style — soft tone wash background with the deeper tone for the label. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"button",
		"action",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Preview",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"borderRadius": "4px",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontWeight": 500,
								"cursor": "pointer",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em",
								"flexWrap": "wrap"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"height": "30px",
											"padding": "0 12px",
											"fontSize": "13px"
										},
										"md": {
											"height": "36px",
											"padding": "0 16px",
											"fontSize": "14px"
										},
										"lg": {
											"height": "42px",
											"padding": "0 20px",
											"fontSize": "16px"
										}
									},
									"default": {
										"height": "36px",
										"padding": "0 16px",
										"fontSize": "14px"
									}
								}
							},
							{
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#e3f2fd",
											"success": "#edf7ed",
											"warning": "#fff4e5",
											"danger": "#fdeded",
											"info": "#e5f6fd",
											"neutral": "#eeeeee"
										},
										"default": "#e3f2fd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1565c0",
											"success": "#1e4620",
											"warning": "#663c00",
											"danger": "#5f2120",
											"info": "#014361",
											"neutral": "#424242"
										},
										"default": "#1565c0"
									}
								}
							},
							{
								"ttIf": {
									"arg": "disabled",
									"then": {
										"opacity": 0.5,
										"cursor": "not-allowed"
									},
									"else": {}
								}
							},
							{
								"width": "auto",
								"height": "auto",
								"minWidth": 0,
								"padding": "8px 12px",
								"whiteSpace": "normal",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							}
						]
					},
					"disabled": {
						"ttArg": "disabled"
					},
					"aria-label": "{actionLabel}"
				},
				"children": [
					"{actionLabel}"
				],
				"ttAction": "{actionKey}",
				"ttActionInputs": {
					"family": "button-soft",
					"title": "Soft Button",
					"details": "Label: {label}"
				}
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "button-soft",
									"title": "Soft Button",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "button-soft",
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "soft",
		"tranche": 1
	}
}
