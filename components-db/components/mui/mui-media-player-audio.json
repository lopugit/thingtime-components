{
	"slug": "mui-media-player-audio",
	"name": "Audio Player",
	"library": "mui",
	"category": "media",
	"description": "Audio player card in the Material UI style — tinted artwork square with a music glyph, track title and artist, tone progress bar with elapsed/total times, and prev/play/next transport controls. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"media",
		"audio",
		"player",
		"music"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Golden Hour",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "artist",
			"type": "string",
			"default": "Cassette Club",
			"label": "Artist",
			"maxLength": 40
		},
		{
			"name": "percent",
			"type": "number",
			"default": 42,
			"label": "Progress %",
			"min": 0,
			"max": 100
		},
		{
			"name": "elapsed",
			"type": "string",
			"default": "1:34",
			"label": "Elapsed",
			"maxLength": 8
		},
		{
			"name": "total",
			"type": "string",
			"default": "3:42",
			"label": "Total",
			"maxLength": 8
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "mediaUrl",
			"type": "string",
			"default": "",
			"label": "Media URL",
			"maxLength": 500
		}
	],
