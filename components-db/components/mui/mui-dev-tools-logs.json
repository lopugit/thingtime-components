{
	"slug": "mui-dev-tools-logs",
	"name": "Log Viewer",
	"library": "mui",
	"category": "developer",
	"description": "Log viewer in the Material UI style — a filter chip row over a dark monospace panel of INFO, WARN and ERROR lines with level chips and timestamps, the matching line highlighted with the library's accent rail. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"developer",
		"logs",
		"console",
		"monitoring",
		"filter"
	],
	"args": [
		{
			"name": "service",
			"type": "string",
			"default": "api-server",
			"label": "Service",
			"maxLength": 24
		},
		{
			"name": "filter",
			"type": "string",
			"default": "payments",
			"label": "Active filter",
			"maxLength": 20
		},
		{
			"name": "timestamps",
			"type": "boolean",
			"default": true,
			"label": "Show timestamps"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"borderRadius": "4px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "h3",
						"children": [
							"{service} sample logs"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexWrap": "wrap",
								"gap": "6px"
							}
						},
						"children": [
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"padding": "8px 12px",
										"borderRadius": "4px",
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"background": {
											"ttIf": {
												"arg": "filter",
												"equals": "all",
												"then": "#1976d2",
												"else": "#fafafa"
											}
										},
										"cursor": "pointer",
										"color": {
											"ttIf": {
												"arg": "filter",
												"equals": "all",
												"then": "#ffffff",
												"else": "rgba(0, 0, 0, 0.87)"
											}
										}
									},
									"aria-pressed": {
										"ttIf": {
											"arg": "filter",
											"equals": "all",
											"then": true,
											"else": false
										}
									}
								},
								"children": [
									"all"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "filter",
									"value": "all"
								}
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"padding": "8px 12px",
										"borderRadius": "4px",
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"background": {
											"ttIf": {
												"arg": "filter",
												"equals": "payments",
												"then": "#1976d2",
												"else": "#fafafa"
											}
										},
										"cursor": "pointer",
										"color": {
											"ttIf": {
												"arg": "filter",
												"equals": "payments",
												"then": "#ffffff",
												"else": "rgba(0, 0, 0, 0.87)"
											}
										}
									},
									"aria-pressed": {
										"ttIf": {
											"arg": "filter",
											"equals": "payments",
											"then": true,
											"else": false
										}
									}
								},
								"children": [
									"payments"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "filter",
									"value": "payments"
								}
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"padding": "8px 12px",
										"borderRadius": "4px",
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"background": {
											"ttIf": {
												"arg": "filter",
												"equals": "errors",
												"then": "#1976d2",
												"else": "#fafafa"
											}
										},
										"cursor": "pointer",
										"color": {
											"ttIf": {
												"arg": "filter",
												"equals": "errors",
												"then": "#ffffff",
												"else": "rgba(0, 0, 0, 0.87)"
											}
										}
									},
									"aria-pressed": {
										"ttIf": {
											"arg": "filter",
											"equals": "errors",
											"then": true,
											"else": false
										}
									}
								},
								"children": [
									"errors"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "filter",
									"value": "errors"
								}
							}
						]
					},
					{
						"tag": "pre",
						"props": {
							"style": {
								"whiteSpace": "pre-wrap"
							}
						},
						"children": [
							{
								"ttMap": {
									"arg": "filter",
									"values": {
										"all": "INFO: server ready\nINFO: payment draft prepared\nERROR: sample timeout",
										"payments": "INFO: payment draft prepared",
										"errors": "ERROR: sample timeout"
									},
									"default": "No matching sample logs."
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Active filter ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Active filter",
											"value": {
												"ttArg": "filter"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "filter"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Service ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Service",
											"value": {
												"ttArg": "service"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "service"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show timestamps ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show timestamps",
											"type": "checkbox",
											"checked": {
												"ttArg": "timestamps"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "timestamps"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "dev-tools-logs",
									"title": "Log Viewer",
									"details": "Service: {service}\nActive filter: {filter}\nShow timestamps: {timestamps}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "dev-tools-logs",
	"source": {
		"kind": "archetype",
		"archetype": "dev-tools",
		"variant": "logs",
		"tranche": 2
	}
}
