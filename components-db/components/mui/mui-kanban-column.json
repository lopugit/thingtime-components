{
	"slug": "mui-kanban-column",
	"name": "Kanban Column",
	"library": "mui",
	"category": "project",
	"description": "Board column in the Material UI style — header with a tone count pill and kebab menu, stacked mini cards, and a dashed add-card footer row. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"kanban",
		"column",
		"board",
		"project"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "In progress",
			"label": "Column name",
			"maxLength": 24
		},
		{
			"name": "cards",
			"type": "number",
			"default": 3,
			"label": "Cards",
			"min": 1,
			"max": 4
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"width": "230px",
						"boxSizing": "border-box",
						"gap": "8px",
						"padding": "10px",
						"background": "#f5f5f5",
						"border": "1px solid rgba(0, 0, 0, 0.08)",
						"borderRadius": "8px",
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px",
								"padding": "2px 2px 4px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "13px",
										"fontWeight": 500,
										"color": "rgba(0, 0, 0, 0.87)",
										"textTransform": "uppercase",
										"letterSpacing": "0.02857em"
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"minWidth": "18px",
										"height": "18px",
										"padding": "0 5px",
										"boxSizing": "border-box",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e3f2fd",
													"success": "#edf7ed",
													"warning": "#fff4e5",
													"danger": "#fdeded",
													"info": "#e5f6fd",
													"neutral": "#eeeeee"
												},
												"default": "#e3f2fd"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1565c0",
													"success": "#1e4620",
													"warning": "#663c00",
													"danger": "#5f2120",
													"info": "#014361",
													"neutral": "#424242"
												},
												"default": "#1565c0"
											}
										},
										"fontSize": "12px",
										"fontWeight": 700,
										"flexWrap": "wrap"
									}
								},
								"children": [
									"{cards}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"marginLeft": "auto",
										"display": "inline-flex",
										"color": "rgba(0, 0, 0, 0.6)",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "currentColor",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "circle",
												"props": {
													"cx": 12,
													"cy": 12,
													"r": 1.6
												}
											},
											{
												"tag": "circle",
												"props": {
													"cx": 19,
													"cy": 12,
													"r": 1.6
												}
											},
											{
												"tag": "circle",
												"props": {
													"cx": 5,
													"cy": 12,
													"r": 1.6
												}
											}
										]
									}
								]
							}
						]
					},
					{
						"ttRepeat": {
							"arg": "cards",
							"max": 4,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"padding": "9px 10px",
										"background": "#ffffff",
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
										"fontSize": "13px",
										"fontWeight": 500,
										"color": "rgba(0, 0, 0, 0.87)"
									}
								},
								"children": [
									"Card {n}"
								]
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px",
								"justifyContent": "center",
								"padding": "7px",
								"border": "1px dashed rgba(0, 0, 0, 0.12)",
								"borderRadius": "4px",
								"color": "rgba(0, 0, 0, 0.6)",
								"fontSize": "13px",
								"fontWeight": 500,
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 12,
									"height": 12,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "line",
										"props": {
											"x1": 12,
											"y1": 5,
											"x2": 12,
											"y2": 19
										}
									},
									{
										"tag": "line",
										"props": {
											"x1": 5,
											"y1": 12,
											"x2": 19,
											"y2": 12
										}
									}
								]
							},
							"Add card"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Column name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Column name",
											"value": {
												"ttArg": "name"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "name"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Cards ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Cards",
											"value": {
												"ttArg": "cards"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 4
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "cards"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "kanban-column",
									"title": "Kanban Column",
									"details": "Column name: {name}\nCards: {cards}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "kanban-column",
	"source": {
		"kind": "archetype",
		"archetype": "kanban",
		"variant": "column",
		"tranche": 2
	}
}
