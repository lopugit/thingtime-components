									"XP remaining ",
									{
										"tag": "input",
										"props": {
											"aria-label": "XP remaining",
											"value": {
												"ttArg": "xp"
											},
											"maxLength": 10,
											"style": {
												"width": "100%",
												"minWidth": 0,
