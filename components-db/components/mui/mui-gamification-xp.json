										"borderColor": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1976d2",
													"success": "#2e7d32",
													"warning": "#ed6c02",
													"danger": "#d32f2f",
													"info": "#0288d1",
													"neutral": "#616161"
