{
	"slug": "mui-date-time-countdown",
	"name": "Event Countdown",
	"library": "mui",
	"category": "forms",
	"description": "Event countdown in the Material UI style — days, hours and minutes as big numbers in quiet tiles with unit captions, above the event name. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"countdown",
		"timer",
		"event",
		"time"
	],
	"args": [
		{
			"name": "event",
			"type": "string",
			"default": "Launch day",
			"label": "Event name",
			"maxLength": 40
		},
		{
			"name": "days",
			"type": "string",
			"default": "03",
			"label": "Days",
			"maxLength": 3
		},
		{
			"name": "hours",
			"type": "string",
			"default": "12",
			"label": "Hours",
			"maxLength": 2
		},
		{
			"name": "mins",
			"type": "string",
			"default": "45",
			"label": "Minutes",
			"maxLength": 2
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "seconds",
			"type": "number",
			"default": 60,
			"min": 1,
			"max": 604800,
			"label": "Duration in seconds"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"borderRadius": "4px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "h3",
						"children": [
							"{event}"
						]
					},
					{
						"tag": "label",
						"children": [
							"Duration in seconds",
							{
								"tag": "input",
								"props": {
									"type": "number",
									"aria-label": "seconds",
									"value": {
										"ttArg": "seconds"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"min": 1,
									"max": 604800
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "seconds"
								}
							}
						]
					},
					{
						"tag": "tt-countdown",
						"props": {
							"value": "{seconds}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Duration in seconds ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Duration in seconds",
											"value": {
												"ttArg": "seconds"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 604800
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "seconds"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Event name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Event name",
											"value": {
												"ttArg": "event"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "event"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Days ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Days",
											"value": {
												"ttArg": "days"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "days"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Hours ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Hours",
											"value": {
												"ttArg": "hours"
											},
											"maxLength": 2,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "hours"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Minutes ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Minutes",
											"value": {
												"ttArg": "mins"
											},
											"maxLength": 2,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "mins"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "date-time-countdown",
									"title": "Event Countdown",
									"details": "Event name: {event}\nDays: {days}\nHours: {hours}\nMinutes: {mins}\nDuration in seconds: {seconds}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "date-time-countdown",
	"source": {
		"kind": "archetype",
		"archetype": "date-time",
		"variant": "countdown",
		"tranche": 2
	}
}
