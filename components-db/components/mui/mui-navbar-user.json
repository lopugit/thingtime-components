{
	"slug": "mui-navbar-user",
	"name": "Account Navbar",
	"library": "mui",
	"category": "navigation",
	"description": "Account navigation bar in the Material UI style — brand on the left and an avatar with name, role, and a disclosure chevron on the right. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"navbar",
		"account",
		"avatar",
		"header"
	],
	"args": [
		{
			"name": "brand",
			"type": "string",
			"default": "Acme",
			"label": "Brand",
			"maxLength": 24
		},
		{
			"name": "name",
			"type": "string",
			"default": "Jamie Chen",
			"label": "Name",
			"maxLength": 30
		},
		{
			"name": "initials",
			"type": "string",
			"default": "JC",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "role",
			"type": "string",
			"default": "Product lead",
			"label": "Role",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "nav",
				"props": {
					"style": {
						"display": "flex",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"borderRadius": "4px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"minWidth": 0,
						"maxWidth": "100%",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "strong",
						"children": [
							"{brand}"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Home"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/things",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Things"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/components",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Components"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/builder/demos",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Demos"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Brand ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Brand",
											"value": {
												"ttArg": "brand"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "brand"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Name",
											"value": {
												"ttArg": "name"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "name"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Role ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Role",
											"value": {
												"ttArg": "role"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "role"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "navbar-user",
									"title": "Account Navbar",
									"details": "Brand: {brand}\nName: {name}\nInitials: {initials}\nRole: {role}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "navbar-user",
	"source": {
		"kind": "archetype",
		"archetype": "navbar",
		"variant": "user",
		"tranche": 1
	}
}
