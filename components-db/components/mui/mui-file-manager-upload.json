{
	"slug": "mui-file-manager-upload",
	"name": "Upload Dropzone",
	"library": "mui",
	"category": "files",
	"description": "Drag-and-drop upload zone in the Material UI style — dashed border, tinted upload badge, and a browse link, with an optional in-flight file row driving a live percent progress bar. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"upload",
		"dropzone",
		"files",
		"progress"
	],
	"args": [
		{
			"name": "uploading",
			"type": "boolean",
			"default": true,
			"label": "Uploading"
		},
		{
			"name": "fileName",
			"type": "string",
			"default": "photos.zip",
			"label": "File name",
			"maxLength": 30
		},
		{
			"name": "percent",
			"type": "number",
			"default": 64,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "hint",
			"type": "string",
			"default": "PNG, JPG or ZIP up to 25 MB",
			"label": "Hint",
			"maxLength": 60
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"borderRadius": "4px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "tt-upload",
						"props": {
							"name": "file",
							"title": "Upload a file"
						}
					},
					{
						"tag": "small",
						"children": [
							"Choose a file and confirm the upload. It is saved to your attachments."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Uploading ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Uploading",
											"type": "checkbox",
											"checked": {
												"ttArg": "uploading"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "uploading"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"File name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "File name",
											"value": {
												"ttArg": "fileName"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "fileName"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Percent ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Percent",
											"value": {
												"ttArg": "percent"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 100
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "percent"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Hint ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Hint",
											"value": {
												"ttArg": "hint"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "hint"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "file-manager-upload",
									"title": "Upload Dropzone",
									"details": "Uploading: {uploading}\nFile name: {fileName}\nPercent: {percent}\nHint: {hint}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "file-manager-upload",
	"source": {
		"kind": "archetype",
		"archetype": "file-manager",
		"variant": "upload",
		"tranche": 2
	}
}
