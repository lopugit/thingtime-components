{
	"slug": "mui-modal-drawer-drawer",
	"name": "Side Drawer",
	"library": "mui",
	"category": "overlays",
	"description": "Right-side drawer panel over a dimmed backdrop in the Material UI style — flush to the edge with rounded inner corners, a titled header, and a tone-highlighted menu. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"drawer",
		"panel",
		"overlay",
		"navigation"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Workspace settings",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "item",
			"type": "string",
			"default": "Menu item",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "items",
			"type": "number",
			"default": 4,
			"label": "Items",
			"min": 1,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "tt-dialog",
				"props": {
					"title": "{title}",
					"name": "Open drawer",
					"type": "drawer"
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "grid",
								"gap": "12px",
								"padding": "16px",
								"border": "1px solid rgba(0, 0, 0, 0.12)",
								"borderRadius": "4px",
								"background": "#ffffff",
								"color": "rgba(0, 0, 0, 0.87)",
								"minWidth": 0,
								"maxWidth": "100%"
							}
						},
						"children": [
							{
								"tag": "p",
								"children": [
									"Edit the values below and save a private draft. No external changes are made."
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Item label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Item label",
											"value": {
												"ttArg": "item"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "item"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Items ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Items",
											"value": {
												"ttArg": "items"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 6
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "items"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "modal-drawer-drawer",
									"title": "Side Drawer",
									"details": "Title: {title}\nItem label: {item}\nItems: {items}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "modal-drawer-drawer",
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "drawer",
		"tranche": 1
	}
}
