{
	"slug": "mui-settings-row",
	"name": "Settings Row",
	"library": "mui",
	"category": "settings",
	"description": "Single preference row in the Material UI style — title and helper caption on the left, a tone-tracked switch on the right, hairline dividers above and below. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"settings",
		"row",
		"switch",
		"preference"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Email notifications",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "caption",
			"type": "string",
			"default": "Get a digest of workspace activity",
			"label": "Caption",
			"maxLength": 80
		},
		{
			"name": "enabled",
			"type": "boolean",
			"default": true,
			"label": "Enabled"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"width": "320px",
						"boxSizing": "border-box",
						"justifyContent": "space-between",
						"gap": "16px",
						"padding": "12px 4px",
						"background": "#ffffff",
						"borderTopWidth": "1px",
						"borderTopStyle": "solid",
						"borderTopColor": "rgba(0, 0, 0, 0.08)",
						"borderBottomWidth": "1px",
						"borderBottomStyle": "solid",
						"borderBottomColor": "rgba(0, 0, 0, 0.08)",
						"maxWidth": "100%",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px",
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "13px",
										"fontWeight": 500,
										"color": "rgba(0, 0, 0, 0.87)"
									}
								},
								"children": [
									"{title}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "rgba(0, 0, 0, 0.6)"
									}
								},
								"children": [
									"{caption}"
								]
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"style": {
								"width": "36px",
								"height": "20px",
								"padding": "3px",
								"boxSizing": "border-box",
								"borderRadius": "999px",
								"background": {
									"ttIf": {
										"arg": "enabled",
										"then": "#1976d2",
										"else": "rgba(0, 0, 0, 0.38)"
									}
								},
								"display": "flex",
								"alignItems": "center",
								"justifyContent": {
									"ttIf": {
										"arg": "enabled",
										"then": "flex-end",
										"else": "flex-start"
									}
								},
								"flexShrink": 0,
								"maxWidth": "100%",
								"flexWrap": "wrap"
							},
							"type": "button",
							"aria-label": "enabled",
							"aria-pressed": {
								"ttArg": "enabled"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "14px",
										"height": "14px",
										"borderRadius": "999px",
										"background": "#ffffff",
										"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								}
							}
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "toggle",
							"key": "enabled"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Enabled ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Enabled",
											"type": "checkbox",
											"checked": {
												"ttArg": "enabled"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "enabled"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Caption ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Caption",
											"value": {
												"ttArg": "caption"
											},
											"maxLength": 80,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "caption"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "settings-row",
									"title": "Settings Row",
									"details": "Title: {title}\nCaption: {caption}\nEnabled: {enabled}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "settings-row",
	"source": {
		"kind": "archetype",
		"archetype": "settings",
		"variant": "row",
		"tranche": 2
	}
}
