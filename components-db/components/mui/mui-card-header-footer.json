{
	"slug": "mui-card-header-footer",
	"name": "Header & Footer Card",
	"library": "mui",
	"category": "layout",
	"description": "Three-part card in the Material UI style — bordered header and footer bands around a padded body, with an optional tinted footer. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"card",
		"header",
		"footer",
		"sections"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Weekly report",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Everything shipped this week, grouped by team and sorted by impact.",
			"label": "Body",
			"maxLength": 500
		},
		{
			"name": "footer",
			"type": "string",
			"default": "Updated 2 days ago",
			"label": "Footer",
			"maxLength": 60
		},
		{
			"name": "tintedFooter",
			"type": "boolean",
			"default": true,
			"label": "Tinted footer"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"width": "300px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"borderRadius": "4px",
						"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
						"overflow": "hidden",
						"boxSizing": "border-box",
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "12px 16px",
								"borderBottom": "1px solid rgba(0, 0, 0, 0.08)"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "16px",
										"fontWeight": 500,
										"color": "rgba(0, 0, 0, 0.87)"
									}
								},
								"children": [
									"{title}"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "16px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "13px",
										"color": "rgba(0, 0, 0, 0.6)",
										"lineHeight": 1.5
									}
								},
								"children": [
									"{body}"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"ttMerge": [
									{
										"padding": "10px 16px",
										"borderTop": "1px solid rgba(0, 0, 0, 0.08)",
										"fontSize": "12px",
										"color": "rgba(0, 0, 0, 0.6)"
									},
									{
										"ttIf": {
											"arg": "tintedFooter",
											"then": {
												"background": "#fafafa"
											},
											"else": {}
										}
									}
								]
							}
						},
						"children": [
							"{footer}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Body ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Body",
											"value": {
												"ttArg": "body"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "body"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Footer ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Footer",
											"value": {
												"ttArg": "footer"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "footer"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Tinted footer ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Tinted footer",
											"type": "checkbox",
											"checked": {
												"ttArg": "tintedFooter"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tintedFooter"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "card-header-footer",
									"title": "Header & Footer Card",
									"details": "Title: {title}\nBody: {body}\nFooter: {footer}\nTinted footer: {tintedFooter}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "card-header-footer",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "header-footer",
		"tranche": 1
	}
}
