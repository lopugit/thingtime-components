{
	"slug": "mui-list-numbered",
	"name": "Numbered List",
	"library": "mui",
	"category": "data-display",
	"description": "Ordered list in the Material UI style — hand-styled number markers (pill chips) on a tone tint beside each row. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"list",
		"numbered",
		"ordered",
		"steps"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "Step",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Rows",
			"min": 1,
			"max": 8
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "divided",
			"type": "boolean",
			"default": true,
			"label": "Dividers"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "ol",
				"props": {
					"style": {
						"ttMerge": [
							{
								"listStyle": "none",
								"margin": 0,
								"padding": 0,
								"width": "280px",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"color": "rgba(0, 0, 0, 0.87)",
								"background": "#ffffff",
								"borderRadius": "4px",
								"overflow": "hidden",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							},
							{
								"border": "1px solid rgba(0, 0, 0, 0.12)",
								"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)"
							}
						]
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "count",
							"max": 8,
							"node": {
								"tag": "li",
								"props": {
									"style": {
										"ttMerge": [
											{
												"display": "flex",
												"alignItems": "center",
												"gap": "12px",
												"padding": "10px 14px",
												"fontSize": "14px",
												"flexWrap": "wrap"
											},
											{
												"ttIf": {
													"arg": "divided",
													"then": {
														"ttIf": {
															"arg": "n",
															"equals": 1,
															"then": {},
															"else": {
																"borderTop": "1px solid rgba(0, 0, 0, 0.08)"
															}
														}
													},
													"else": {}
												}
											}
										]
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "24px",
												"height": "24px",
												"borderRadius": "999px",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#e3f2fd",
															"success": "#edf7ed",
															"warning": "#fff4e5",
															"danger": "#fdeded",
															"info": "#e5f6fd",
															"neutral": "#eeeeee"
														},
														"default": "#e3f2fd"
													}
												},
												"color": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#1565c0",
															"success": "#1e4620",
															"warning": "#663c00",
															"danger": "#5f2120",
															"info": "#014361",
															"neutral": "#424242"
														},
														"default": "#1565c0"
													}
												},
												"display": "flex",
												"alignItems": "center",
												"justifyContent": "center",
												"fontSize": "12px",
												"fontWeight": 700,
												"flexShrink": 0,
												"maxWidth": "100%",
												"boxSizing": "border-box",
												"flexWrap": "wrap"
											}
										},
										"children": [
											"{n}"
										]
									},
									"{item} {n}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Item label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Item label",
											"value": {
												"ttArg": "item"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "item"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Rows ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Rows",
											"value": {
												"ttArg": "count"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 8
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "count"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Dividers ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Dividers",
											"type": "checkbox",
											"checked": {
												"ttArg": "divided"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "divided"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "list-numbered",
									"title": "Numbered List",
									"details": "Item label: {item}\nRows: {count}\nDividers: {divided}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "list-numbered",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "numbered",
		"tranche": 1
	}
}
