						"tag": "button",
						"props": {
							"type": "button"
						},
						"children": [
							"Show again"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "uiDismissed",
							"value": false
						}
					},
