{
	"slug": "mui-onboarding-welcome",
	"name": "Welcome Card",
	"library": "mui",
	"category": "onboarding",
	"description": "First-run welcome card in the Material UI style — a zap emblem in a tone circle over a personal greeting, supporting copy, primary CTA and a quiet skip link. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"onboarding",
		"welcome",
		"first-run",
		"card"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex",
			"label": "Name",
			"maxLength": 24
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Your workspace is ready. Take the two-minute tour to get the most out of it.",
			"label": "Subtext",
			"maxLength": 160
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Get started",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "uiDismissed",
			"type": "boolean",
			"default": false
		}
