{
	"slug": "mui-avatar-initials",
	"name": "Initials Avatar",
	"library": "mui",
	"category": "data-display",
	"description": "Circular initials avatar in the Material UI style — tone-filled disc with library type, optional soft tint and a surface-offset ring. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"avatar",
		"initials",
		"profile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "NF",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		},
		{
			"name": "ring",
			"type": "boolean",
			"default": false,
			"label": "Ring"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontWeight": 500,
								"borderRadius": "999px",
								"flexShrink": 0,
								"userSelect": "none",
								"flexWrap": "wrap"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"width": "28px",
											"height": "28px",
											"fontSize": "12px"
										},
										"md": {
											"width": "40px",
											"height": "40px",
											"fontSize": "13px"
										},
										"lg": {
											"width": "56px",
											"height": "56px",
											"fontSize": "16px"
										}
									},
									"default": {
										"width": "40px",
										"height": "40px",
										"fontSize": "13px"
									}
								}
							},
							{
								"ttIf": {
									"arg": "soft",
									"then": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e3f2fd",
													"success": "#edf7ed",
													"warning": "#fff4e5",
													"danger": "#fdeded",
													"info": "#e5f6fd",
													"neutral": "#eeeeee"
												},
												"default": "#e3f2fd"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1565c0",
													"success": "#1e4620",
													"warning": "#663c00",
													"danger": "#5f2120",
													"info": "#014361",
													"neutral": "#424242"
												},
												"default": "#1565c0"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #90caf9",
													"success": "1px solid #a5d6a7",
													"warning": "1px solid #ffb74d",
													"danger": "1px solid #ef9a9a",
													"info": "1px solid #81d4fa",
													"neutral": "1px solid #bdbdbd"
												},
												"default": "1px solid #90caf9"
											}
										}
									},
									"else": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1976d2",
													"success": "#2e7d32",
													"warning": "#ed6c02",
													"danger": "#d32f2f",
													"info": "#0288d1",
													"neutral": "#616161"
												},
												"default": "#1976d2"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									}
								}
							},
							{
								"ttIf": {
									"arg": "ring",
									"then": {
										"boxShadow": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "0 0 0 2px #ffffff, 0 0 0 4px #90caf9",
													"success": "0 0 0 2px #ffffff, 0 0 0 4px #a5d6a7",
													"warning": "0 0 0 2px #ffffff, 0 0 0 4px #ffb74d",
													"danger": "0 0 0 2px #ffffff, 0 0 0 4px #ef9a9a",
													"info": "0 0 0 2px #ffffff, 0 0 0 4px #81d4fa",
													"neutral": "0 0 0 2px #ffffff, 0 0 0 4px #bdbdbd"
												},
												"default": "0 0 0 2px #ffffff, 0 0 0 4px #90caf9"
											}
										}
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					"{initials}"
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid rgba(0, 0, 0, 0.12)",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Soft tint ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Soft tint",
											"type": "checkbox",
											"checked": {
												"ttArg": "soft"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "soft"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid rgba(0, 0, 0, 0.12)",
										"borderRadius": "4px",
										"background": "#fafafa",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "avatar-initials",
									"title": "Initials Avatar",
									"details": "Initials: {initials}\nSoft tint: {soft}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "avatar-initials",
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "initials",
		"tranche": 1
	}
}
