{
	"slug": "reactflow-timeline-activity",
	"name": "Activity Feed Timeline",
	"library": "reactflow",
	"category": "data-display",
	"description": "Activity feed timeline in the React Flow style — initials avatars as markers, a bold actor name before each action, faint timestamps below. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"timeline",
		"activity",
		"feed",
		"avatar"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex Rivers",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "action",
			"type": "string",
			"default": "commented on your post",
			"label": "Action",
			"maxLength": 60
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Entries",
			"min": 1,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "ul",
				"props": {
					"style": {
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"display": "flex",
						"flexDirection": "column",
						"color": "#1a192b",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "count",
							"max": 6,
							"node": {
								"tag": "li",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "stretch",
										"gap": "14px",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"flexDirection": "column",
												"alignItems": "center",
												"width": "30px",
												"flexShrink": 0,
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "div",
												"props": {
													"style": {
														"width": "30px",
														"height": "30px",
														"borderRadius": "999px",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#f4f4f5",
																	"success": "#f0fdf4",
																	"warning": "#fefce8",
																	"danger": "#ffe4f1",
																	"info": "#f1ecfd",
																	"neutral": "#f4f4f5"
																},
																"default": "#f4f4f5"
															}
														},
														"color": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#1a192b",
																	"success": "#15803d",
																	"warning": "#a16207",
																	"danger": "#c00055",
																	"info": "#5b21b6",
																	"neutral": "#3f3e4a"
																},
																"default": "#1a192b"
															}
														},
														"display": "flex",
														"alignItems": "center",
														"justifyContent": "center",
														"fontWeight": 600,
														"fontSize": "10px",
														"flexShrink": 0,
														"maxWidth": "100%",
														"boxSizing": "border-box",
														"flexWrap": "wrap"
													}
												},
												"children": [
													"{initials}"
												]
											},
											{
												"tag": "div",
												"props": {
													"style": {
														"width": "2px",
														"flexGrow": 1,
														"minHeight": "14px",
														"marginTop": "4px",
														"borderRadius": "999px",
														"background": "repeating-linear-gradient(to bottom, #b1b1b7 0px, #b1b1b7 4px, transparent 4px, transparent 8px)",
														"maxWidth": "100%",
														"boxSizing": "border-box"
													}
												}
											}
										]
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"flexDirection": "column",
												"gap": "2px",
												"paddingBottom": "18px",
												"minWidth": 0
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontSize": "12px",
														"lineHeight": 1.5,
														"marginTop": "5px"
													}
												},
												"children": [
													{
														"tag": "strong",
														"props": {
															"style": {
																"fontWeight": 600
															}
														},
														"children": [
															"{name}"
														]
													},
													" {action}"
												]
											},
											{
												"tag": "span",
												"props": {
													"style": {
														"color": "#b1b1b7",
														"fontSize": "10px"
													}
												},
												"children": [
													"{n}h ago"
												]
											}
										]
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Name",
											"value": {
												"ttArg": "name"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "name"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Action ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Action",
											"value": {
												"ttArg": "action"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "action"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Entries ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Entries",
											"value": {
												"ttArg": "count"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 6
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "count"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "timeline-activity",
									"title": "Activity Feed Timeline",
									"details": "Name: {name}\nInitials: {initials}\nAction: {action}\nEntries: {count}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "timeline-activity",
	"source": {
		"kind": "archetype",
		"archetype": "timeline",
		"variant": "activity",
		"tranche": 1
	}
}
