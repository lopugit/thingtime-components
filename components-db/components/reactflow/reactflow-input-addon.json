{
	"slug": "reactflow-input-addon",
	"name": "Addon Input",
	"library": "reactflow",
	"category": "forms",
	"description": "Text field with a prefix addon segment in the React Flow style — a tinted https:// block divided from the input by the library border. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"input",
		"addon",
		"prefix",
		"url",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Website",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "addon",
			"type": "string",
			"default": "https://",
			"label": "Addon",
			"maxLength": 20
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "example.com",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "entry1",
			"type": "string",
			"default": "",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "6px",
						"width": "280px",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "label",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 500,
								"color": "#1a192b"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "stretch",
										"border": "1px solid #e2e2e5",
										"borderRadius": "5px",
										"background": "#ffffff",
										"overflow": "hidden",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									},
									{
										"ttMap": {
											"arg": "size",
											"values": {
												"sm": {
													"height": "24px",
													"fontSize": "12px"
												},
												"md": {
													"height": "30px",
													"fontSize": "12px"
												},
												"lg": {
													"height": "38px",
													"fontSize": "14px"
												}
											},
											"default": {
												"height": "30px",
												"fontSize": "12px"
											}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"padding": "0 12px",
										"background": "#f4f4f5",
										"borderRight": "1px solid #e2e2e5",
										"color": "#6f6e77",
										"flexShrink": 0,
										"flexWrap": "wrap"
									}
								},
								"children": [
									"{addon}"
								]
							},
							{
								"tag": "input",
								"props": {
									"type": "text",
									"placeholder": "{placeholder}",
									"style": {
										"flex": 1,
										"minWidth": 0,
										"border": "none",
										"outline": "none",
										"background": "transparent",
										"padding": "0 12px",
										"color": "#1a192b",
										"fontSize": "inherit"
									},
									"value": {
										"ttArg": "entry1"
									},
									"aria-label": "{placeholder}",
									"maxLength": 500
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "entry1"
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"entry1 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "entry1",
											"value": {
												"ttArg": "entry1"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "entry1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Addon ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Addon",
											"value": {
												"ttArg": "addon"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "addon"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "input-addon",
									"title": "Addon Input",
									"details": "Label: {label}\nAddon: {addon}\nentry1: {entry1}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "input-addon",
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "addon",
		"tranche": 1
	}
}
