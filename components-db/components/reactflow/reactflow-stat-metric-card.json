{
	"slug": "reactflow-stat-metric-card",
	"name": "Stat Card",
	"library": "reactflow",
	"category": "data-display",
	"description": "Single-metric stat card in the React Flow style — quiet label, large tabular value, and a tinted delta pill on React Flow surface, border, and radius tokens. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"stat",
		"metric",
		"card",
		"kpi"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Monthly revenue",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "$48,210",
			"label": "Value",
			"maxLength": 20
		},
		{
			"name": "delta",
			"type": "string",
			"default": "+12.4%",
			"label": "Delta",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "inline-flex",
						"flexDirection": "column",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#e2e2e5",
						"borderRadius": "8px",
						"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
						"boxSizing": "border-box",
						"padding": "16px 20px",
						"gap": "6px",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"fontWeight": 400,
								"color": "#6f6e77"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "24px",
								"fontWeight": 600,
								"color": "#1a192b",
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{value}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px",
								"marginTop": "2px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"fontSize": "10px",
										"fontWeight": 600,
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f4f4f5",
													"success": "#f0fdf4",
													"warning": "#fefce8",
													"danger": "#ffe4f1",
													"info": "#f1ecfd",
													"neutral": "#f4f4f5"
												},
												"default": "#f0fdf4"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1a192b",
													"success": "#15803d",
													"warning": "#a16207",
													"danger": "#c00055",
													"info": "#5b21b6",
													"neutral": "#3f3e4a"
												},
												"default": "#15803d"
											}
										},
										"flexWrap": "wrap"
									}
								},
								"children": [
									"{delta}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "10px",
										"color": "#b1b1b7"
									}
								},
								"children": [
									"vs last month"
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Value ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Value",
											"value": {
												"ttArg": "value"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "value"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Delta ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Delta",
											"value": {
												"ttArg": "delta"
											},
											"maxLength": 12,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "delta"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "stat-metric-card",
									"title": "Stat Card",
									"details": "Label: {label}\nValue: {value}\nDelta: {delta}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "stat-metric-card",
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "card",
		"tranche": 1
	}
}
