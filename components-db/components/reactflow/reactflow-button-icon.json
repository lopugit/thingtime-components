{
	"slug": "reactflow-button-icon",
	"name": "Icon Button",
	"library": "reactflow",
	"category": "buttons",
	"description": "Button with a leading icon in the React Flow style — a plus glyph beside the label, optional icon-only square mode. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"button",
		"action",
		"icon"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "New item",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "iconOnly",
			"type": "boolean",
			"default": false,
			"label": "Icon only"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"borderRadius": "5px",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 500,
								"cursor": "pointer",
								"flexWrap": "wrap"
							},
							{
								"height": "30px",
								"fontSize": "12px",
								"padding": {
									"ttIf": {
										"arg": "iconOnly",
										"then": "0",
										"else": "0 16px"
									}
								},
								"width": {
									"ttIf": {
										"arg": "iconOnly",
										"then": "30px",
										"else": "auto"
									}
								},
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							},
							{
								"ttIf": {
									"arg": "disabled",
									"then": {
										"opacity": 0.5,
										"cursor": "not-allowed"
									},
									"else": {}
								}
							},
							{
								"width": "auto",
								"height": "auto",
								"minWidth": 0,
								"padding": "8px 12px",
								"whiteSpace": "normal",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							}
						]
					},
					"disabled": {
						"ttArg": "disabled"
					},
					"aria-label": "{actionLabel}"
				},
				"children": [
					"{actionLabel}"
				],
				"ttAction": "{actionKey}",
				"ttActionInputs": {
					"family": "button-icon",
					"title": "Icon Button",
					"details": "Label: {label}"
				}
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "button-icon",
									"title": "Icon Button",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "button-icon",
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "icon",
		"tranche": 1
	}
}
