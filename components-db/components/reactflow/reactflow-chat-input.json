{
	"slug": "reactflow-chat-input",
	"name": "Message Composer",
	"library": "reactflow",
	"category": "messaging",
	"description": "Chat composer bar in the React Flow style — attach button, crisp text field with placeholder, and a tone-solid action that flips between send and mic. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"chat",
		"composer",
		"input",
		"send"
	],
	"args": [
		{
			"name": "placeholder",
			"type": "string",
			"default": "Type a message…",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "send",
			"type": "boolean",
			"default": true,
			"label": "Ready to send"
		},
		{
			"name": "attach",
			"type": "boolean",
			"default": true,
			"label": "Show attach"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save draft",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "entry1",
			"type": "string",
			"default": "",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"width": "320px",
						"maxWidth": "100%",
						"boxSizing": "border-box",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "attach",
							"then": {
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"width": "auto",
										"height": "auto",
										"flexShrink": 0,
										"border": "none",
										"borderRadius": "3px",
										"cursor": "pointer",
										"background": "transparent",
										"color": "#6f6e77",
										"maxWidth": "100%",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									},
									"aria-label": "{actionLabel}"
								},
								"children": [
									"{actionLabel}"
								],
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "chat-input",
									"title": "Message Composer",
									"details": "Ready to send: {send}\nShow attach: {attach}\nentry1: {entry1}"
								}
							}
						}
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"placeholder": "{placeholder}",
							"style": {
								"flex": 1,
								"minWidth": 0,
								"height": "36px",
								"boxSizing": "border-box",
								"padding": "0 14px",
								"background": "#f4f4f5",
								"color": "#1a192b",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#1a192b",
								"borderRadius": "3px",
								"fontSize": "12px",
								"outline": "none",
								"boxShadow": "none"
							},
							"value": {
								"ttArg": "entry1"
							},
							"aria-label": "{placeholder}",
							"maxLength": 500
						},
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "entry1"
						}
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"width": "auto",
								"height": "auto",
								"flexShrink": 0,
								"border": "none",
								"borderRadius": "3px",
								"cursor": "pointer",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"maxWidth": "100%",
								"minWidth": 0,
								"padding": "8px 12px",
								"whiteSpace": "normal",
								"boxSizing": "border-box",
								"flexWrap": "wrap"
							},
							"aria-label": "{actionLabel}"
						},
						"children": [
							"{actionLabel}"
						],
						"ttAction": "{actionKey}",
						"ttActionInputs": {
							"family": "chat-input",
							"title": "Message Composer",
							"details": "Ready to send: {send}\nShow attach: {attach}\nentry1: {entry1}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"entry1 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "entry1",
											"value": {
												"ttArg": "entry1"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "entry1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Ready to send ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Ready to send",
											"type": "checkbox",
											"checked": {
												"ttArg": "send"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "send"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Show attach ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Show attach",
											"type": "checkbox",
											"checked": {
												"ttArg": "attach"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "attach"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "chat-input",
									"title": "Message Composer",
									"details": "Ready to send: {send}\nShow attach: {attach}\nentry1: {entry1}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			},
			{
				"tag": "small",
				"children": [
					"Draft only. Saving creates a private Thing. External effects require a configured Action."
				]
			}
		]
	},
	"version": 2,
	"familyKey": "chat-input",
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "input",
		"tranche": 2
	}
}
