{
	"slug": "reactflow-search-command-search-bar",
	"name": "Search Bar",
	"library": "reactflow",
	"category": "forms",
	"description": "Search bar in the React Flow style — bordered input with a leading magnifier glyph and editable placeholder beside a solid tone search button. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"search",
		"input",
		"form",
		"bar"
	],
	"args": [
		{
			"name": "placeholder",
			"type": "string",
			"default": "Search anything…",
			"label": "Placeholder",
			"maxLength": 40
		},
		{
			"name": "buttonLabel",
			"type": "string",
			"default": "Search",
			"label": "Button label",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "searchQuery",
			"type": "string",
			"default": "",
			"maxLength": 200
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #1a192b",
						"borderRadius": "5px",
						"background": "#ffffff",
						"color": "#1a192b",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Search Things",
							{
								"tag": "input",
								"props": {
									"type": "search",
									"aria-label": "searchQuery",
									"value": {
										"ttArg": "searchQuery"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #1a192b",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "searchQuery"
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "3px",
								"border": "1px solid #1a192b",
								"background": "#f4f4f5",
								"cursor": "pointer"
							}
						},
						"children": [
							"Search Things"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "search",
							"value": "{searchQuery}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"searchQuery ",
									{
										"tag": "input",
										"props": {
											"aria-label": "searchQuery",
											"value": {
												"ttArg": "searchQuery"
											},
											"maxLength": 200,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "searchQuery"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Button label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Button label",
											"value": {
												"ttArg": "buttonLabel"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "buttonLabel"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "search-command-search-bar",
									"title": "Search Bar",
									"details": "Button label: {buttonLabel}\nsearchQuery: {searchQuery}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "search-command-search-bar",
	"source": {
		"kind": "archetype",
		"archetype": "search-command",
		"variant": "search-bar",
		"tranche": 2
	}
}
