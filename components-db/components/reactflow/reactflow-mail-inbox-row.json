{
	"slug": "reactflow-mail-inbox-row",
	"name": "Inbox Row",
	"library": "reactflow",
	"category": "communication",
	"description": "Mail list row in the React Flow style — unread dot and bold sender on a fresh message, subject with muted snippet on one ellipsized line, time and star on the right. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"mail",
		"inbox",
		"list",
		"row",
		"email"
	],
	"args": [
		{
			"name": "unread",
			"type": "boolean",
			"default": true,
			"label": "Unread"
		},
		{
			"name": "sender",
			"type": "string",
			"default": "Ada Lovelace",
			"label": "Sender",
			"maxLength": 32
		},
		{
			"name": "subject",
			"type": "string",
			"default": "Q3 forecast review",
			"label": "Subject",
			"maxLength": 48
		},
		{
			"name": "snippet",
			"type": "string",
			"default": "Sharing the updated numbers ahead of tomorrow",
			"label": "Snippet",
			"maxLength": 80
		},
		{
			"name": "time",
			"type": "string",
			"default": "9:41 AM",
			"label": "Time",
			"maxLength": 12
		},
		{
			"name": "starred",
			"type": "boolean",
			"default": false,
			"label": "Starred"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save draft",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"width": "100%",
						"maxWidth": "100%",
						"boxSizing": "border-box",
						"padding": "10px 14px",
						"background": {
							"ttIf": {
								"arg": "unread",
								"then": "#ffffff",
								"else": "#f4f4f5"
							}
						},
						"borderBottom": "1px solid #e2e2e5",
						"flexWrap": "wrap"
					},
					"type": "button",
					"aria-label": "Ada Lovelace Q3 forecast review  — Sharing the updated numbers ahead of tomorrow 9:41 AM",
					"aria-pressed": {
						"ttArg": "unread"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "8px",
								"height": "8px",
								"borderRadius": "999px",
								"background": {
									"ttIf": {
										"arg": "unread",
										"then": "#ff0072",
										"else": "transparent"
									}
								},
								"flexShrink": 0,
								"maxWidth": "100%",
								"boxSizing": "border-box"
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "104px",
								"flexShrink": 0,
								"fontSize": "12px",
								"fontWeight": {
									"ttIf": {
										"arg": "unread",
										"then": 700,
										"else": 500
									}
								},
								"color": {
									"ttIf": {
										"arg": "unread",
										"then": "#1a192b",
										"else": "#6f6e77"
									}
								},
								"whiteSpace": "nowrap",
								"overflow": "hidden",
								"textOverflow": "ellipsis",
								"maxWidth": "100%"
							}
						},
						"children": [
							"{sender}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"minWidth": 0,
								"whiteSpace": "nowrap",
								"overflow": "hidden",
								"textOverflow": "ellipsis",
								"fontSize": "12px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontWeight": {
											"ttIf": {
												"arg": "unread",
												"then": 600,
												"else": 400
											}
										},
										"color": "#1a192b"
									}
								},
								"children": [
									"{subject}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"color": "#6f6e77"
									}
								},
								"children": [
									" — {snippet}"
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"flexShrink": 0,
								"fontSize": "10px",
								"fontWeight": {
									"ttIf": {
										"arg": "unread",
										"then": 600,
										"else": 400
									}
								},
								"color": {
									"ttIf": {
										"arg": "unread",
										"then": "#ff0072",
										"else": "#6f6e77"
									}
								}
							}
						},
						"children": [
							"{time}"
						]
					},
					{
						"ttIf": {
							"arg": "starred",
							"then": {
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "#eab308",
									"stroke": "#eab308",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							},
							"else": {
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "#b1b1b7",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							}
						}
					}
				],
				"ttAction": "$ui",
				"ttActionInputs": {
					"op": "toggle",
					"key": "unread"
				}
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Unread ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Unread",
											"type": "checkbox",
											"checked": {
												"ttArg": "unread"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "unread"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Sender ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Sender",
											"value": {
												"ttArg": "sender"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "sender"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Subject ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Subject",
											"value": {
												"ttArg": "subject"
											},
											"maxLength": 48,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "subject"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Snippet ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Snippet",
											"value": {
												"ttArg": "snippet"
											},
											"maxLength": 80,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "snippet"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Time ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Time",
											"value": {
												"ttArg": "time"
											},
											"maxLength": 12,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "time"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Starred ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Starred",
											"type": "checkbox",
											"checked": {
												"ttArg": "starred"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "starred"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "mail-inbox-row",
									"title": "Inbox Row",
									"details": "Unread: {unread}\nSender: {sender}\nSubject: {subject}\nSnippet: {snippet}\nTime: {time}\nStarred: {starred}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			},
			{
				"tag": "small",
				"children": [
					"Draft only. Saving creates a private Thing. External effects require a configured Action."
				]
			}
		]
	},
	"version": 2,
	"familyKey": "mail-inbox-row",
	"source": {
		"kind": "archetype",
		"archetype": "mail",
		"variant": "inbox-row",
		"tranche": 2
	}
}
