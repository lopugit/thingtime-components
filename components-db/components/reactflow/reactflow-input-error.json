{
	"slug": "reactflow-input-error",
	"name": "Error Input",
	"library": "reactflow",
	"category": "forms",
	"description": "Invalid text field in the React Flow style — danger border with an optional soft error glow, and an alert icon beside the message. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"input",
		"error",
		"invalid",
		"validation",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Email",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "not-an-email",
			"label": "Value",
			"maxLength": 60
		},
		{
			"name": "message",
			"type": "string",
			"default": "Enter a valid email address.",
			"label": "Message",
			"maxLength": 80
		},
		{
			"name": "ring",
			"type": "boolean",
			"default": true,
			"label": "Error ring"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "6px",
						"width": "260px",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "label",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 500,
								"color": "#1a192b"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"value": {
								"ttArg": "value"
							},
							"style": {
								"ttMerge": [
									{
										"width": "100%",
										"padding": "0 12px",
										"border": "1px solid #e2e2e5",
										"borderRadius": "5px",
										"background": "#ffffff",
										"color": "#1a192b",
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"outline": "none",
										"boxSizing": "border-box",
										"maxWidth": "100%"
									},
									{
										"height": "30px",
										"fontSize": "12px",
										"border": "1px solid #ff0072"
									},
									{
										"ttIf": {
											"arg": "ring",
											"then": {
												"boxShadow": "0 0 0 3px #ffe4f1"
											},
											"else": {}
										}
									}
								]
							},
							"aria-label": "value",
							"maxLength": 500
						},
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "value"
						}
					},
					{
						"ttIf": {
							"arg": "message",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "6px",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 13,
											"height": 13,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#ff0072",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "path",
												"props": {
													"d": "M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 12,
													"y1": 9,
													"x2": 12,
													"y2": 13
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 12,
													"y1": 17,
													"x2": 12.01,
													"y2": 17
												}
											}
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "10px",
												"color": "#ff0072"
											}
										},
										"children": [
											"{message}"
										]
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Value ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Value",
											"value": {
												"ttArg": "value"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "value"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Message ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Message",
											"value": {
												"ttArg": "message"
											},
											"maxLength": 80,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "message"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "input-error",
									"title": "Error Input",
									"details": "Label: {label}\nValue: {value}\nMessage: {message}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "input-error",
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "error",
		"tranche": 1
	}
}
