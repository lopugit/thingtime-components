{
	"slug": "reactflow-data-viz-gauge",
	"name": "Gauge",
	"library": "reactflow",
	"category": "data-display",
	"description": "Semicircle gauge in the React Flow style — a soft svg arc track with a tone-colored needle rotated by CSS calc from the percent value, pivot dot, and a big value caption below. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"chart",
		"gauge",
		"meter",
		"kpi"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "CPU load",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "percent",
			"type": "number",
			"default": 64,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "suffix",
			"type": "string",
			"default": "%",
			"label": "Suffix",
			"maxLength": 6
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"width": "188px",
						"boxSizing": "border-box",
						"padding": "14px 16px",
						"background": "#ffffff",
						"border": "1px solid #1a192b",
						"borderRadius": "5px",
						"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
						"alignItems": "center",
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"fontWeight": 600,
								"color": "#6f6e77",
								"textTransform": "uppercase",
								"letterSpacing": "0.05em"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "svg",
						"props": {
							"width": 120,
							"height": 70,
							"viewBox": "0 0 100 58",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "path",
								"props": {
									"d": "M 12 52 A 38 38 0 0 1 88 52",
									"fill": "none",
									"stroke": "#e2e2e5",
									"strokeWidth": 8,
									"strokeLinecap": "round"
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 50,
									"y1": 52,
									"x2": 50,
									"y2": 21,
									"stroke": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#1a192b",
												"success": "#22c55e",
												"warning": "#eab308",
												"danger": "#ff0072",
												"info": "#784be8",
												"neutral": "#6f6e77"
											},
											"default": "#1a192b"
										}
									},
									"strokeWidth": 3,
									"strokeLinecap": "round",
									"style": {
										"transform": "rotate(calc({percent} * 1.8deg - 90deg))",
										"transformOrigin": "50px 52px"
									}
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 50,
									"cy": 52,
									"r": 4.5,
									"fill": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#1a192b",
												"success": "#22c55e",
												"warning": "#eab308",
												"danger": "#ff0072",
												"info": "#784be8",
												"neutral": "#6f6e77"
											},
											"default": "#1a192b"
										}
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"justifyContent": "space-between",
								"width": "120px",
								"fontSize": "10px",
								"color": "#b1b1b7",
								"maxWidth": "100%",
								"boxSizing": "border-box",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "span",
								"children": [
									"0"
								]
							},
							{
								"tag": "span",
								"children": [
									"100"
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"marginTop": "2px",
								"fontSize": "16px",
								"fontWeight": 600,
								"color": "#1a192b"
							}
						},
						"children": [
							"{percent}{suffix}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Percent ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Percent",
											"value": {
												"ttArg": "percent"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 100
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "percent"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Suffix ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Suffix",
											"value": {
												"ttArg": "suffix"
											},
											"maxLength": 6,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "suffix"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "data-viz-gauge",
									"title": "Gauge",
									"details": "Title: {title}\nPercent: {percent}\nSuffix: {suffix}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "data-viz-gauge",
	"source": {
		"kind": "archetype",
		"archetype": "data-viz",
		"variant": "gauge",
		"tranche": 2
	}
}
