{
	"slug": "reactflow-form-flows-signature",
	"name": "Signature Pad",
	"library": "reactflow",
	"category": "forms",
	"description": "Signature capture block in the React Flow style — a crisp ink-outlined pad with an inked squiggle over the baseline rule, Clear action, and an adopt-signature checkbox. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"signature",
		"consent",
		"pad"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Signature",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "date",
			"type": "string",
			"default": "Aug 18, 2026",
			"label": "Date",
			"maxLength": 24
		},
		{
			"name": "signed",
			"type": "boolean",
			"default": true,
			"label": "Signed"
		},
		{
			"name": "adopt",
			"type": "boolean",
			"default": true,
			"label": "Adopt signature"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "signature",
			"type": "string",
			"default": "",
			"maxLength": 200
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #1a192b",
						"borderRadius": "5px",
						"background": "#ffffff",
						"color": "#1a192b",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Typed signature draft",
							{
								"tag": "input",
								"props": {
									"type": "text",
									"aria-label": "signature",
									"value": {
										"ttArg": "signature"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #1a192b",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "signature"
								}
							}
						]
					},
					{
						"tag": "p",
						"children": [
							"{signature}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "3px",
								"border": "1px solid #1a192b",
								"background": "#f4f4f5",
								"cursor": "pointer"
							}
						},
						"children": [
							"Clear signature"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "signature",
							"value": ""
						}
					},
					{
						"tag": "small",
						"children": [
							"A saved draft only. This does not sign an agreement."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"signature ",
									{
										"tag": "input",
										"props": {
											"aria-label": "signature",
											"value": {
												"ttArg": "signature"
											},
											"maxLength": 200,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "signature"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Date ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Date",
											"value": {
												"ttArg": "date"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "date"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Signed ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Signed",
											"type": "checkbox",
											"checked": {
												"ttArg": "signed"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "signed"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Adopt signature ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Adopt signature",
											"type": "checkbox",
											"checked": {
												"ttArg": "adopt"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "adopt"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "form-flows-signature",
									"title": "Signature Pad",
									"details": "Label: {label}\nDate: {date}\nSigned: {signed}\nAdopt signature: {adopt}\nsignature: {signature}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "form-flows-signature",
	"source": {
		"kind": "archetype",
		"archetype": "form-flows",
		"variant": "signature",
		"tranche": 2
	}
}
