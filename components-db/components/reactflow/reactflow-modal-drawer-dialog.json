{
	"slug": "reactflow-modal-drawer-dialog",
	"name": "Dialog Modal",
	"library": "reactflow",
	"category": "overlays",
	"description": "Centered dialog on a dimmed backdrop in the React Flow style — title with a close glyph, muted body copy, and cancel/confirm actions footed to the right. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"modal",
		"dialog",
		"overlay",
		"actions"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Update available",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "body",
			"type": "text",
			"default": "A new version of the workspace is ready to install. You can update now or do it later.",
			"label": "Body",
			"maxLength": 200
		},
		{
			"name": "confirmLabel",
			"type": "string",
			"default": "Update now",
			"label": "Confirm label",
			"maxLength": 24
		},
		{
			"name": "cancelLabel",
			"type": "string",
			"default": "Later",
			"label": "Cancel label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "tt-dialog",
				"props": {
					"title": "{title}",
					"name": "Open dialog",
					"type": "modal"
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "grid",
								"gap": "12px",
								"padding": "16px",
								"border": "1px solid #1a192b",
								"borderRadius": "5px",
								"background": "#ffffff",
								"color": "#1a192b",
								"minWidth": 0,
								"maxWidth": "100%"
							}
						},
						"children": [
							{
								"tag": "p",
								"children": [
									"{body}"
								]
							},
							{
								"tag": "p",
								"children": [
									"Edit the values below and save a private draft. No external changes are made."
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Body ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Body",
											"value": {
												"ttArg": "body"
											},
											"maxLength": 200,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "body"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Confirm label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Confirm label",
											"value": {
												"ttArg": "confirmLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "confirmLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Cancel label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Cancel label",
											"value": {
												"ttArg": "cancelLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "cancelLabel"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "modal-drawer-dialog",
									"title": "Dialog Modal",
									"details": "Title: {title}\nBody: {body}\nConfirm label: {confirmLabel}\nCancel label: {cancelLabel}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "modal-drawer-dialog",
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "dialog",
		"tranche": 1
	}
}
