{
	"slug": "reactflow-avatar-labeled",
	"name": "Labeled Avatar",
	"library": "reactflow",
	"category": "data-display",
	"description": "Avatar with name and role text in the React Flow style — initials disc beside a two-line identity block using library type and muted ink. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"avatar",
		"labeled",
		"identity",
		"profile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "AR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "name",
			"type": "string",
			"default": "Alex Rivers",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "role",
			"type": "string",
			"default": "Product Designer",
			"label": "Role",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "12px",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontWeight": 600,
										"borderRadius": "999px",
										"flexShrink": 0,
										"userSelect": "none",
										"flexWrap": "wrap"
									},
									{
										"width": "40px",
										"height": "40px",
										"fontSize": "12px"
									},
									{
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1a192b",
													"success": "#22c55e",
													"warning": "#eab308",
													"danger": "#ff0072",
													"info": "#784be8",
													"neutral": "#6f6e77"
												},
												"default": "#1a192b"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									}
								]
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#1a192b"
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#6f6e77"
									}
								},
								"children": [
									"{role}"
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Name",
											"value": {
												"ttArg": "name"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "name"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Role ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Role",
											"value": {
												"ttArg": "role"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #1a192b",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "role"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #1a192b",
										"borderRadius": "3px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "avatar-labeled",
									"title": "Labeled Avatar",
									"details": "Initials: {initials}\nName: {name}\nRole: {role}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "avatar-labeled",
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "labeled",
		"tranche": 1
	}
}
