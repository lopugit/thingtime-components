{
	"slug": "shadcn-card-media",
	"name": "Media Card",
	"library": "shadcn",
	"category": "layout",
	"description": "Card with a media block in the shadcn/ui style — a tone-gradient placeholder banner over a badge, title and body. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"card",
		"media",
		"image",
		"banner"
	],
