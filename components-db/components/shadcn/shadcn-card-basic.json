{
	"slug": "shadcn-card-basic",
	"name": "Basic Card",
	"library": "shadcn",
	"category": "layout",
	"description": "Simple padded content card in the shadcn/ui style — tone-colored eyebrow, heading and muted body on one bordered library surface. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"card",
		"surface",
		"content"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Card title",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Cards group related content and actions onto one calm surface.",
			"label": "Body",
			"maxLength": 500
		},
		{
			"name": "eyebrow",
			"type": "string",
			"default": "Overview",
			"label": "Eyebrow",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"width": "300px",
						"background": "#ffffff",
						"color": "#09090b",
						"border": "1px solid #e4e4e7",
						"borderRadius": "8px",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
						"overflow": "hidden",
						"boxSizing": "border-box",
						"padding": "16px",
						"gap": "8px",
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "eyebrow",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"textTransform": "uppercase",
										"letterSpacing": "0.06em",
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#18181b",
													"success": "#16a34a",
													"warning": "#f59e0b",
													"danger": "#ef4444",
													"info": "#3b82f6",
													"neutral": "#71717a"
												},
												"default": "#18181b"
											}
										}
									}
								},
								"children": [
									"{eyebrow}"
								]
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 600,
								"color": "#09090b"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"color": "#71717a",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Body ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Body",
											"value": {
												"ttArg": "body"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "body"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Eyebrow ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Eyebrow",
											"value": {
												"ttArg": "eyebrow"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "eyebrow"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "card-basic",
									"title": "Basic Card",
									"details": "Title: {title}\nBody: {body}\nEyebrow: {eyebrow}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "card-basic",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "basic",
		"tranche": 1
	}
}
