{
	"slug": "shadcn-streaming-tv-episodes",
	"name": "Episode List",
	"library": "shadcn",
	"category": "entertainment",
	"description": "Season episode list in the shadcn/ui style — a mock season selector header over three episode rows with number, thumb tile, synopsis snippet, and duration; watched rows sit check-dimmed while the current episode carries the highlight. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"streaming",
		"episodes",
		"season",
		"list"
	],
	"args": [
		{
			"name": "ep1",
			"type": "string",
			"default": "First Light",
			"label": "Episode 1 title",
			"maxLength": 40
		},
		{
			"name": "current",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3"
			],
			"default": "2",
			"label": "Current episode"
		},
		{
			"name": "season",
			"type": "string",
			"default": "1",
			"label": "Season",
			"maxLength": 3
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "mediaUrl",
			"type": "string",
			"default": "",
			"label": "Media URL",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e4e4e7",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#09090b",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Media URL",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "mediaUrl",
									"value": {
										"ttArg": "mediaUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #e4e4e7",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "mediaUrl"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "mediaUrl",
							"equals": "",
							"then": null,
							"else": {
								"tag": "video",
								"props": {
									"src": "{mediaUrl}",
									"controls": true,
									"style": {
										"width": "100%",
										"maxHeight": "400px"
									}
								}
							}
						}
					},
					{
						"tag": "small",
						"children": [
							"Add a playable media URL to play, pause, seek, adjust volume, and use fullscreen."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Media URL ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Media URL",
											"value": {
												"ttArg": "mediaUrl"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "mediaUrl"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Episode 1 title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Episode 1 title",
											"value": {
												"ttArg": "ep1"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "ep1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Current episode ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Current episode",
											"value": {
												"ttArg": "current"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "1"
												},
												"children": [
													"1"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "2"
												},
												"children": [
													"2"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "3"
												},
												"children": [
													"3"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "current"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Season ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Season",
											"value": {
												"ttArg": "season"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "season"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "streaming-tv-episodes",
									"title": "Episode List",
									"details": "Episode 1 title: {ep1}\nCurrent episode: {current}\nSeason: {season}\nMedia URL: {mediaUrl}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "streaming-tv-episodes",
	"source": {
		"kind": "archetype",
		"archetype": "streaming-tv",
		"variant": "episodes",
		"tranche": 2
	}
}
