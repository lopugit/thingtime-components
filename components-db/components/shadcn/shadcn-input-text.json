{
	"slug": "shadcn-input-text",
	"name": "Text Input",
	"library": "shadcn",
	"category": "forms",
	"description": "Plain single-line text field in the shadcn/ui style — label, placeholder and helper hint on the library's control height and radius. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"input",
		"text",
		"field",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Email",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "you@example.com",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "hint",
			"type": "string",
			"default": "We will never share it.",
			"label": "Hint",
			"maxLength": 80
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "entry1",
			"type": "string",
			"default": "",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "6px",
						"width": "260px",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "label",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 500,
								"color": "#09090b"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"placeholder": "{placeholder}",
							"style": {
								"ttMerge": [
									{
										"width": "100%",
										"padding": "0 12px",
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#ffffff",
										"color": "#09090b",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"outline": "none",
										"boxSizing": "border-box",
										"maxWidth": "100%"
									},
									{
										"ttMap": {
											"arg": "size",
											"values": {
												"sm": {
													"height": "32px",
													"fontSize": "13px"
												},
												"md": {
													"height": "36px",
													"fontSize": "14px"
												},
												"lg": {
													"height": "40px",
													"fontSize": "16px"
												}
											},
											"default": {
												"height": "36px",
												"fontSize": "14px"
											}
										}
									}
								]
							},
							"value": {
								"ttArg": "entry1"
							},
							"aria-label": "{placeholder}",
							"maxLength": 500
						},
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "entry1"
						}
					},
					{
						"ttIf": {
							"arg": "hint",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#71717a"
									}
								},
								"children": [
									"{hint}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"entry1 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "entry1",
											"value": {
												"ttArg": "entry1"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "entry1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Hint ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Hint",
											"value": {
												"ttArg": "hint"
											},
											"maxLength": 80,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "hint"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "input-text",
									"title": "Text Input",
									"details": "Label: {label}\nHint: {hint}\nentry1: {entry1}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "input-text",
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "text",
		"tranche": 1
	}
}
