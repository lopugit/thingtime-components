{
	"slug": "shadcn-empty-states-onboarding",
	"name": "Onboarding CTA",
	"library": "shadcn",
	"category": "feedback",
	"description": "Onboarding call-to-action panel in the shadcn/ui style — welcome heading, numbered step dots hinting at the setup flow, and a solid tone start button. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"onboarding",
		"empty-state",
		"steps",
		"cta"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Welcome to your workspace",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "body",
			"type": "text",
			"default": "A few quick steps and you’re up and running.",
			"label": "Body",
			"maxLength": 500
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Start setup",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "steps",
			"type": "number",
			"default": 3,
			"label": "Steps",
			"min": 2,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
