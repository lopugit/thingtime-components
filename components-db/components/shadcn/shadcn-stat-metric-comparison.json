{
	"slug": "shadcn-stat-metric-comparison",
	"name": "Comparison Stat",
	"library": "shadcn",
	"category": "data-display",
	"description": "Two-value comparison card in the shadcn/ui style — current figure in the tone color beside the previous figure, split by a vertical divider. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"stat",
		"comparison",
		"versus",
		"card"
	],
	"args": [
		{
			"name": "leftLabel",
			"type": "string",
			"default": "This week",
			"label": "Left label",
			"maxLength": 24
		},
		{
			"name": "leftValue",
			"type": "string",
			"default": "1,284",
			"label": "Left value",
			"maxLength": 16
		},
		{
			"name": "rightLabel",
			"type": "string",
			"default": "Last week",
			"label": "Right label",
			"maxLength": 24
		},
		{
			"name": "rightValue",
			"type": "string",
			"default": "1,102",
			"label": "Right value",
			"maxLength": 16
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "inline-flex",
						"alignItems": "stretch",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#e4e4e7",
						"borderRadius": "12px",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
						"boxSizing": "border-box",
						"padding": "16px 20px",
						"gap": "18px",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "4px",
								"flex": "1 1 0",
								"minWidth": "90px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 400,
										"color": "#71717a"
									}
								},
								"children": [
									"{leftLabel}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "18px",
										"fontWeight": 600,
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#18181b",
													"success": "#16a34a",
													"warning": "#f59e0b",
													"danger": "#ef4444",
													"info": "#3b82f6",
													"neutral": "#71717a"
												},
												"default": "#18181b"
											}
										},
										"lineHeight": 1.15,
										"fontVariantNumeric": "tabular-nums"
									}
								},
								"children": [
									"{leftValue}"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "2px",
								"alignSelf": "stretch",
								"borderRadius": "999px",
								"background": "#f4f4f5",
								"flexShrink": 0,
								"maxWidth": "100%",
								"boxSizing": "border-box"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "4px",
								"flex": "1 1 0",
								"minWidth": "90px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 400,
										"color": "#71717a"
									}
								},
								"children": [
									"{rightLabel}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "18px",
										"fontWeight": 600,
										"color": "#09090b",
										"lineHeight": 1.15,
										"fontVariantNumeric": "tabular-nums"
									}
								},
								"children": [
									"{rightValue}"
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Left label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Left label",
											"value": {
												"ttArg": "leftLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "leftLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Left value ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Left value",
											"value": {
												"ttArg": "leftValue"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "leftValue"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Right label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Right label",
											"value": {
												"ttArg": "rightLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "rightLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Right value ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Right value",
											"value": {
												"ttArg": "rightValue"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "rightValue"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "stat-metric-comparison",
									"title": "Comparison Stat",
									"details": "Left label: {leftLabel}\nLeft value: {leftValue}\nRight label: {rightLabel}\nRight value: {rightValue}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "stat-metric-comparison",
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "comparison",
		"tranche": 1
	}
}
