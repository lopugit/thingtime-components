{
	"slug": "shadcn-badge-soft",
	"name": "Soft Badge",
	"library": "shadcn",
	"category": "data-display",
	"description": "Tinted status badge in the shadcn/ui style — soft tone wash with the deeper tone for the label. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"badge",
		"status",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "In review",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "999px",
								"flexWrap": "wrap"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"fontSize": "12px",
											"padding": "2px 8px"
										},
										"md": {
											"fontSize": "13px",
											"padding": "4px 10px"
										}
									},
									"default": {
										"fontSize": "12px",
										"padding": "2px 8px"
									}
								}
							},
							{
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f4f4f5",
											"success": "#f0fdf4",
											"warning": "#fffbeb",
											"danger": "#fef2f2",
											"info": "#eff6ff",
											"neutral": "#f4f4f5"
										},
										"default": "#f4f4f5"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#18181b",
											"success": "#15803d",
											"warning": "#b45309",
											"danger": "#b91c1c",
											"info": "#1d4ed8",
											"neutral": "#3f3f46"
										},
										"default": "#18181b"
									}
								}
							}
						]
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "badge-soft",
									"title": "Soft Badge",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "badge-soft",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "soft",
		"tranche": 1
	}
}
