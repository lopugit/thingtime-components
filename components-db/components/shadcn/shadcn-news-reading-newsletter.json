								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "22px",
												"height": "22px",
												"borderRadius": "999px",
												"background": "#16a34a",
												"color": "#ffffff",
												"display": "flex",
												"alignItems": "center",
												"justifyContent": "center",
												"flexShrink": 0,
												"maxWidth": "100%",
												"boxSizing": "border-box",
												"flexWrap": "wrap"
											}
										},
										"children": [
											{
												"tag": "svg",
												"props": {
													"width": 12,
													"height": 12,
													"viewBox": "0 0 24 24",
													"fill": "none",
													"stroke": "currentColor",
													"strokeWidth": 2,
													"strokeLinecap": "round",
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "polyline",
														"props": {
															"points": "20 6 9 17 4 12"
														}
													}
												]
											}
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "13px",
												"fontWeight": 600,
												"color": "#15803d"
											}
										},
										"children": [
											"You’re in — check your inbox."
										]
									}
								]
							},
							"else": {
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "8px",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"tag": "input",
										"props": {
											"type": "email",
											"placeholder": "you@example.com",
											"style": {
												"flex": 1,
												"minWidth": 0,
												"height": "36px",
												"boxSizing": "border-box",
												"padding": "0 12px",
												"background": "#ffffff",
												"color": "#09090b",
												"borderWidth": "1px",
												"borderStyle": "solid",
												"borderColor": "#e4e4e7",
												"borderRadius": "8px",
												"fontSize": "13px",
												"outline": "none"
											},
											"value": {
												"ttArg": "entry1"
											},
											"aria-label": "you@example.com",
											"maxLength": 500
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "entry1"
										}
									},
									{
										"tag": "button",
										"props": {
											"type": "button",
											"style": {
												"height": "auto",
												"padding": "8px 12px",
												"border": "none",
												"borderRadius": "8px",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#18181b",
															"success": "#16a34a",
															"warning": "#f59e0b",
															"danger": "#ef4444",
															"info": "#3b82f6",
															"neutral": "#71717a"
														},
														"default": "#18181b"
													}
												},
												"color": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#fafafa",
															"success": "#ffffff",
															"warning": "#ffffff",
															"danger": "#fafafa",
															"info": "#ffffff",
															"neutral": "#ffffff"
														},
														"default": "#fafafa"
