												"fontSize": "13px",
												"cursor": "pointer",
												"flexShrink": 0,
												"width": "auto",
												"minWidth": 0,
												"whiteSpace": "normal",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"aria-label": "{actionLabel}"
										},
										"children": [
											"{actionLabel}"
										],
										"ttAction": "{actionKey}",
										"ttActionInputs": {
											"family": "news-reading-newsletter",
											"title": "Newsletter Block",
											"details": "Title: {title}\nCadence: {cadence}\nSubscriber count: {subscribers}\nSubscribed: {subscribed}\nentry1: {entry1}"
										}
									}
								]
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#71717a"
									}
								},
								"children": [
									"{subscribers}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#a1a1aa"
									}
								},
								"children": [
									"· No spam, unsubscribe anytime"
								]
							}
						]
					}
				]
			},
			{
