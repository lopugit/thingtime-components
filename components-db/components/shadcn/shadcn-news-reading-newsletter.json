{
	"slug": "shadcn-news-reading-newsletter",
	"name": "Newsletter Block",
	"library": "shadcn",
	"category": "content",
	"description": "Inline newsletter block in the shadcn/ui style — serif title with a cadence caption, an email field mock beside a tone Subscribe button that flips to a check and a you-are-in row once subscribed, over subscriber-count and no-spam captions. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"news",
		"newsletter",
		"subscribe",
		"email"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "The Morning Brief",
			"label": "Title",
			"maxLength": 48
		},
		{
			"name": "cadence",
			"type": "string",
			"default": "Every weekday at 7am",
			"label": "Cadence",
			"maxLength": 48
		},
		{
			"name": "subscribers",
			"type": "string",
			"default": "84,000 readers",
			"label": "Subscriber count",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "subscribed",
			"type": "boolean",
			"default": false,
			"label": "Subscribed"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "entry1",
			"type": "string",
			"default": "",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"width": "320px",
						"padding": "16px",
						"gap": "10px",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#f4f4f5",
						"borderRadius": "12px",
						"boxShadow": "none",
						"boxSizing": "border-box",
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontFamily": "Georgia, 'Times New Roman', serif",
										"fontSize": "16px",
										"fontWeight": 700,
										"color": "#09090b"
									}
								},
								"children": [
									"{title}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#71717a"
									}
								},
								"children": [
									"{cadence}"
								]
							}
						]
					},
					{
						"ttIf": {
							"arg": "subscribed",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "10px",
										"padding": "9px 12px",
										"background": "#f0fdf4",
										"borderRadius": "8px",
										"flexWrap": "wrap"
