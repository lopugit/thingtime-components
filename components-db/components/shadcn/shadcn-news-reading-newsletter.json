												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "entry1"
										}
