												"borderRadius": "999px",
												"background": "#18181b",
												"flexShrink": 0,
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										}
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"flex": 1,
