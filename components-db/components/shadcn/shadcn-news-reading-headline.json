{
	"slug": "shadcn-news-reading-headline",
	"name": "Headline Stack",
	"library": "shadcn",
	"category": "content",
	"description": "Headline stack in the shadcn/ui style — an uppercase section chip over a serif lead headline, two bulleted secondary stories with timestamps, and a tone-colored more-from-section link. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"news",
		"headline",
		"section",
		"stories"
	],
	"args": [
		{
			"name": "section",
			"type": "string",
			"default": "Technology",
			"label": "Section",
			"maxLength": 24
		},
		{
			"name": "headline",
			"type": "text",
			"default": "Quantum chips leap from the lab to the laptop",
			"label": "Headline",
			"maxLength": 120
		},
		{
			"name": "sub1",
			"type": "string",
			"default": "Foundries race to package the first consumer wafers",
			"label": "Story 2",
			"maxLength": 80
		},
		{
			"name": "sub2",
			"type": "string",
			"default": "What the breakthrough means for battery life",
			"label": "Story 3",
			"maxLength": 80
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
