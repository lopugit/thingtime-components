{
	"slug": "shadcn-social-feed-share-sheet",
	"name": "Share Sheet",
	"library": "shadcn",
	"category": "social",
	"description": "Share sheet in the shadcn/ui style — grab handle, Share-to caption, a two-by-four grid of tinted destination tiles from copy-link to mail, and a cancel bar. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"social",
		"share",
		"sheet",
		"grid"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Share to",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "cancel",
			"type": "string",
			"default": "Cancel",
			"label": "Cancel label",
			"maxLength": 20
		},
		{
			"name": "showHandle",
			"type": "boolean",
			"default": true,
			"label": "Grab handle"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "shareUrl",
			"type": "string",
			"default": "https://thingtime.com",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e4e4e7",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#09090b",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Link to copy",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "shareUrl",
									"value": {
										"ttArg": "shareUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #e4e4e7",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "shareUrl"
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "8px",
								"border": "1px solid #e4e4e7",
								"background": "#f4f4f5",
								"cursor": "pointer"
							}
						},
						"children": [
							"Copy link"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "copy",
							"value": "{shareUrl}"
						}
					},
					{
						"tag": "small",
						"children": [
							"Copying does not publish a post or change access permissions."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"shareUrl ",
									{
										"tag": "input",
										"props": {
											"aria-label": "shareUrl",
											"value": {
												"ttArg": "shareUrl"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "shareUrl"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Cancel label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Cancel label",
											"value": {
												"ttArg": "cancel"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "cancel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Grab handle ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Grab handle",
											"type": "checkbox",
											"checked": {
												"ttArg": "showHandle"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "showHandle"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "social-feed-share-sheet",
									"title": "Share Sheet",
									"details": "Title: {title}\nCancel label: {cancel}\nGrab handle: {showHandle}\nshareUrl: {shareUrl}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "social-feed-share-sheet",
	"source": {
		"kind": "archetype",
		"archetype": "social-feed",
		"variant": "share-sheet",
		"tranche": 2
	}
}
