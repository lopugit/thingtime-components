{
	"slug": "shadcn-modal-drawer-confirm",
	"name": "Confirm Dialog",
	"library": "shadcn",
	"category": "overlays",
	"description": "Destructive confirm dialog in the shadcn/ui style — a tone-tinted alert badge over centered title and body, cancel beside a danger-toned commit button. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"modal",
		"confirm",
		"danger",
		"overlay"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Review this draft",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "body",
			"type": "text",
			"default": "Saving stores a private record. This example does not delete any file.",
			"label": "Body",
			"maxLength": 200
		},
		{
			"name": "confirmLabel",
			"type": "string",
			"default": "Delete",
			"label": "Confirm label",
			"maxLength": 24
		},
		{
			"name": "cancelLabel",
			"type": "string",
			"default": "Cancel",
			"label": "Cancel label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "danger",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "tt-dialog",
				"props": {
					"title": "{title}",
					"name": "Open confirm",
					"type": "modal"
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "grid",
								"gap": "12px",
								"padding": "16px",
								"border": "1px solid #e4e4e7",
								"borderRadius": "8px",
								"background": "#ffffff",
								"color": "#09090b",
								"minWidth": 0,
								"maxWidth": "100%"
							}
						},
						"children": [
							{
								"tag": "p",
								"children": [
									"{body}"
								]
							},
							{
								"tag": "p",
								"children": [
									"Edit the values below and save a private draft. No external changes are made."
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Body ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Body",
											"value": {
												"ttArg": "body"
											},
											"maxLength": 200,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "body"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Confirm label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Confirm label",
											"value": {
												"ttArg": "confirmLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "confirmLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Cancel label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Cancel label",
											"value": {
												"ttArg": "cancelLabel"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "cancelLabel"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "modal-drawer-confirm",
									"title": "Confirm Dialog",
									"details": "Title: {title}\nBody: {body}\nConfirm label: {confirmLabel}\nCancel label: {cancelLabel}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "modal-drawer-confirm",
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "confirm",
		"tranche": 1
	}
}
