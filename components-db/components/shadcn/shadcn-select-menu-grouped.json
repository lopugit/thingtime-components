{
	"slug": "shadcn-select-menu-grouped",
	"name": "Grouped Select",
	"library": "shadcn",
	"category": "forms",
	"description": "Open select panel with option groups in the shadcn/ui style — muted group headers over their options, first option showing the selected check. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"select",
		"groups",
		"menu"
	],
	"args": [
		{
			"name": "groupA",
			"type": "string",
			"default": "Fruits",
			"label": "First group",
			"maxLength": 30
		},
		{
			"name": "itemA1",
			"type": "string",
			"default": "Apple",
			"label": "Group A item 1",
			"maxLength": 30
		},
		{
			"name": "itemA2",
			"type": "string",
			"default": "Banana",
			"label": "Group A item 2",
			"maxLength": 30
		},
		{
			"name": "groupB",
			"type": "string",
			"default": "Vegetables",
			"label": "Second group",
			"maxLength": 30
		},
