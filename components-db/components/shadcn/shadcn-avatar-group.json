{
	"slug": "shadcn-avatar-group",
	"name": "Avatar Group",
	"library": "shadcn",
	"category": "data-display",
	"description": "Overlapping avatar stack in the shadcn/ui style — a repeat-driven row of tone-filled initials discs separated by surface-colored rims. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"avatar",
		"group",
		"stack",
		"team"
	],
	"args": [
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Avatars",
			"min": 1,
			"max": 8
		},
		{
			"name": "prefix",
			"type": "string",
			"default": "U",
			"label": "Initials prefix",
			"maxLength": 2
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"paddingLeft": "10px",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "count",
							"max": 8,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"ttMerge": [
											{
												"display": "flex",
												"alignItems": "center",
												"justifyContent": "center",
												"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
												"fontWeight": 600,
												"borderRadius": "999px",
												"flexShrink": 0,
												"userSelect": "none",
												"flexWrap": "wrap"
											},
											{
												"ttMap": {
													"arg": "size",
													"values": {
														"sm": {
															"width": "28px",
															"height": "28px",
															"fontSize": "12px"
														},
														"md": {
															"width": "40px",
															"height": "40px",
															"fontSize": "13px"
														},
														"lg": {
															"width": "56px",
															"height": "56px",
															"fontSize": "16px"
														}
													},
													"default": {
														"width": "40px",
														"height": "40px",
														"fontSize": "13px"
													}
												}
											},
											{
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#18181b",
															"success": "#16a34a",
															"warning": "#f59e0b",
															"danger": "#ef4444",
															"info": "#3b82f6",
															"neutral": "#71717a"
														},
														"default": "#18181b"
													}
												},
												"color": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#fafafa",
															"success": "#ffffff",
															"warning": "#ffffff",
															"danger": "#fafafa",
															"info": "#ffffff",
															"neutral": "#ffffff"
														},
														"default": "#fafafa"
													}
												}
											},
											{
												"border": "2px solid #ffffff",
												"marginLeft": "-10px"
											}
										]
									}
								},
								"children": [
									"{prefix}{n}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Avatars ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Avatars",
											"value": {
												"ttArg": "count"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 8
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "count"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Initials prefix ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials prefix",
											"value": {
												"ttArg": "prefix"
											},
											"maxLength": 2,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "prefix"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "avatar-group",
									"title": "Avatar Group",
									"details": "Avatars: {count}\nInitials prefix: {prefix}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "avatar-group",
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "group",
		"tranche": 1
	}
}
