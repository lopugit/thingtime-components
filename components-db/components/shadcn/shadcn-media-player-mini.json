{
	"slug": "shadcn-media-player-mini",
	"name": "Mini Player",
	"library": "shadcn",
	"category": "media",
	"description": "Compact now-playing bar in the shadcn/ui style — tiny tinted artwork, ellipsized track title over a thin tone progress line, and a play/pause toggle button. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"media",
		"audio",
		"mini",
		"now-playing"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Night Drive — Neon Waves",
			"label": "Title",
			"maxLength": 48
		},
		{
			"name": "percent",
			"type": "number",
			"default": 64,
			"label": "Progress %",
			"min": 0,
			"max": 100
		},
		{
			"name": "playing",
			"type": "boolean",
			"default": true,
			"label": "Playing"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "mediaUrl",
			"type": "string",
			"default": "",
			"label": "Media URL",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e4e4e7",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#09090b",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Media URL",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "mediaUrl",
									"value": {
										"ttArg": "mediaUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #e4e4e7",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "mediaUrl"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "mediaUrl",
							"equals": "",
							"then": null,
							"else": {
								"tag": "audio",
								"props": {
									"src": "{mediaUrl}",
									"controls": true,
									"style": {
										"width": "100%",
										"maxHeight": "400px"
									}
								}
							}
						}
					},
					{
						"tag": "small",
						"children": [
							"Add a playable media URL to play, pause, seek, adjust volume, and use fullscreen."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Media URL ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Media URL",
											"value": {
												"ttArg": "mediaUrl"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "mediaUrl"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 48,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Progress % ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Progress %",
											"value": {
												"ttArg": "percent"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 0,
											"max": 100
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "percent"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Playing ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Playing",
											"type": "checkbox",
											"checked": {
												"ttArg": "playing"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "playing"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "media-player-mini",
									"title": "Mini Player",
									"details": "Title: {title}\nProgress %: {percent}\nPlaying: {playing}\nMedia URL: {mediaUrl}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "media-player-mini",
	"source": {
		"kind": "archetype",
		"archetype": "media-player",
		"variant": "mini",
		"tranche": 2
	}
}
