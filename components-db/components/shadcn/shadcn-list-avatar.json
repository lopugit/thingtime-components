{
	"slug": "shadcn-list-avatar",
	"name": "Avatar List",
	"library": "shadcn",
	"category": "data-display",
	"description": "Avatar-and-name list rows in the shadcn/ui style — tone-tinted initials circles beside names, a faint recency mark trailing each row. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"list",
		"avatar",
		"people",
		"data"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex Rivers",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Rows",
			"min": 1,
			"max": 6
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "ul",
				"props": {
					"style": {
						"ttMerge": [
							{
								"listStyle": "none",
								"margin": 0,
								"padding": 0,
								"width": "280px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"color": "#09090b",
								"background": "#ffffff",
								"borderRadius": "8px",
								"overflow": "hidden",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							},
							{
								"border": "1px solid #e4e4e7",
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
							}
						]
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "count",
							"max": 6,
							"node": {
								"tag": "li",
								"props": {
									"style": {
										"ttMerge": [
											{
												"display": "flex",
												"alignItems": "center",
												"gap": "12px",
												"padding": "10px 14px",
												"fontSize": "14px",
												"flexWrap": "wrap"
											},
											{
												"ttIf": {
													"arg": "n",
													"equals": 1,
													"then": {},
													"else": {
														"borderTop": "1px solid #f4f4f5"
													}
												}
											}
										]
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "32px",
												"height": "32px",
												"borderRadius": "999px",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#f4f4f5",
															"success": "#f0fdf4",
															"warning": "#fffbeb",
															"danger": "#fef2f2",
															"info": "#eff6ff",
															"neutral": "#f4f4f5"
														},
														"default": "#f4f4f5"
													}
												},
												"color": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#18181b",
															"success": "#15803d",
															"warning": "#b45309",
															"danger": "#b91c1c",
															"info": "#1d4ed8",
															"neutral": "#3f3f46"
														},
														"default": "#18181b"
													}
												},
												"display": "flex",
												"alignItems": "center",
												"justifyContent": "center",
												"fontWeight": 600,
												"fontSize": "12px",
												"flexShrink": 0,
												"maxWidth": "100%",
												"boxSizing": "border-box",
												"flexWrap": "wrap"
											}
										},
										"children": [
											"{initials}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontWeight": 500,
												"flexGrow": 1
											}
										},
										"children": [
											"{name}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#a1a1aa",
												"fontSize": "12px"
											}
										},
										"children": [
											"{n}h"
										]
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Name ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Name",
											"value": {
												"ttArg": "name"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "name"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Initials ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Initials",
											"value": {
												"ttArg": "initials"
											},
											"maxLength": 3,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "initials"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Rows ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Rows",
											"value": {
												"ttArg": "count"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 6
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "count"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "list-avatar",
									"title": "Avatar List",
									"details": "Name: {name}\nInitials: {initials}\nRows: {count}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "list-avatar",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "avatar",
		"tranche": 1
	}
}
