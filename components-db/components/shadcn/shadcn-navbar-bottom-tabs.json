{
	"slug": "shadcn-navbar-bottom-tabs",
	"name": "Bottom Tab Bar",
	"library": "shadcn",
	"category": "navigation",
	"description": "Mobile bottom tab bar in the shadcn/ui style — four icon tabs with labels, the active tab tinted with the tone color under a small indicator bar. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"tabbar",
		"mobile",
		"navigation",
		"bottom"
	],
	"args": [
		{
			"name": "tab1",
			"type": "string",
			"default": "Home",
			"label": "Tab 1",
			"maxLength": 14
		},
		{
			"name": "tab2",
			"type": "string",
			"default": "Search",
			"label": "Tab 2",
			"maxLength": 14
		},
		{
			"name": "tab3",
			"type": "string",
			"default": "Alerts",
			"label": "Tab 3",
			"maxLength": 14
		},
		{
			"name": "tab4",
			"type": "string",
			"default": "Profile",
			"label": "Tab 4",
			"maxLength": 14
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3",
				"4"
			],
			"default": "1",
			"label": "Active tab"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "nav",
				"props": {
					"style": {
						"display": "flex",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e4e4e7",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#09090b",
						"minWidth": 0,
						"maxWidth": "100%",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "a",
						"props": {
							"href": "/",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Home"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/things",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Things"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/components",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Components"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "/builder/demos",
							"style": {
								"padding": "8px",
								"textDecoration": "underline"
							}
						},
						"children": [
							"Demos"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Tab 1 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Tab 1",
											"value": {
												"ttArg": "tab1"
											},
											"maxLength": 14,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tab1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Tab 2 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Tab 2",
											"value": {
												"ttArg": "tab2"
											},
											"maxLength": 14,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tab2"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Tab 3 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Tab 3",
											"value": {
												"ttArg": "tab3"
											},
											"maxLength": 14,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tab3"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Tab 4 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Tab 4",
											"value": {
												"ttArg": "tab4"
											},
											"maxLength": 14,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tab4"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Active tab ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Active tab",
											"value": {
												"ttArg": "active"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "1"
												},
												"children": [
													"1"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "2"
												},
												"children": [
													"2"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "3"
												},
												"children": [
													"3"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "4"
												},
												"children": [
													"4"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "active"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "navbar-bottom-tabs",
									"title": "Bottom Tab Bar",
									"details": "Tab 1: {tab1}\nTab 2: {tab2}\nTab 3: {tab3}\nTab 4: {tab4}\nActive tab: {active}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "navbar-bottom-tabs",
	"source": {
		"kind": "archetype",
		"archetype": "navbar",
		"variant": "bottom-tabs",
		"tranche": 1
	}
}
