{
	"slug": "shadcn-productivity-notes-note",
	"name": "Note Card",
	"library": "shadcn",
	"category": "productivity",
	"description": "Pinned note card in the shadcn/ui style — title with edited caption, body preview lines, tag chips, a star pin toggle and a four-dot note-color picker. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"note",
		"card",
		"productivity",
		"pin",
		"tags"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Meeting notes",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "edited",
			"type": "string",
			"default": "Edited 2h ago",
			"label": "Edited caption",
			"maxLength": 32
		},
		{
			"name": "tag",
			"type": "string",
			"default": "work",
			"label": "First tag",
			"maxLength": 16
		},
		{
			"name": "pinned",
			"type": "boolean",
			"default": true,
			"label": "Pinned"
		},
		{
			"name": "noteColor",
			"type": "enum",
			"values": [
				"sun",
				"mint",
				"sky",
				"rose"
			],
			"default": "sun",
			"label": "Note color"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "content",
			"type": "text",
			"default": "",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #e4e4e7",
						"borderRadius": "8px",
						"background": "#ffffff",
						"color": "#09090b",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "h3",
						"children": [
							"{title}"
						]
					},
					{
						"tag": "textarea",
						"props": {
							"value": "{content}",
							"rows": 5,
							"maxLength": 500,
							"aria-label": "Content"
						},
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "content"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"content ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "content",
											"value": {
												"ttArg": "content"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "content"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Edited caption ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Edited caption",
											"value": {
												"ttArg": "edited"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "edited"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"First tag ",
									{
										"tag": "input",
										"props": {
											"aria-label": "First tag",
											"value": {
												"ttArg": "tag"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "tag"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Pinned ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Pinned",
											"type": "checkbox",
											"checked": {
												"ttArg": "pinned"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "pinned"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Note color ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Note color",
											"value": {
												"ttArg": "noteColor"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #e4e4e7",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "sun"
												},
												"children": [
													"sun"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "mint"
												},
												"children": [
													"mint"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "sky"
												},
												"children": [
													"sky"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "rose"
												},
												"children": [
													"rose"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "noteColor"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"background": "#f4f4f5",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "productivity-notes-note",
									"title": "Note Card",
									"details": "Title: {title}\nEdited caption: {edited}\nFirst tag: {tag}\nPinned: {pinned}\nNote color: {noteColor}\ncontent: {content}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "productivity-notes-note",
	"source": {
		"kind": "archetype",
		"archetype": "productivity-notes",
		"variant": "note",
		"tranche": 2
	}
}
