{
	"slug": "thingtime-streaming-tv-watch-party",
	"name": "Watch Party Card",
	"library": "thingtime",
	"category": "entertainment",
	"description": "Watch party card in the Thingtime style — stacked viewer avatars with a watching count, a synced-position caption over a thin progress bar, a chat teaser bubble, and Invite plus Leave ghost actions. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"streaming",
		"watch-party",
		"social",
		"sync",
		"card"
	],
	"args": [
		{
			"name": "count",
			"type": "number",
			"default": 8,
			"label": "Watching count",
			"min": 1
		},
		{
			"name": "position",
			"type": "string",
			"default": "42:17",
			"label": "Synced position",
			"maxLength": 10
		},
		{
			"name": "percent",
			"type": "number",
			"default": 62,
			"label": "Progress %",
			"min": 0,
			"max": 100
		},
		{
			"name": "message",
			"type": "string",
			"default": "That reveal was wild",
			"label": "Chat teaser",
			"maxLength": 60
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "mediaUrl",
			"type": "string",
			"default": "",
			"label": "Media URL",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Media URL",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "mediaUrl",
									"value": {
										"ttArg": "mediaUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #ececef",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "mediaUrl"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "mediaUrl",
							"equals": "",
							"then": null,
							"else": {
								"tag": "video",
								"props": {
									"src": "{mediaUrl}",
									"controls": true,
									"style": {
										"width": "100%",
										"maxHeight": "400px"
									}
								}
							}
						}
					},
					{
						"tag": "small",
						"children": [
							"Add a playable media URL to play, pause, seek, adjust volume, and use fullscreen."
						]
