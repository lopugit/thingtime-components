{
	"slug": "thingtime-date-time-time-picker",
	"name": "Time Picker",
	"library": "thingtime",
	"category": "forms",
	"description": "Time picker in the Thingtime style — clock field above an open dropdown of half-hour slots, the chosen time on a soft tint with a check mark. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"time",
		"picker",
		"dropdown",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Start time",
			"label": "Label",
			"maxLength": 32
		},
		{
			"name": "selected",
			"type": "enum",
			"values": [
				"09:00",
				"09:30",
				"10:00",
				"10:30"
			],
			"default": "09:30",
			"label": "Selected time"
		},
		{
			"name": "open",
			"type": "boolean",
			"default": true,
			"label": "Open"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "selectedDate",
			"type": "string",
			"default": "",
			"label": "Date"
		},
		{
			"name": "selectedTime",
			"type": "string",
			"default": "",
			"label": "Time"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Date",
							{
								"tag": "input",
								"props": {
									"type": "date",
									"aria-label": "selectedDate",
									"value": {
										"ttArg": "selectedDate"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #ececef",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "selectedDate"
								}
							}
						]
					},
					{
						"tag": "label",
						"children": [
							"Time",
							{
								"tag": "input",
								"props": {
									"type": "time",
									"aria-label": "selectedTime",
									"value": {
										"ttArg": "selectedTime"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #ececef",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "selectedTime"
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Date ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Date",
											"value": {
												"ttArg": "selectedDate"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedDate"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Time ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Time",
											"value": {
												"ttArg": "selectedTime"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedTime"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 32,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Selected time ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Selected time",
											"value": {
												"ttArg": "selected"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "09:00"
												},
												"children": [
													"09:00"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "09:30"
												},
												"children": [
													"09:30"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "10:00"
												},
												"children": [
													"10:00"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "10:30"
												},
												"children": [
													"10:30"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selected"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Open ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Open",
											"type": "checkbox",
											"checked": {
												"ttArg": "open"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "open"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "date-time-time-picker",
									"title": "Time Picker",
									"details": "Label: {label}\nSelected time: {selected}\nOpen: {open}\nDate: {selectedDate}\nTime: {selectedTime}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "date-time-time-picker",
	"source": {
		"kind": "archetype",
		"archetype": "date-time",
		"variant": "time-picker",
		"tranche": 2
	}
}
