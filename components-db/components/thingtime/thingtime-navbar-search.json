{
	"slug": "thingtime-navbar-search",
	"name": "Search Navbar",
	"library": "thingtime",
	"category": "navigation",
	"description": "Navigation bar with a centered search field in the Thingtime style — brand on the left, keyboard-shortcut hint in the input, utility icons on the right. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"navbar",
		"search",
		"header",
		"navigation"
	],
	"args": [
		{
			"name": "brand",
			"type": "string",
			"default": "Acme",
			"label": "Brand",
			"maxLength": 24
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "Search anything…",
			"label": "Placeholder",
			"maxLength": 40
		},
		{
			"name": "shortcut",
			"type": "string",
			"default": "⌘K",
			"label": "Shortcut hint",
			"maxLength": 8
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "searchQuery",
			"type": "string",
			"default": "",
			"maxLength": 200
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "nav",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "strong",
						"children": [
							"{brand}"
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "search",
							"aria-label": "searchQuery",
							"value": {
								"ttArg": "searchQuery"
							},
							"style": {
								"width": "100%",
								"minWidth": 0,
								"padding": "8px",
								"border": "1px solid #ececef",
								"maxWidth": "100%",
								"boxSizing": "border-box"
							}
						},
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "searchQuery"
						}
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "9px",
								"border": "1px solid #ececef",
								"background": "#f5f5f7",
								"cursor": "pointer"
							}
						},
						"children": [
							"Search Things"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "search",
							"value": "{searchQuery}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"searchQuery ",
									{
										"tag": "input",
										"props": {
											"aria-label": "searchQuery",
											"value": {
												"ttArg": "searchQuery"
											},
											"maxLength": 200,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "searchQuery"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Brand ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Brand",
											"value": {
												"ttArg": "brand"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "brand"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Shortcut hint ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Shortcut hint",
											"value": {
												"ttArg": "shortcut"
											},
											"maxLength": 8,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "shortcut"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "navbar-search",
									"title": "Search Navbar",
									"details": "Brand: {brand}\nShortcut hint: {shortcut}\nsearchQuery: {searchQuery}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "navbar-search",
	"source": {
		"kind": "archetype",
		"archetype": "navbar",
		"variant": "search",
		"tranche": 1
	}
}
