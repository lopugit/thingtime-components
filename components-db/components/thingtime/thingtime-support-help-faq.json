{
	"slug": "thingtime-support-help-faq",
	"name": "FAQ Accordion",
	"library": "thingtime",
	"category": "support",
	"description": "Help-center FAQ accordion in the Thingtime style — three question rows with chevrons, the first expandable into its answer with a \"was this helpful\" yes/no ghost pair. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"support",
		"faq",
		"accordion",
		"help"
	],
	"args": [
		{
			"name": "question",
			"type": "string",
			"default": "How do I reset my password?",
			"label": "Question",
			"maxLength": 60
		},
		{
			"name": "answer",
			"type": "text",
			"default": "Head to Settings, choose Security, then Reset password — we email you a secure link that stays valid for one hour.",
			"label": "Answer",
			"maxLength": 240
		},
		{
			"name": "expanded",
			"type": "boolean",
			"default": true,
			"label": "Expanded"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "details",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "summary",
						"children": [
							"{question}"
						]
					},
					{
						"tag": "p",
						"children": [
							"{answer}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Question ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Question",
											"value": {
												"ttArg": "question"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "question"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Answer ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Answer",
											"value": {
												"ttArg": "answer"
											},
											"maxLength": 240,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "answer"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Expanded ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Expanded",
											"type": "checkbox",
											"checked": {
												"ttArg": "expanded"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "expanded"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "support-help-faq",
									"title": "FAQ Accordion",
									"details": "Question: {question}\nAnswer: {answer}\nExpanded: {expanded}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "support-help-faq",
	"source": {
		"kind": "archetype",
		"archetype": "support-help",
		"variant": "faq",
		"tranche": 2
	}
}
