{
	"slug": "thingtime-stat-metric-sparkline",
	"name": "Sparkline Stat",
	"library": "thingtime",
	"category": "data-display",
	"description": "Stat card with an inline svg polyline sparkline in the Thingtime style — tone-colored stroke with an optional soft area fill under the line. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"stat",
		"sparkline",
		"chart",
		"svg"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Weekly sessions",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "4,732",
			"label": "Value",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "filled",
			"type": "boolean",
			"default": true,
			"label": "Area fill"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "inline-flex",
						"flexDirection": "column",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#ececef",
						"borderRadius": "16px",
						"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
						"boxSizing": "border-box",
						"padding": "16px 20px",
						"gap": "10px",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "4px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "11px",
										"fontWeight": 400,
										"color": "#9a9aa6"
									}
								},
								"children": [
									"{label}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "24px",
										"fontWeight": 700,
										"color": "#33333c",
										"lineHeight": 1.15,
										"fontVariantNumeric": "tabular-nums"
									}
								},
								"children": [
									"{value}"
								]
							}
						]
					},
					{
						"tag": "svg",
						"props": {
							"width": 128,
							"height": 32,
							"viewBox": "0 0 128 32",
							"fill": "none",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"ttIf": {
									"arg": "filled",
									"then": {
										"tag": "polygon",
										"props": {
											"points": "0 26 16 20 32 24 48 12 64 17 80 8 96 14 112 4 128 10 128 32 0 32",
											"fill": {
												"ttMap": {
													"arg": "tone",
													"values": {
														"primary": "#f5f5f7",
														"success": "#eafaf1",
														"warning": "#fdf6e5",
														"danger": "#fdeceb",
														"info": "#fdeaf3",
														"neutral": "#f5f5f7"
													},
													"default": "#f5f5f7"
												}
											}
										}
									}
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "0 26 16 20 32 24 48 12 64 17 80 8 96 14 112 4 128 10",
									"stroke": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#16161a",
												"success": "#2f9e63",
												"warning": "#d99a1f",
												"danger": "#d5484f",
												"info": "#d53f8c",
												"neutral": "#9a9aa6"
											},
											"default": "#16161a"
										}
									},
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round"
								}
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Value ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Value",
											"value": {
												"ttArg": "value"
											},
											"maxLength": 20,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "value"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "stat-metric-sparkline",
									"title": "Sparkline Stat",
									"details": "Label: {label}\nValue: {value}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "stat-metric-sparkline",
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "sparkline",
		"tranche": 1
	}
}
