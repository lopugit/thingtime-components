						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "#16161a",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
