										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"color": "#b6b6c0"
									}
								},
								"children": [
									"{tokens} tokens"
								]
							}
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
