										"alignItems": "center",
										"justifyContent": "center",
										"width": "auto",
										"height": "auto",
										"padding": "8px 12px",
										"border": "none",
										"borderRadius": "9px",
										"background": "transparent",
										"cursor": "pointer",
										"flexShrink": 0,
										"maxWidth": "100%",
										"minWidth": 0,
										"whiteSpace": "normal",
										"boxSizing": "border-box",
										"flexWrap": "wrap"
									},
									"aria-label": "{actionLabel}"
								},
								"children": [
									"{actionLabel}"
								],
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "ai-assistant-prompt-bar",
									"title": "AI Prompt Bar",
									"details": "Model: {model}"
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "30px",
										"height": "30px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#2f9e63",
													"warning": "#d99a1f",
													"danger": "#d5484f",
													"info": "#d53f8c",
													"neutral": "#9a9aa6"
												},
												"default": "#16161a"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
