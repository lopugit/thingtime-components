									"family": "ai-assistant-prompt-bar",
									"title": "AI Prompt Bar",
									"details": "Model: {model}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			},
			{
				"tag": "small",
				"children": [
					"Draft only. Saving creates a private Thing. External effects require a configured Action."
				]
			}
