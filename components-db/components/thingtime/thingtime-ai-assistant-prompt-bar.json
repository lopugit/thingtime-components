					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Model ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Model",
											"value": {
												"ttArg": "model"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "model"
										}
