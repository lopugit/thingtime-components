{
	"slug": "thingtime-ai-assistant-prompt-bar",
	"name": "AI Prompt Bar",
	"library": "thingtime",
	"category": "ai",
	"description": "Prompt input bar in the Thingtime style — spark glyph beside ghost placeholder text, attach and mic ghost buttons, a tone-filled send circle, and a model chip with a mono token counter caption below. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"ai",
		"prompt",
		"input",
		"chat"
	],
	"args": [
		{
			"name": "placeholder",
			"type": "string",
			"default": "Ask anything…",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "model",
			"type": "string",
			"default": "Halo Pro",
			"label": "Model",
			"maxLength": 24
		},
		{
			"name": "tokens",
			"type": "string",
			"default": "1.2k",
			"label": "Tokens used",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save draft",
			"maxLength": 500,
			"label": "Action label"
		}
	],
