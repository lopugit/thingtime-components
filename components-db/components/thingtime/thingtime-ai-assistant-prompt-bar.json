						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "11px",
										"fontWeight": 600,
										"color": "#9a9aa6",
										"background": "#f5f5f7",
										"borderRadius": "999px",
										"padding": "2px 8px"
