										}
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"gap": "6px",
												"padding": "6px 10px",
												"fontSize": "12px",
												"fontWeight": 500,
												"color": "#9a9aa6",
												"flexWrap": "wrap"
											}
										},
										"children": [
