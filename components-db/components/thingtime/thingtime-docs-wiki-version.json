{
	"slug": "thingtime-docs-wiki-version",
	"name": "Docs Version Picker",
	"library": "thingtime",
	"category": "documentation",
	"description": "Docs version picker in the Thingtime style — mono version pill trigger over an open menu that tags the latest release with a tone chip, checks the active row and ends in a ghost changelog row. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"docs",
		"version",
		"picker",
		"menu"
	],
	"args": [
		{
			"name": "version",
			"type": "string",
			"default": "2.4",
			"label": "Version",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "open",
			"type": "boolean",
			"default": true,
			"label": "Menu open"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "8px",
						"alignItems": "flex-start"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"height": "auto",
								"padding": "8px 12px",
								"borderRadius": "999px",
								"border": "1px solid #ececef",
								"background": "#ffffff",
								"color": "#33333c",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "12px",
								"fontWeight": 600,
								"cursor": "pointer",
								"boxShadow": "none",
								"width": "auto",
								"minWidth": 0,
								"whiteSpace": "normal",
								"maxWidth": "100%",
								"boxSizing": "border-box",
								"flexWrap": "wrap"
							},
							"aria-label": "{actionLabel}"
						},
						"children": [
							"{actionLabel}"
						],
						"ttAction": "{actionKey}",
						"ttActionInputs": {
							"family": "docs-wiki-version",
							"title": "Docs Version Picker",
							"details": "Version: {version}\nMenu open: {open}"
						}
					},
					{
						"ttIf": {
							"arg": "open",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"width": "220px",
										"padding": "6px",
