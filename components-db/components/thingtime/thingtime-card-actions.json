{
	"slug": "thingtime-card-actions",
	"name": "Actions Card",
	"library": "thingtime",
	"category": "layout",
	"description": "Card with footer action buttons in the Thingtime style — solid confirm beside an outlined cancel, right-aligned above the border. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"card",
		"actions",
		"buttons",
		"footer"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Delete project?",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "This removes the project and its history. Collaborators lose access immediately.",
			"label": "Body",
			"maxLength": 500
		},
		{
			"name": "primaryLabel",
			"type": "string",
			"default": "Confirm",
			"label": "Primary label",
			"maxLength": 30
		},
		{
			"name": "secondaryLabel",
			"type": "string",
			"default": "Cancel",
			"label": "Secondary label",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "danger",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "uiDismissed",
			"type": "boolean",
			"default": false
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "uiDismissed",
					"then": {
						"tag": "button",
						"props": {
							"type": "button"
						},
						"children": [
							"Show again"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "uiDismissed",
							"value": false
						}
					},
					"else": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"width": "300px",
								"background": "#ffffff",
								"color": "#33333c",
								"border": "1px solid #ececef",
								"borderRadius": "12px",
								"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
								"overflow": "hidden",
								"boxSizing": "border-box",
								"maxWidth": "100%"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"padding": "16px",
										"gap": "8px"
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "16px",
												"fontWeight": 700,
												"color": "#16161a"
											}
										},
										"children": [
											"{title}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "12px",
												"color": "#9a9aa6",
												"lineHeight": 1.5
											}
										},
										"children": [
											"{body}"
										]
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "flex-end",
										"gap": "8px",
										"padding": "12px 16px",
										"borderTop": "1px solid #f5f5f7",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"ttIf": {
											"arg": "secondaryLabel",
											"then": {
												"tag": "button",
												"props": {
													"type": "button",
													"style": {
														"display": "inline-flex",
														"alignItems": "center",
														"justifyContent": "center",
														"height": "28px",
														"padding": "0 14px",
														"border": "1px solid #ececef",
														"borderRadius": "9px",
														"fontWeight": 600,
														"fontSize": "12px",
														"cursor": "pointer",
														"background": "transparent",
														"color": "#33333c",
														"flexWrap": "wrap"
													}
												},
												"children": [
													"{secondaryLabel}"
												],
												"ttAction": "$ui",
												"ttActionInputs": {
													"op": "set",
													"key": "uiDismissed",
													"value": true
												}
											}
										}
									},
									{
										"tag": "button",
										"props": {
											"type": "button",
											"style": {
												"ttMerge": [
													{
														"display": "inline-flex",
														"alignItems": "center",
														"justifyContent": "center",
														"height": "28px",
														"padding": "0 14px",
														"border": "none",
														"borderRadius": "9px",
														"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
														"fontWeight": 600,
														"fontSize": "12px",
														"cursor": "pointer",
														"flexWrap": "wrap"
													},
													{
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#16161a",
																	"success": "#2f9e63",
																	"warning": "#d99a1f",
																	"danger": "#d5484f",
																	"info": "#d53f8c",
																	"neutral": "#9a9aa6"
																},
																"default": "#16161a"
															}
														},
														"color": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#ffffff",
																	"success": "#ffffff",
																	"warning": "#ffffff",
																	"danger": "#ffffff",
																	"info": "#ffffff",
																	"neutral": "#ffffff"
																},
																"default": "#ffffff"
															}
														}
													},
													{
														"width": "auto",
														"height": "auto",
														"minWidth": 0,
														"padding": "8px 12px",
														"whiteSpace": "normal",
														"maxWidth": "100%",
														"boxSizing": "border-box"
													}
												]
											},
											"aria-label": "{actionLabel}"
										},
										"children": [
											"{actionLabel}"
										],
										"ttAction": "{actionKey}",
										"ttActionInputs": {
											"family": "card-actions",
											"title": "Actions Card",
											"details": "Title: {title}\nBody: {body}\nPrimary label: {primaryLabel}\nSecondary label: {secondaryLabel}"
										}
									}
								]
							}
						]
					}
				}
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Title ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Title",
											"value": {
												"ttArg": "title"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "title"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Body ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "Body",
											"value": {
												"ttArg": "body"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "body"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Primary label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Primary label",
											"value": {
												"ttArg": "primaryLabel"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "primaryLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Secondary label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Secondary label",
											"value": {
												"ttArg": "secondaryLabel"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "secondaryLabel"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "card-actions",
									"title": "Actions Card",
									"details": "Title: {title}\nBody: {body}\nPrimary label: {primaryLabel}\nSecondary label: {secondaryLabel}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "card-actions",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "actions",
		"tranche": 1
	}
}
