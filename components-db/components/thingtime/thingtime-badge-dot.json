{
	"slug": "thingtime-badge-dot",
	"name": "Dot Badge",
	"library": "thingtime",
	"category": "data-display",
	"description": "Dot-indicator badge in the Thingtime style — a small tone-colored dot beside a quiet label, optionally wrapped in a bordered chip. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"badge",
		"status",
		"dot",
		"indicator"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Online",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		},
		{
			"name": "bordered",
			"type": "boolean",
			"default": true,
			"label": "Bordered"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "999px",
								"flexWrap": "wrap"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"fontSize": "11px",
											"padding": "2px 8px"
										},
										"md": {
											"fontSize": "12px",
											"padding": "4px 10px"
										}
									},
									"default": {
										"fontSize": "11px",
										"padding": "2px 8px"
									}
								}
							},
							{
								"color": "#33333c",
								"fontWeight": 500
							},
							{
								"ttIf": {
									"arg": "bordered",
									"then": {
										"background": "#ffffff",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#ececef",
										"boxShadow": "none"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "8px",
								"height": "8px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"flexShrink": 0,
								"maxWidth": "100%",
								"boxSizing": "border-box"
							}
						}
					},
					"{label}"
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "badge-dot",
									"title": "Dot Badge",
									"details": "Label: {label}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "badge-dot",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "dot",
		"tranche": 1
	}
}
