{
	"slug": "thingtime-media-player-volume",
	"name": "Volume Control",
	"library": "thingtime",
	"category": "media",
	"description": "Volume cluster in the Thingtime style — speaker glyph, tone-filled slider with a positioned thumb, a mute toggle that greys the whole control, and a monospaced playback-speed chip. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"media",
		"volume",
		"slider",
		"controls"
	],
	"args": [
		{
			"name": "percent",
			"type": "number",
			"default": 65,
			"label": "Volume %",
			"min": 0,
			"max": 100
		},
		{
			"name": "muted",
			"type": "boolean",
			"default": false,
			"label": "Muted"
		},
		{
			"name": "speed",
			"type": "enum",
			"values": [
				"0.5x",
				"1x",
				"1.5x",
				"2x"
			],
			"default": "1x",
			"label": "Speed"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "mediaUrl",
			"type": "string",
			"default": "",
			"label": "Media URL",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Media URL",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "mediaUrl",
									"value": {
										"ttArg": "mediaUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #ececef",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "mediaUrl"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "mediaUrl",
							"equals": "",
							"then": null,
							"else": {
								"tag": "audio",
								"props": {
									"src": "{mediaUrl}",
									"controls": true,
									"style": {
										"width": "100%",
										"maxHeight": "400px"
									}
								}
							}
						}
					},
					{
