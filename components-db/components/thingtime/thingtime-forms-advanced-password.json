{
	"slug": "thingtime-forms-advanced-password",
	"name": "Password Strength Field",
	"library": "thingtime",
	"category": "forms",
	"description": "Password field in the Thingtime style — masked dot glyphs inside the field plus a four-segment strength meter sweeping from danger to the house rainbow with a matching caption. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"password",
		"strength",
		"security"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Password",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "dots",
			"type": "number",
			"default": 8,
			"label": "Characters",
			"min": 1,
			"max": 12
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"good",
				"strong"
			],
			"default": "fair",
			"label": "Strength"
		},
		{
			"name": "focused",
			"type": "boolean",
			"default": false,
			"label": "Focused"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "password",
			"type": "string",
			"default": "",
			"maxLength": 200
		},
		{
			"name": "visible",
			"type": "boolean",
			"default": false
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"{label}",
							{
								"tag": "input",
								"props": {
									"type": {
										"ttIf": {
											"arg": "visible",
											"equals": true,
											"then": "text",
											"else": "password"
										}
									},
									"aria-label": "password",
									"value": {
										"ttArg": "password"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #ececef",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "password"
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "9px",
								"border": "1px solid #ececef",
								"background": "#f5f5f7",
								"cursor": "pointer"
							}
						},
						"children": [
							"Show / hide password"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "toggle",
							"key": "visible"
						}
					},
					{
						"tag": "small",
						"children": [
							"Local input only. The password is excluded from saved records."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"visible ",
									{
										"tag": "input",
										"props": {
											"aria-label": "visible",
											"type": "checkbox",
											"checked": {
												"ttArg": "visible"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "visible"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Characters ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Characters",
											"value": {
												"ttArg": "dots"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "number",
											"min": 1,
											"max": 12
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "dots"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Strength ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Strength",
											"value": {
												"ttArg": "strength"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "weak"
												},
												"children": [
													"weak"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "fair"
												},
												"children": [
													"fair"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "good"
												},
												"children": [
													"good"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "strong"
												},
												"children": [
													"strong"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "strength"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Focused ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Focused",
											"type": "checkbox",
											"checked": {
												"ttArg": "focused"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "focused"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "forms-advanced-password",
									"title": "Password Strength Field",
									"details": "Label: {label}\nCharacters: {dots}\nStrength: {strength}\nFocused: {focused}\nvisible: {visible}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "forms-advanced-password",
	"source": {
		"kind": "archetype",
		"archetype": "forms-advanced",
		"variant": "password",
		"tranche": 2
	}
}
