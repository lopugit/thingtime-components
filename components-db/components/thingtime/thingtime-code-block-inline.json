{
	"slug": "thingtime-code-block-inline",
	"name": "Inline Code",
	"library": "thingtime",
	"category": "data-display",
	"description": "Sentence with an inline code chip in the Thingtime style — monospace snippet on the library's surface wash with its tightest corner radius. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"code",
		"inline",
		"snippet",
		"monospace"
	],
	"args": [
		{
			"name": "before",
			"type": "string",
			"default": "Run",
			"label": "Text before",
			"maxLength": 60
		},
		{
			"name": "code",
			"type": "string",
			"default": "npm run dev",
			"label": "Code",
			"maxLength": 40
		},
		{
			"name": "after",
			"type": "string",
			"default": "to start the local server.",
			"label": "Text after",
			"maxLength": 60
		},
		{
			"name": "bordered",
			"type": "boolean",
			"default": true,
			"label": "Bordered chip"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "pre",
						"props": {
							"style": {
								"whiteSpace": "pre-wrap",
								"overflowWrap": "anywhere"
							}
						},
						"children": [
							{
								"tag": "code",
								"children": [
									"{code}"
								]
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "9px",
								"border": "1px solid #ececef",
								"background": "#f5f5f7",
								"cursor": "pointer"
							}
						},
						"children": [
							"Copy code"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "copy",
							"value": "{code}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Text before ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Text before",
											"value": {
												"ttArg": "before"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "before"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Code ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Code",
											"value": {
												"ttArg": "code"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "code"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Text after ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Text after",
											"value": {
												"ttArg": "after"
											},
											"maxLength": 60,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "after"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "code-block-inline",
									"title": "Inline Code",
									"details": "Text before: {before}\nCode: {code}\nText after: {after}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "code-block-inline",
	"source": {
		"kind": "archetype",
		"archetype": "code-block",
		"variant": "inline",
		"tranche": 2
	}
}
