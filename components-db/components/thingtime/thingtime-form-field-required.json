{
	"slug": "thingtime-form-field-required",
	"name": "Required Field",
	"library": "thingtime",
	"category": "forms",
	"description": "Labeled input in the Thingtime style whose required toggle swaps a danger-tone asterisk for a muted \"(optional)\" hint, with fine print below. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"form",
		"field",
		"required",
		"optional"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Email",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "you@example.com",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "required",
			"type": "boolean",
			"default": true,
			"label": "Required"
		},
		{
			"name": "hint",
			"type": "string",
			"default": "We only use this to sign you in.",
			"label": "Hint",
			"maxLength": 80
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "entry1",
			"type": "string",
			"default": "",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "6px",
						"width": "280px",
						"maxWidth": "100%",
						"boxSizing": "border-box"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "4px",
								"flexWrap": "wrap"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 700,
										"color": "#33333c"
									}
								},
								"children": [
									"{label}"
								]
							},
							{
								"ttIf": {
									"arg": "required",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "12px",
												"fontWeight": 600,
												"color": "#d5484f"
											}
										},
										"children": [
											"*"
										]
									},
									"else": {
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "11px",
												"color": "#b6b6c0"
											}
										},
										"children": [
											"(optional)"
										]
									}
								}
							}
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"placeholder": "{placeholder}",
							"style": {
								"ttMerge": [
									{
										"height": "36px",
										"padding": "0 12px",
										"borderRadius": "9px",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#ececef",
										"background": "#ffffff",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontSize": "14px",
										"color": "#33333c",
										"outline": "none",
										"width": "100%",
										"boxSizing": "border-box",
										"boxShadow": "none",
										"maxWidth": "100%"
									},
									{}
								]
							},
							"value": {
								"ttArg": "entry1"
							},
							"aria-label": "{placeholder}",
							"maxLength": 500
						},
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "set",
							"key": "entry1"
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"color": "#9a9aa6"
							}
						},
						"children": [
							"{hint}"
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"entry1 ",
									{
										"tag": "input",
										"props": {
											"aria-label": "entry1",
											"value": {
												"ttArg": "entry1"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "entry1"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Label",
											"value": {
												"ttArg": "label"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "label"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Required ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Required",
											"type": "checkbox",
											"checked": {
												"ttArg": "required"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "required"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Hint ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Hint",
											"value": {
												"ttArg": "hint"
											},
											"maxLength": 80,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "hint"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "form-field-required",
									"title": "Required Field",
									"details": "Label: {label}\nRequired: {required}\nHint: {hint}\nentry1: {entry1}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "form-field-required",
	"source": {
		"kind": "archetype",
		"archetype": "form-field",
		"variant": "required",
		"tranche": 1
	}
}
