{
	"slug": "thingtime-gamification-quest",
	"name": "Quest Card",
	"library": "thingtime",
	"category": "engagement",
	"description": "Quest card in the Thingtime style — a star icon tile beside the quest title, a soft success reward chip, a percent-driven progress bar with a mono done/total readout, and a claim button that appears once the quest completes. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"gamification",
		"quest",
		"reward",
		"progress"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Post 3 times this week",
			"label": "Quest title",
			"maxLength": 40
		},
		{
			"name": "xp",
			"type": "number",
			"default": 50,
			"label": "Reward XP",
			"min": 0
		},
		{
			"name": "done",
			"type": "number",
			"default": 2,
			"label": "Steps done",
			"min": 0
		},
		{
			"name": "total",
			"type": "number",
			"default": 3,
			"label": "Steps total",
			"min": 1
		},
		{
			"name": "percent",
			"type": "number",
			"default": 66,
			"label": "Progress (0–100)",
			"min": 0,
			"max": 100
		},
		{
			"name": "complete",
			"type": "boolean",
			"default": false,
			"label": "Complete"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		}
	],
