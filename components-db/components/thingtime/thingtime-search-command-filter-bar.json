{
	"slug": "thingtime-search-command-filter-bar",
	"name": "Filter Bar",
	"library": "thingtime",
	"category": "forms",
	"description": "Filter bar in the Thingtime style — a compact search field beside closable tone-tinted filter chips and a quiet Clear all ghost link, for list and table toolbars. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"search",
		"filter",
		"chips",
		"toolbar"
	],
	"args": [
		{
			"name": "placeholder",
			"type": "string",
			"default": "Filter tasks…",
			"label": "Placeholder",
			"maxLength": 40
		},
		{
			"name": "filterA",
			"type": "string",
			"default": "Status: Active",
			"label": "Filter chip A",
			"maxLength": 30
		},
		{
			"name": "filterB",
			"type": "string",
			"default": "Owner: Me",
			"label": "Filter chip B",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "searchQuery",
			"type": "string",
			"default": "",
			"maxLength": 200
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Search Things",
							{
								"tag": "input",
								"props": {
									"type": "search",
									"aria-label": "searchQuery",
									"value": {
										"ttArg": "searchQuery"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #ececef",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "searchQuery"
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "9px",
								"border": "1px solid #ececef",
								"background": "#f5f5f7",
								"cursor": "pointer"
							}
						},
						"children": [
							"Search Things"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "search",
							"value": "{searchQuery}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"searchQuery ",
									{
										"tag": "input",
										"props": {
											"aria-label": "searchQuery",
											"value": {
												"ttArg": "searchQuery"
											},
											"maxLength": 200,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "searchQuery"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Filter chip A ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Filter chip A",
											"value": {
												"ttArg": "filterA"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "filterA"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Filter chip B ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Filter chip B",
											"value": {
												"ttArg": "filterB"
											},
											"maxLength": 30,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "filterB"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "search-command-filter-bar",
									"title": "Filter Bar",
									"details": "Filter chip A: {filterA}\nFilter chip B: {filterB}\nsearchQuery: {searchQuery}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "search-command-filter-bar",
	"source": {
		"kind": "archetype",
		"archetype": "search-command",
		"variant": "filter-bar",
		"tranche": 2
	}
}
