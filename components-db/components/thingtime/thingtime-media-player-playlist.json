{
	"slug": "thingtime-media-player-playlist",
	"name": "Playlist",
	"library": "thingtime",
	"category": "media",
	"description": "Playlist card in the Thingtime style — four track rows with index numbers and monospaced durations; the current track swaps its number for accent EQ bars and the hovered row gets a soft wash. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"media",
		"playlist",
		"tracks",
		"queue"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Up next",
			"label": "Heading",
			"maxLength": 24
		},
		{
			"name": "current",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3",
				"4"
			],
			"default": "2",
			"label": "Current track"
		},
		{
			"name": "hovered",
			"type": "enum",
			"values": [
				"none",
				"1",
				"2",
				"3",
				"4"
			],
			"default": "3",
			"label": "Hovered row"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "mediaUrl",
			"type": "string",
			"default": "",
			"label": "Media URL",
			"maxLength": 500
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Media URL",
							{
								"tag": "input",
								"props": {
									"type": "url",
									"aria-label": "mediaUrl",
									"value": {
										"ttArg": "mediaUrl"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #ececef",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "mediaUrl"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "mediaUrl",
							"equals": "",
							"then": null,
							"else": {
								"tag": "audio",
								"props": {
									"src": "{mediaUrl}",
									"controls": true,
									"style": {
										"width": "100%",
										"maxHeight": "400px"
									}
								}
							}
						}
					},
					{
						"tag": "small",
						"children": [
							"Add a playable media URL to play, pause, seek, adjust volume, and use fullscreen."
						]
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Media URL ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Media URL",
											"value": {
												"ttArg": "mediaUrl"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "mediaUrl"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Heading ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Heading",
											"value": {
												"ttArg": "heading"
											},
											"maxLength": 24,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "heading"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Current track ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Current track",
											"value": {
												"ttArg": "current"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "1"
												},
												"children": [
													"1"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "2"
												},
												"children": [
													"2"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "3"
												},
												"children": [
													"3"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "4"
												},
												"children": [
													"4"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "current"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Hovered row ",
									{
										"tag": "select",
										"props": {
											"aria-label": "Hovered row",
											"value": {
												"ttArg": "hovered"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											}
										},
										"children": [
											{
												"tag": "option",
												"props": {
													"value": "none"
												},
												"children": [
													"none"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "1"
												},
												"children": [
													"1"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "2"
												},
												"children": [
													"2"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "3"
												},
												"children": [
													"3"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "4"
												},
												"children": [
													"4"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "hovered"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "media-player-playlist",
									"title": "Playlist",
									"details": "Heading: {heading}\nCurrent track: {current}\nHovered row: {hovered}\nMedia URL: {mediaUrl}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "media-player-playlist",
	"source": {
		"kind": "archetype",
		"archetype": "media-player",
		"variant": "playlist",
		"tranche": 2
	}
}
