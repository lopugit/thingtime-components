													"20"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "30"
												},
												"children": [
													"30"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "40"
												},
												"children": [
													"40"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "50"
												},
												"children": [
													"50"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "60"
												},
												"children": [
													"60"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "70"
												},
												"children": [
													"70"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "80"
												},
												"children": [
													"80"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "90"
												},
												"children": [
													"90"
												]
											},
											{
												"tag": "option",
												"props": {
													"value": "100"
												},
												"children": [
													"100"
												]
											}
										],
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "percent"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "slider-progress-ring",
									"title": "Progress Ring",
									"details": "Percent: {percent}"
								},
								"children": [
