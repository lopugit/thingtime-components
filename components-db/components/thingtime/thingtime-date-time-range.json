												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "end"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Date ",
									{
										"tag": "input",
