{
	"slug": "thingtime-date-time-range",
	"name": "Date Range Picker",
	"library": "thingtime",
	"category": "forms",
	"description": "Date range control in the Thingtime style — two joined date fields bridged by an arrow, under a row of quick preset chips with one active. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"date",
		"range",
		"picker",
		"preset"
	],
	"args": [
		{
			"name": "start",
			"type": "string",
			"default": "01 Aug 2026",
			"label": "Start date",
			"maxLength": 24
		},
		{
			"name": "end",
			"type": "string",
			"default": "30 Aug 2026",
			"label": "End date",
			"maxLength": 24
		},
		{
			"name": "preset",
			"type": "enum",
			"values": [
				"Today",
				"7d",
				"30d"
			],
			"default": "30d",
			"label": "Active preset"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "selectedDate",
			"type": "string",
			"default": "",
			"label": "Date"
		},
		{
			"name": "selectedTime",
			"type": "string",
			"default": "",
			"label": "Time"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "label",
						"children": [
							"Date",
							{
								"tag": "input",
								"props": {
									"type": "date",
									"aria-label": "selectedDate",
									"value": {
										"ttArg": "selectedDate"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #ececef",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "selectedDate"
								}
							}
						]
					},
					{
						"tag": "label",
						"children": [
							"Time",
							{
								"tag": "input",
								"props": {
									"type": "time",
									"aria-label": "selectedTime",
									"value": {
										"ttArg": "selectedTime"
									},
									"style": {
										"width": "100%",
										"minWidth": 0,
										"padding": "8px",
										"border": "1px solid #ececef",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									}
								},
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "set",
									"key": "selectedTime"
