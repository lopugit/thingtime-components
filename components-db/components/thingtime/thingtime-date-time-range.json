											"aria-label": "Date",
											"value": {
												"ttArg": "selectedDate"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "selectedDate"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Time ",
									{
										"tag": "input",
