{
	"slug": "thingtime-code-block-block",
	"name": "Code Block",
	"library": "thingtime",
	"category": "data-display",
	"description": "Highlighted code block in the Thingtime style — filename header bar with a copy glyph, line-number gutter, and fake syntax colors drawn from the library palette, capped with the house rainbow strip. Interactive controls and editable values; saves private Things through an Action.",
	"tags": [
		"code",
		"block",
		"syntax",
		"snippet"
	],
	"args": [
		{
			"name": "filename",
			"type": "string",
			"default": "app.ts",
			"label": "Filename",
			"maxLength": 40
		},
		{
			"name": "copyLabel",
			"type": "string",
			"default": "Copy",
			"label": "Copy label",
			"maxLength": 16
		},
		{
			"name": "lineNumbers",
			"type": "boolean",
			"default": true,
			"label": "Line numbers"
		},
		{
			"name": "actionKey",
			"type": "string",
			"default": "demo-catalog-records-save",
			"maxLength": 500,
			"label": "Action to run"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Save record",
			"maxLength": 500,
			"label": "Action label"
		},
		{
			"name": "code",
			"type": "text",
			"default": "const greeting = \"Hello, Thingtime\";",
			"maxLength": 1000
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"maxWidth": "100%",
				"minWidth": 0
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "grid",
						"gap": "12px",
						"padding": "16px",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"background": "#ffffff",
						"color": "#33333c",
						"minWidth": 0,
						"maxWidth": "100%"
					}
				},
				"children": [
					{
						"tag": "pre",
						"props": {
							"style": {
								"whiteSpace": "pre-wrap",
								"overflowWrap": "anywhere"
							}
						},
						"children": [
							{
								"tag": "code",
								"children": [
									"{code}"
								]
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"padding": "8px 12px",
								"borderRadius": "9px",
								"border": "1px solid #ececef",
								"background": "#f5f5f7",
								"cursor": "pointer"
							}
						},
						"children": [
							"Copy code"
						],
						"ttAction": "$ui",
						"ttActionInputs": {
							"op": "copy",
							"value": "{code}"
						}
					}
				]
			},
			{
				"tag": "details",
				"children": [
					{
						"tag": "summary",
						"children": [
							"Edit and save"
						]
					},
					{
						"tag": "fieldset",
						"props": {
							"style": {
								"display": "grid",
								"gap": "8px",
								"border": 0,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "label",
								"children": [
									"Filename ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Filename",
											"value": {
												"ttArg": "filename"
											},
											"maxLength": 40,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "filename"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Copy label ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Copy label",
											"value": {
												"ttArg": "copyLabel"
											},
											"maxLength": 16,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "copyLabel"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"Line numbers ",
									{
										"tag": "input",
										"props": {
											"aria-label": "Line numbers",
											"type": "checkbox",
											"checked": {
												"ttArg": "lineNumbers"
											}
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "lineNumbers"
										}
									}
								]
							},
							{
								"tag": "label",
								"children": [
									"code ",
									{
										"tag": "textarea",
										"props": {
											"aria-label": "code",
											"value": {
												"ttArg": "code"
											},
											"maxLength": 500,
											"style": {
												"width": "100%",
												"minWidth": 0,
												"padding": "8px",
												"border": "1px solid #ececef",
												"maxWidth": "100%",
												"boxSizing": "border-box"
											},
											"type": "text"
										},
										"ttAction": "$ui",
										"ttActionInputs": {
											"op": "set",
											"key": "code"
										}
									}
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "1px solid #ececef",
										"borderRadius": "9px",
										"background": "#f5f5f7",
										"width": "auto",
										"height": "auto",
										"minWidth": 0,
										"padding": "8px 12px",
										"whiteSpace": "normal",
										"maxWidth": "100%",
										"boxSizing": "border-box"
									},
									"aria-label": "{actionLabel}"
								},
								"ttAction": "{actionKey}",
								"ttActionInputs": {
									"family": "code-block-block",
									"title": "Code Block",
									"details": "Filename: {filename}\nCopy label: {copyLabel}\nLine numbers: {lineNumbers}\ncode: {code}"
								},
								"children": [
									"{actionLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button"
								},
								"children": [
									"Reset values"
								],
								"ttAction": "$ui",
								"ttActionInputs": {
									"op": "reset"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 2,
	"familyKey": "code-block-block",
	"source": {
		"kind": "archetype",
		"archetype": "code-block",
		"variant": "block",
		"tranche": 2
	}
}
